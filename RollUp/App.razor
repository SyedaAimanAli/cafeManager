<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <div class="min-h-screen bg-cafe-cream/30 flex items-center justify-center p-4">
                        <div class="bg-white p-8 rounded-2xl shadow-xl max-w-md text-center border border-stone-200">
                            <div class="w-16 h-16 bg-amber-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-amber-700">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </div>
                            <h2 class="text-2xl font-bold text-cafe-espresso mb-2">Access Restricted</h2>
                            <p class="text-stone-600 mb-6">Please log in with appropriate credentials to access this section.</p>
                            <a href="/login" class="inline-block px-6 py-2.5 bg-cafe-espresso text-white font-medium rounded-xl hover:bg-cafe-mocha transition-all">
                                Go to Login
                            </a>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="min-h-screen bg-stone-50 flex items-center justify-center p-4">
                    <div class="text-center">
                        <h1 class="text-4xl font-bold text-cafe-espresso mb-2">404</h1>
                        <p class="text-stone-600 mb-4">Sorry, there's nothing at this address.</p>
                        <a href="/" class="text-cafe-caramel font-semibold hover:underline">Return Home</a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

