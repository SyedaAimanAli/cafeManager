<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="min-h-screen bg-bg flex items-center justify-center p-4">
                    <div class="text-center">
                        <h1 class="text-4xl font-bold font-display text-ink mb-2">404</h1>
                        <p class="text-ink-muted text-sm mb-4">Sorry, there's nothing at this address.</p>
                        <a href="/" class="text-accent font-semibold hover:underline text-sm">Return Home</a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
