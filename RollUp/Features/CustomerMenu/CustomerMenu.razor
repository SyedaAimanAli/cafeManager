@page "/menu"
@page "/menu/{TableNumber}"
@using RollUp.Core.Interfaces
@using RollUp.Core.Models
@using RollUp.Features.CustomerMenu.Components
@using RollUp.Shared
@using RollUp.Application.DTOs
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IMenuService MenuService
@inject IOrderService OrderService
@inject IBrandingService BrandingService
@inject IOrderNotificationService NotificationService
@inject ProtectedLocalStorage LocalStorage
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@(string.IsNullOrWhiteSpace(branding.BusinessName) ? "Menu - RollUp" : $"{branding.BusinessName} - Menu")</PageTitle>

<div class="min-h-screen @GetPageBgClass()" style="font-family: @GetMenuFontFamily();">
    <!-- Header -->
    <header class="sticky top-0 z-40 backdrop-blur-sm border-b @GetHeaderClass()">
        <div class="max-w-lg mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-bold @(IsDark ? "text-white" : "text-stone-900")">
                        @(string.IsNullOrWhiteSpace(branding.BusinessName) ? "RollUp" : branding.BusinessName)
                    </h1>
                    @if (!string.IsNullOrEmpty(TableNumber))
                    {
                        <p class="text-xs font-semibold @(IsDark ? "text-stone-300" : "text-stone-600")">Table @TableNumber</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(branding.Tagline))
                    {
                        <p class="text-xs @(IsDark ? "text-stone-400" : "text-stone-500")">@branding.Tagline</p>
                    }
                </div>
                <button @onclick="ToggleCart" class="relative p-3 rounded-full shadow-lg transition-all @GetCartButtonClass()">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    @if (Cart.Count > 0)
                    {
                        <span class="absolute -top-1 -right-1 bg-rose-500 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center shadow-xs">
                            @Cart.Count
                        </span>
                    }
                </button>
            </div>
        </div>
    </header>

    <CategoryTabs Categories="Categories"
                  SelectedCategory="@SelectedCategory"
                  OnCategorySelected="SelectCategory"
                  ThemeTemplate="@branding.ThemeTemplate"
                  ColorScheme="@branding.ColorScheme" />

    <!-- Menu Items -->
    <main class="max-w-lg mx-auto px-4 py-6">
        @if (FilteredItems.Any(i => i.IsPopular && i.IsAvailable) && SelectedCategory == Categories.FirstOrDefault())
        {
            <section class="mb-8">
                <h2 class="text-lg font-bold mb-4 flex items-center gap-2 @(IsDark ? "text-white" : "text-stone-900")">
                    <span class="text-amber-500">★</span>
                    Popular Items
                </h2>
                <div class="space-y-3">
                    @foreach (var item in FilteredItems.Where(i => i.IsPopular && i.IsAvailable))
                    {
                        <MenuItemCard Item="item" 
                                      OnAddToCart="OpenItemModal"
                                      ThemeTemplate="@branding.ThemeTemplate"
                                      ColorScheme="@branding.ColorScheme"
                                      Currency="@branding.Currency" />
                    }
                </div>
            </section>
        }

        <section>
            <h2 class="text-lg font-bold mb-4 @(IsDark ? "text-white" : "text-stone-900")">@SelectedCategory</h2>
            <div class="space-y-3">
                @foreach (var item in FilteredItems.Where(i => !i.IsPopular || SelectedCategory != Categories.FirstOrDefault()))
                {
                    <MenuItemCard Item="item" 
                                  OnAddToCart="OpenItemModal"
                                  ThemeTemplate="@branding.ThemeTemplate"
                                  ColorScheme="@branding.ColorScheme"
                                  Currency="@branding.Currency" />
                }
            </div>
        </section>
    </main>

    <CartSidebar @bind-ShowCart="ShowCart"
                 Cart="Cart"
                 CartTotal="CartTotal"
                 @bind-CustomerName="CustomerName"
                 @bind-SelectedOrderType="SelectedOrderType"
                 OnRemoveFromCart="RemoveFromCart"
                 OnUpdateQuantity="UpdateQuantity"
                 OnPlaceOrder="PlaceOrder" />

    <ItemDetailsModal @bind-IsOpen="ShowItemModal"
                      Item="SelectedItem"
                      OnAddToCart="AddToCartFromModal" />

    <!-- Order Status Bar -->
    @if (ActiveUserOrders.Any())
    {
        <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 w-full max-w-lg px-4">
            <div class="bg-cafe-espresso/95 backdrop-blur-md text-white rounded-2xl shadow-2xl border border-white/10 overflow-hidden">
                <div class="p-4 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="relative">
                            <div class="w-10 h-10 bg-cafe-caramel rounded-xl flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                </svg>
                            </div>
                            @if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Ready))
                            {
                                <span class="absolute -top-1 -right-1 w-3 h-3 bg-green-500 rounded-full border-2 border-cafe-espresso animate-ping"></span>
                                <span class="absolute -top-1 -right-1 w-3 h-3 bg-green-500 rounded-full border-2 border-cafe-espresso"></span>
                            }
                        </div>
                        <div>
                            <p class="text-xs text-cafe-latte font-medium uppercase tracking-wider">Your Active Orders</p>
                            <div class="flex items-center gap-2">
                                <span class="font-bold">@ActiveUserOrders.Count(o => o.Status != OrderStatus.Completed && o.Status != OrderStatus.Cancelled) Active</span>
                                <span class="text-white/30">•</span>
                                <span class="text-sm font-medium text-cafe-caramel">
                                    @if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Ready))
                                    {
                                        <span class="text-green-400 animate-pulse">Order Ready!</span>
                                    }
                                    else if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Cancelled))
                                    {
                                        <span class="text-red-400">Order Canceled</span>
                                    }
                                    else if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Completed))
                                    {
                                        <span class="text-gray-400">Order Done</span>
                                    }
                                    else if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Preparing))
                                    {
                                        <span>Preparing...</span>
                                    }
                                    else
                                    {
                                        <span>Order Received</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                    <button @onclick="() => ShowStatusDetails = !ShowStatusDetails" 
                            class="p-2 hover:bg-white/10 rounded-lg transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform @(ShowStatusDetails ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                </div>

                @if (ShowStatusDetails)
                {
                    <div class="px-4 pb-4 space-y-3 max-h-48 overflow-y-auto border-t border-white/5 pt-3">
                        @foreach (var order in ActiveUserOrders)
                        {
                            <div class="flex items-center justify-between py-1">
                                <div class="flex items-center gap-3">
                                    <span class="text-sm font-mono text-cafe-latte">@order.OrderNumber</span>
                                    <span class="text-sm">@order.Items.Count items</span>
                                </div>
                                <span class="@GetStatusBadgeClass(order.Status) px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider">
                                    @GetStatusText(order.Status)
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Order Success Modal -->
    @if (ShowOrderSuccess)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-black/50"></div>
            <div class="relative bg-white rounded-3xl p-8 max-w-sm w-full text-center">
                <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h2 class="font-display text-2xl font-semibold text-cafe-espresso mb-2">Order Placed!</h2>
                <p class="text-gray-600 mb-2">Your order number is</p>
                <p class="text-3xl font-bold text-cafe-caramel mb-6">@LastOrderNumber</p>
                <p class="text-sm text-gray-500 mb-6">Please wait for your number to be called</p>
                <button @onclick="CloseOrderSuccess"
                        class="w-full py-4 bg-cafe-espresso text-white font-semibold rounded-xl hover:bg-cafe-mocha transition-colors">
                    Continue Browsing
                </button>
            </div>
        </div>
    }

    <!-- Status Change Toast -->
    @if (ShowStatusToast)
    {
        <div class="fixed top-24 left-1/2 -translate-x-1/2 z-50 w-full max-w-sm px-4 animate-bounce-in">
            <div class="bg-white border-2 @ToastBorderClass rounded-2xl shadow-2xl p-4 flex items-center gap-4">
                <div class="w-10 h-10 @ToastIconBgClass rounded-xl flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 @ToastIconColorClass" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        @ToastIconPath
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-sm font-bold text-cafe-espresso">@ToastTitle</p>
                    <p class="text-xs text-stone-500">@ToastMessage</p>
                </div>
                <button @onclick="() => ShowStatusToast = false" class="text-stone-400 hover:text-stone-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 011.06 0L12 10.94l5.47-5.47a.75.75 0 111.06 1.06L13.06 12l5.47 5.47a.75.75 0 11-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 01-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 010-1.06z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? TableNumber { get; set; }

    private List<string> Categories = new();
    private string SelectedCategory = string.Empty;
    private List<MenuItem> AllItems = new();
    private List<MenuItem> FilteredItems = new();
    private List<CartItem> Cart = new();
    private bool ShowCart;
    private bool ShowItemModal;
    private MenuItem? SelectedItem;
    private string CustomerName = string.Empty;
    private OrderType SelectedOrderType = OrderType.DineIn;
    private bool ShowOrderSuccess;
    private string LastOrderNumber = string.Empty;
    private List<string> UserOrderNumbers = new();
    private List<Order> ActiveUserOrders = new();
    private bool ShowStatusDetails;

    private bool ShowStatusToast;
    private string ToastTitle = string.Empty;
    private string ToastMessage = string.Empty;
    private string ToastBorderClass = "border-cafe-caramel";
    private string ToastIconBgClass = "bg-cafe-caramel/10";
    private string ToastIconColorClass = "text-cafe-caramel";
    private RenderFragment? ToastIconPath;
    private System.Threading.Timer? _refreshTimer;

    private decimal CartTotal => Cart.Sum(c => c.TotalPrice);
    private TenantBrandingDto branding = new();

    protected override async Task OnInitializedAsync()
    {
        branding = await BrandingService.GetBrandingAsync();
        Categories = await MenuService.GetCategoriesAsync();
        SelectedCategory = Categories.FirstOrDefault() ?? string.Empty;
        AllItems = await MenuService.GetAllItemsAsync();
        FilterItems();

        NotificationService.OnOrdersChanged += HandleOrdersChanged;
        
        // Polling fallback every 15 seconds
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    await RefreshActiveOrders();
                    StateHasChanged();
                }
                catch { /* Ignore background errors */ }
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserOrders();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadUserOrders()
    {
        try
        {
            var result = await LocalStorage.GetAsync<List<string>>("user_orders");
            if (result.Success && result.Value != null)
            {
                UserOrderNumbers = result.Value;
                await RefreshActiveOrders();
            }
        }
        catch { /* Storage might not be available yet */ }
    }

    private async Task RefreshActiveOrders()
    {
        if (!UserOrderNumbers.Any())
        {
            ActiveUserOrders.Clear();
            return;
        }

        var orders = await OrderService.GetOrdersByNumbersAsync(UserOrderNumbers);
        
        // We now keep all relevant orders (including completed/cancelled recently)
        // But for the main list, we might want to filter them if they are too old.
        // For now, let's just keep them all so the user sees "Done" or "Canceled".
        ActiveUserOrders = orders
            .OrderByDescending(o => o.CreatedAt)
            .ToList();
        
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleOrdersChanged()
    {
        await InvokeAsync(async () =>
        {
            try
            {
                var previousStatuses = ActiveUserOrders.ToDictionary(o => o.Id, o => o.Status);
                await RefreshActiveOrders();
                
                // Detect changes and notify
                foreach (var order in ActiveUserOrders)
                {
                    if (previousStatuses.TryGetValue(order.Id, out var oldStatus) && oldStatus != order.Status)
                    {
                        await ShowNotification(order);
                    }
                }
                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ERROR in HandleOrdersChanged: {ex.Message}");
            }
        });
    }

    private async Task ShowNotification(Order order)
    {
        ToastTitle = GetStatusText(order.Status);
        ToastMessage = $"Order {order.OrderNumber} is now {GetStatusText(order.Status).ToLower()}.";
        
        if (order.Status == OrderStatus.Ready)
        {
            ToastBorderClass = "border-green-500";
            ToastIconBgClass = "bg-green-100";
            ToastIconColorClass = "text-green-600";
            ToastIconPath =@<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />;
            try { await JSRuntime.InvokeVoidAsync("playNotificationSound"); } catch {}
        }
        else if (order.Status == OrderStatus.Cancelled)
        {
            ToastBorderClass = "border-red-500";
            ToastIconBgClass = "bg-red-100";
            ToastIconColorClass = "text-red-600";
            ToastIconPath =@<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />;
        }
        else if (order.Status == OrderStatus.Completed)
        {
            ToastBorderClass = "border-gray-500";
            ToastIconBgClass = "bg-gray-100";
            ToastIconColorClass = "text-gray-600";
            ToastIconPath =@<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />;
        }
        else
        {
            ToastBorderClass = "border-cafe-caramel";
            ToastIconBgClass = "bg-cafe-caramel/10";
            ToastIconColorClass = "text-cafe-caramel";
            ToastIconPath =@<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />;
        }

        ShowStatusToast = true;
        StateHasChanged();
        await Task.Delay(5000);
        ShowStatusToast = false;
        StateHasChanged();
    }

    private void SelectCategory(string category)
    {
        SelectedCategory = category;
        FilterItems();
    }

    private void FilterItems()
    {
        FilteredItems = AllItems.Where(i => i.Category == SelectedCategory).ToList();
    }

    private void ToggleCart() => ShowCart = !ShowCart;

    private void OpenItemModal(MenuItem item)
    {
        SelectedItem = item;
        ShowItemModal = true;
    }

    private void AddToCartFromModal(CartItem cartItem)
    {
        var existing = Cart.FirstOrDefault(i => 
            i.MenuItem.Id == cartItem.MenuItem.Id && 
            i.SelectedVariant == cartItem.SelectedVariant && 
            Enumerable.SequenceEqual(i.SelectedAddons.OrderBy(a => a), cartItem.SelectedAddons.OrderBy(a => a)) &&
            i.SpecialInstructions == cartItem.SpecialInstructions);

        if (existing != null)
        {
            existing.Quantity += cartItem.Quantity;
        }
        else
        {
            Cart.Add(cartItem);
        }
    }

    private void RemoveFromCart(CartItem item)
    {
        Cart.Remove(item);
    }

    private void UpdateQuantity((CartItem item, int delta) args)
    {
        args.item.Quantity = Math.Max(1, args.item.Quantity + args.delta);
    }

    private async Task PlaceOrder()
    {
        if (string.IsNullOrWhiteSpace(CustomerName) || Cart.Count == 0) return;

        var order = await OrderService.CreateOrderAsync(
            CustomerName,
            Cart.ToList(),
            TableNumber ?? string.Empty,
            SelectedOrderType
        );

        LastOrderNumber = order.OrderNumber;
        UserOrderNumbers.Add(LastOrderNumber);
        await LocalStorage.SetAsync("user_orders", UserOrderNumbers);
        await RefreshActiveOrders();

        Cart.Clear();
        CustomerName = string.Empty;
        ShowCart = false;
        ShowOrderSuccess = true;
    }

    private void CloseOrderSuccess()
    {
        ShowOrderSuccess = false;
    }

    private string GetStatusBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-blue-500/20 text-blue-400",
        OrderStatus.Preparing => "bg-amber-500/20 text-amber-400",
        OrderStatus.Ready => "bg-green-500/20 text-green-400",
        OrderStatus.Completed => "bg-gray-500/20 text-gray-400",
        OrderStatus.Cancelled => "bg-red-500/20 text-red-400",
        _ => "bg-gray-500/20 text-gray-400"
    };

    private string GetStatusText(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "Received",
        OrderStatus.Preparing => "Cooking...",
        OrderStatus.Ready => "Order Ready!",
        OrderStatus.Completed => "Order Done",
        OrderStatus.Cancelled => "Order Canceled",
        _ => status.ToString()
    };

    private bool IsDark => branding.ThemeTemplate == "dark-velvet" || branding.ThemeTemplate == "emerald";

    private string GetPageBgClass() => branding.ThemeTemplate switch
    {
        "dark-velvet" => "bg-slate-950 text-stone-100",
        "emerald" => "bg-[#0B1D16] text-stone-100",
        "minimal" => "bg-stone-50 text-stone-900",
        "amber" => "bg-gradient-to-b from-amber-50/80 to-white text-stone-900",
        "artisan" => "bg-gradient-to-b from-[#FBF6EE] to-white text-stone-900",
        _ => "bg-gradient-to-b from-[#FDF6E9] to-white text-stone-900"
    };

    private string GetHeaderClass() => branding.ThemeTemplate switch
    {
        "dark-velvet" => "bg-slate-950/95 border-white/10",
        "emerald" => "bg-[#0B1D16]/95 border-white/10",
        "minimal" => "bg-white/95 border-stone-200",
        "amber" => "bg-amber-50/95 border-amber-200",
        "artisan" => "bg-[#FBF6EE]/95 border-amber-900/10",
        _ => "bg-[#FDF6E9]/95 border-amber-900/10"
    };

    private string GetCartButtonClass() => branding.ColorScheme switch
    {
        "matcha" => "bg-emerald-700 text-white hover:bg-emerald-800",
        "royal-plum" => "bg-pink-700 text-white hover:bg-pink-800",
        "midnight" => "bg-amber-500 text-slate-950 font-bold hover:bg-amber-400",
        "terracotta" => "bg-orange-700 text-white hover:bg-orange-800",
        _ => "bg-[#3D2314] text-white hover:bg-[#6B4423]"
    };

    private string GetMenuFontFamily() => branding.FontFamily switch
    {
        "playfair" => "'Playfair Display', Georgia, serif",
        "poppins" => "'Poppins', sans-serif",
        "cinzel" => "'Cinzel', Georgia, serif",
        "cormorant" => "'Cormorant Garamond', Georgia, serif",
        "montserrat" => "'Montserrat', sans-serif",
        _ => "'Inter', sans-serif"
    };

    public void Dispose()
    {
        NotificationService.OnOrdersChanged -= HandleOrdersChanged;
        _refreshTimer?.Dispose();
    }
}
