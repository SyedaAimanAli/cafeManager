@page "/menu/browse"
@page "/menu/browse/{TableNumber}"
@page "/order"
@page "/order/{TableNumber}"
@using RollUp.Core.Interfaces
@using RollUp.Core.Models
@using RollUp.Features.CustomerMenu.Components
@using RollUp.Shared
@using RollUp.Application.DTOs
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IMenuService MenuService
@inject IOrderService OrderService
@inject IBrandingService BrandingService
@inject IOutletService OutletService
@inject IOrderNotificationService NotificationService
@inject ProtectedLocalStorage LocalStorage
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@(string.IsNullOrWhiteSpace(branding.BusinessName) ? "Menu - RollUp" : $"{branding.BusinessName} - Menu")</PageTitle>

<HeadContent>
    <style>
        :root {
            --color-accent: @AccentColor;
            --color-accent-ink: @AccentInk;
            --font-display: @HeadingFontFamily;
            --color-bg: @ThemeBg;
            --color-surface: @ThemeSurface;
            --color-line: @ThemeLine;
        }
        h1, h2, h3, h4, .font-display {
            font-family: var(--font-display), 'Bricolage Grotesque', sans-serif !important;
        }
    </style>
</HeadContent>

<div class="min-h-screen text-ink pb-24 transition-colors" style="background-color: var(--color-bg);">
    <!-- Header -->
    <header class="sticky top-0 z-40 backdrop-blur-md border-b border-line bg-surface/90 transition-colors">
        <div class="max-w-xl mx-auto px-4 py-3.5">
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl md:text-2xl font-display font-bold text-ink">
                            @(string.IsNullOrWhiteSpace(branding.BusinessName) ? "RollUp" : branding.BusinessName)
                        </h1>
                        @if (!string.IsNullOrEmpty(currentOutletName))
                        {
                            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-accent/20 text-accent border border-accent/30">
                                📍 @currentOutletName
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(TableNumber))
                    {
                        <p class="text-xs font-semibold" style="color: @AccentColor;">Table @TableNumber</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(branding.Tagline))
                    {
                        <p class="text-xs text-ink-muted">@branding.Tagline</p>
                    }
                </div>
                <button type="button" @onclick="ToggleCart" class="relative p-3 rounded-full shadow-lg transition-all active:scale-95 flex items-center justify-center"
                        style="background-color: @AccentColor; color: @AccentInk;">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    @if (Cart.Count > 0)
                    {
                        <span class="absolute -top-1 -right-1 bg-bad text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center shadow-sm">
                            @Cart.Sum(c => c.Quantity)
                        </span>
                    }
                </button>
            </div>
        </div>
    </header>

    <CategoryTabs Categories="Categories"
                  SelectedCategory="@SelectedCategory"
                  OnCategorySelected="SelectCategory"
                  ThemeTemplate="@branding.ThemeTemplate"
                  ColorScheme="@branding.ColorScheme"
                  CustomAccentColor="@branding.CustomAccentColor" />

    <!-- Menu Items -->
    <main class="max-w-xl mx-auto px-4 py-6 space-y-8">
        @if (FilteredItems.Any(i => i.IsPopular && i.IsAvailable) && SelectedCategory == Categories.FirstOrDefault())
        {
            <section>
                <h2 class="text-base font-display font-bold mb-3.5 flex items-center gap-2 text-ink">
                    <span style="color: @AccentColor;">★</span>
                    <span>Popular Items</span>
                </h2>
                <div class="@GetLayoutContainerClass()">
                    @foreach (var item in FilteredItems.Where(i => i.IsPopular && i.IsAvailable))
                    {
                        <MenuItemCard Item="item" 
                                      OnAddToCart="OpenItemModal"
                                      ThemeTemplate="@branding.ThemeTemplate"
                                      ColorScheme="@branding.ColorScheme"
                                      Currency="@branding.Currency"
                                      CustomAccentColor="@branding.CustomAccentColor"
                                      HeadingFont="@branding.HeadingFont"
                                      MenuLayout="@GetEffectiveLayout()" />
                    }
                </div>
            </section>
        }

        <section>
            <h2 class="text-base font-display font-bold mb-3.5 text-ink">@SelectedCategory</h2>
            <div class="@GetLayoutContainerClass()">
                @foreach (var item in FilteredItems.Where(i => !i.IsPopular || SelectedCategory != Categories.FirstOrDefault()))
                {
                    <MenuItemCard Item="item" 
                                  OnAddToCart="OpenItemModal"
                                  ThemeTemplate="@branding.ThemeTemplate"
                                  ColorScheme="@branding.ColorScheme"
                                  Currency="@branding.Currency"
                                  CustomAccentColor="@branding.CustomAccentColor"
                                  HeadingFont="@branding.HeadingFont"
                                  MenuLayout="@GetEffectiveLayout()" />
                }
            </div>
        </section>
    </main>

    <CartSidebar @bind-ShowCart="ShowCart"
                 Cart="Cart"
                 CartTotal="CartTotal"
                 @bind-CustomerName="CustomerName"
                 @bind-SelectedOrderType="SelectedOrderType"
                 OnRemoveFromCart="RemoveFromCart"
                 OnUpdateQuantity="UpdateQuantity"
                 OnPlaceOrder="PlaceOrder"
                 CustomAccentColor="@branding.CustomAccentColor" />

    <ItemDetailsModal @bind-IsOpen="ShowItemModal"
                      Item="SelectedItem"
                      OnAddToCart="AddToCartFromModal"
                      CustomAccentColor="@branding.CustomAccentColor" />

    <!-- Active Orders Floating Bar -->
    @if (ActiveUserOrders.Any())
    {
        <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 w-full max-w-xl px-4 animate-slide-up">
            <div class="bg-surface/95 backdrop-blur-md border border-line text-ink rounded-2xl shadow-elevated overflow-hidden">
                <div class="p-3.5 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="relative">
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background-color: @HexToRgba(AccentColor, 0.2f); color: @AccentColor;">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                </svg>
                            </div>
                            @if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Ready))
                            {
                                <span class="absolute -top-1 -right-1 w-3 h-3 bg-ok rounded-full border-2 border-surface animate-ping"></span>
                                <span class="absolute -top-1 -right-1 w-3 h-3 bg-ok rounded-full border-2 border-surface"></span>
                            }
                        </div>
                        <div>
                            <p class="text-[10px] text-ink-muted uppercase font-bold tracking-wider">Your Active Orders</p>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-ink">@ActiveUserOrders.Count(o => o.Status != OrderStatus.Completed && o.Status != OrderStatus.Cancelled) Active</span>
                                <span class="text-ink-muted">•</span>
                                <span class="text-xs font-semibold" style="color: @AccentColor;">
                                    @if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Ready))
                                    {
                                        <span class="text-ok animate-pulse">Order Ready!</span>
                                    }
                                    else if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Cancelled))
                                    {
                                        <span class="text-bad">Order Canceled</span>
                                    }
                                    else if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Completed))
                                    {
                                        <span class="text-ink-muted">Order Completed</span>
                                    }
                                    else if (ActiveUserOrders.Any(o => o.Status == OrderStatus.Preparing))
                                    {
                                        <span>Preparing…</span>
                                    }
                                    else
                                    {
                                        <span>Order Received</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                    <button type="button" @onclick="() => ShowStatusDetails = !ShowStatusDetails" 
                            class="p-2 hover:bg-line/50 rounded-lg transition-colors text-ink-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform @(ShowStatusDetails ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                </div>

                @if (ShowStatusDetails)
                {
                    <div class="px-4 pb-3.5 space-y-2 max-h-48 overflow-y-auto border-t border-line/50 pt-2.5">
                        @foreach (var order in ActiveUserOrders)
                        {
                            <div class="flex items-center justify-between py-1 text-xs">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono font-bold text-ink">#@order.OrderNumber</span>
                                    <span class="text-ink-muted">(@order.Items.Count items)</span>
                                </div>
                                <span class="@GetStatusBadgeClass(order.Status) px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider">
                                    @GetStatusText(order.Status)
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Order Success Modal -->
    @if (ShowOrderSuccess)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 animate-fade-in">
            <div class="absolute inset-0 bg-black/75 backdrop-blur-xs" @onclick="CloseOrderSuccess"></div>
            <div class="relative bg-surface border border-line rounded-3xl p-7 max-w-sm w-full text-center shadow-2xl text-ink">
                <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4" style="background-color: @HexToRgba(AccentColor, 0.2f); color: @AccentColor;">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h2 class="font-display text-2xl font-bold text-ink mb-1">Order Placed!</h2>
                <p class="text-xs text-ink-muted mb-3">Your order number is</p>
                <div class="p-3 bg-bg border border-line rounded-2xl mb-4">
                    <p class="text-3xl font-mono font-bold tracking-wider" style="color: @AccentColor;">@LastOrderNumber</p>
                </div>
                <p class="text-xs text-ink-muted mb-6">Please watch the live status bar or wait for your number to be called.</p>
                <button type="button" @onclick="CloseOrderSuccess"
                        style="background-color: @AccentColor; color: @AccentInk;"
                        class="w-full py-3.5 font-display font-bold rounded-xl text-sm hover:opacity-90 transition-all shadow-elevated">
                    Continue Browsing
                </button>
            </div>
        </div>
    }

    <!-- Status Change Toast -->
    @if (ShowStatusToast)
    {
        <div class="fixed top-20 left-1/2 -translate-x-1/2 z-50 w-full max-w-sm px-4 animate-bounce-in">
            <div class="bg-surface border border-line rounded-2xl shadow-2xl p-4 flex items-center gap-3 text-ink">
                <div class="w-10 h-10 @ToastIconBgClass rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 @ToastIconColorClass" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        @ToastIconPath
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold text-ink truncate">@ToastTitle</p>
                    <p class="text-[11px] text-ink-muted truncate">@ToastMessage</p>
                </div>
                <button type="button" @onclick="() => ShowStatusToast = false" class="text-ink-muted hover:text-ink">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? TableNumber { get; set; }

    [SupplyParameterFromQuery]
    public int? outletId { get; set; }

    private string? currentOutletName;

    private List<string> Categories = new();
    private string SelectedCategory = string.Empty;
    private List<MenuItem> AllItems = new();
    private List<MenuItem> FilteredItems = new();
    private List<CartItem> Cart = new();
    private bool ShowCart;
    private bool ShowItemModal;
    private MenuItem? SelectedItem;
    private string CustomerName = string.Empty;
    private OrderType SelectedOrderType = OrderType.DineIn;
    private bool ShowOrderSuccess;
    private string LastOrderNumber = string.Empty;

    private List<string> UserOrderNumbers = new();
    private List<Order> ActiveUserOrders = new();
    private bool ShowStatusDetails;

    private bool ShowStatusToast;
    private string ToastTitle = string.Empty;
    private string ToastMessage = string.Empty;
    private string ToastIconBgClass = "bg-accent/20";
    private string ToastIconColorClass = "text-accent";
    private RenderFragment? ToastIconPath;
    private System.Threading.Timer? _refreshTimer;

    private decimal CartTotal => Cart.Sum(c => c.TotalPrice);
    private TenantBrandingDto branding = new();

    private string AccentColor => string.IsNullOrWhiteSpace(branding.CustomAccentColor) ? "#10b981" : branding.CustomAccentColor;
    private string AccentInk => IsLight(AccentColor) ? "#18181b" : "#ffffff";

    private string HeadingFontFamily => branding.HeadingFont?.ToLowerInvariant() switch
    {
        "fraunces" => "'Fraunces', Georgia, serif",
        "dm-sans" => "'DM Sans', sans-serif",
        "bricolage" => "'Bricolage Grotesque', sans-serif",
        _ => "'Bricolage Grotesque', sans-serif"
    };

    private string ThemeBg => branding.ThemeTemplate?.ToLowerInvariant() switch
    {
        "bistro" => "#0c0a09",
        "modern" => "#09090b",
        "rustic" => "#100e0c",
        "minimalist" => "#09090b",
        "elegant" => "#0a0a0c",
        _ => "#09090b"
    };

    private string ThemeSurface => branding.ThemeTemplate?.ToLowerInvariant() switch
    {
        "bistro" => "#1c1917",
        "modern" => "#18181b",
        "rustic" => "#1f1a16",
        "minimalist" => "#121214",
        "elegant" => "#141416",
        _ => "#18181b"
    };

    private string ThemeLine => branding.ThemeTemplate?.ToLowerInvariant() switch
    {
        "bistro" => "#292524",
        "modern" => "#27272a",
        "rustic" => "#2e2620",
        "minimalist" => "#202024",
        "elegant" => "#242428",
        _ => "#27272a"
    };

    private string GetEffectiveLayout() => string.IsNullOrWhiteSpace(branding.MenuLayout) ? "list" : branding.MenuLayout.ToLowerInvariant();

    private string GetLayoutContainerClass() => GetEffectiveLayout() switch
    {
        "card" => "grid grid-cols-1 sm:grid-cols-2 gap-4",
        "compact" => "space-y-2",
        _ => "space-y-3"
    };

    protected override async Task OnInitializedAsync()
    {
        branding = await BrandingService.GetBrandingAsync();
        try
        {
            if (outletId.HasValue && outletId.Value > 0)
            {
                var outlet = await OutletService.GetOutletByIdAsync(outletId.Value);
                currentOutletName = outlet?.Name;
            }
            else
            {
                await OutletService.InitializeActiveOutletAsync();
                currentOutletName = OutletService.ActiveOutlet?.Name;
            }
        }
        catch { }

        Categories = await MenuService.GetCategoriesAsync();
        SelectedCategory = Categories.FirstOrDefault() ?? string.Empty;
        AllItems = await MenuService.GetAllItemsAsync(outletId);
        FilterItems();

        NotificationService.OnOrdersChanged += HandleOrdersChanged;
        BrandingService.OnBrandingChanged += HandleBrandingChanged;
        
        // Polling fallback every 5 seconds
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    await RefreshActiveOrders();
                    StateHasChanged();
                }
                catch { /* Ignore background errors */ }
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void HandleBrandingChanged(TenantBrandingDto newBranding)
    {
        branding = newBranding;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserOrders();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadUserOrders()
    {
        try
        {
            var result = await LocalStorage.GetAsync<List<string>>("user_orders");
            if (result.Success && result.Value != null)
            {
                UserOrderNumbers = result.Value;
                await RefreshActiveOrders();
            }
        }
        catch { /* Storage might not be available yet */ }
    }

    private async Task RefreshActiveOrders()
    {
        if (!UserOrderNumbers.Any())
        {
            ActiveUserOrders.Clear();
            return;
        }

        var orders = await OrderService.GetOrdersByNumbersAsync(UserOrderNumbers);
        ActiveUserOrders = orders.OrderByDescending(o => o.CreatedAt).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleOrdersChanged()
    {
        await InvokeAsync(async () =>
        {
            try
            {
                var previousStatuses = ActiveUserOrders.ToDictionary(o => o.Id, o => o.Status);
                await RefreshActiveOrders();
                
                foreach (var order in ActiveUserOrders)
                {
                    if (previousStatuses.TryGetValue(order.Id, out var oldStatus) && oldStatus != order.Status)
                    {
                        await ShowNotification(order);
                    }
                }
                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ERROR in HandleOrdersChanged: {ex.Message}");
            }
        });
    }

    private async Task ShowNotification(Order order)
    {
        ToastTitle = GetStatusText(order.Status);
        ToastMessage = $"Order #{order.OrderNumber} is now {GetStatusText(order.Status).ToLower()}.";
        
        if (order.Status == OrderStatus.Ready)
        {
            ToastIconBgClass = "bg-ok/20";
            ToastIconColorClass = "text-ok";
            ToastIconPath = @<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />;
            try { await JSRuntime.InvokeVoidAsync("playNotificationSound"); } catch {}
        }
        else if (order.Status == OrderStatus.Cancelled)
        {
            ToastIconBgClass = "bg-bad/20";
            ToastIconColorClass = "text-bad";
            ToastIconPath = @<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />;
        }
        else if (order.Status == OrderStatus.Completed)
        {
            ToastIconBgClass = "bg-line";
            ToastIconColorClass = "text-ink-muted";
            ToastIconPath = @<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />;
        }
        else
        {
            ToastIconBgClass = "bg-accent/20";
            ToastIconColorClass = "text-accent";
            ToastIconPath = @<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />;
        }

        ShowStatusToast = true;
        StateHasChanged();
        await Task.Delay(5000);
        ShowStatusToast = false;
        StateHasChanged();
    }

    private void SelectCategory(string category)
    {
        SelectedCategory = category;
        FilterItems();
    }

    private void FilterItems()
    {
        FilteredItems = AllItems.Where(i => i.Category == SelectedCategory).ToList();
    }

    private void ToggleCart() => ShowCart = !ShowCart;

    private void OpenItemModal(MenuItem item)
    {
        SelectedItem = item;
        ShowItemModal = true;
    }

    private void AddToCartFromModal(CartItem cartItem)
    {
        var existing = Cart.FirstOrDefault(i => 
            i.MenuItem.Id == cartItem.MenuItem.Id && 
            i.SelectedVariant == cartItem.SelectedVariant && 
            Enumerable.SequenceEqual(i.SelectedAddons.OrderBy(a => a), cartItem.SelectedAddons.OrderBy(a => a)) &&
            i.SpecialInstructions == cartItem.SpecialInstructions);

        if (existing != null)
        {
            existing.Quantity += cartItem.Quantity;
        }
        else
        {
            Cart.Add(cartItem);
        }
    }

    private void RemoveFromCart(CartItem item)
    {
        Cart.Remove(item);
    }

    private void UpdateQuantity((CartItem item, int delta) args)
    {
        args.item.Quantity = Math.Max(1, args.item.Quantity + args.delta);
    }

    private async Task PlaceOrder()
    {
        if (string.IsNullOrWhiteSpace(CustomerName) || Cart.Count == 0) return;

        var order = await OrderService.CreateOrderAsync(
            CustomerName,
            Cart.ToList(),
            TableNumber ?? string.Empty,
            SelectedOrderType,
            outletId
        );

        LastOrderNumber = order.OrderNumber;
        UserOrderNumbers.Add(LastOrderNumber);
        await LocalStorage.SetAsync("user_orders", UserOrderNumbers);
        await RefreshActiveOrders();

        Cart.Clear();
        CustomerName = string.Empty;
        ShowCart = false;
        ShowOrderSuccess = true;
    }

    private void CloseOrderSuccess()
    {
        ShowOrderSuccess = false;
    }

    private string GetStatusBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-accent/20 text-accent",
        OrderStatus.Preparing => "bg-amber-500/20 text-amber-400",
        OrderStatus.Ready => "bg-ok/20 text-ok",
        OrderStatus.Completed => "bg-line text-ink-muted",
        OrderStatus.Cancelled => "bg-bad/20 text-bad",
        _ => "bg-line text-ink-muted"
    };

    private string GetStatusText(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "Received",
        OrderStatus.Preparing => "Preparing…",
        OrderStatus.Ready => "Ready!",
        OrderStatus.Completed => "Done",
        OrderStatus.Cancelled => "Canceled",
        _ => status.ToString()
    };

    private static bool IsLight(string hex)
    {
        if (string.IsNullOrEmpty(hex) || hex.Length < 7) return false;
        try
        {
            var r = Convert.ToInt32(hex.Substring(1, 2), 16);
            var g = Convert.ToInt32(hex.Substring(3, 2), 16);
            var b = Convert.ToInt32(hex.Substring(5, 2), 16);
            return (r * 0.299 + g * 0.587 + b * 0.114) > 160;
        }
        catch { return false; }
    }

    private static string HexToRgba(string hex, float alpha)
    {
        if (string.IsNullOrEmpty(hex) || hex.Length < 7) return $"rgba(196,149,106,{alpha})";
        try
        {
            var r = Convert.ToInt32(hex.Substring(1, 2), 16);
            var g = Convert.ToInt32(hex.Substring(3, 2), 16);
            var b = Convert.ToInt32(hex.Substring(5, 2), 16);
            return $"rgba({r},{g},{b},{alpha.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
        }
        catch { return $"rgba(196,149,106,{alpha})"; }
    }

    public void Dispose()
    {
        NotificationService.OnOrdersChanged -= HandleOrdersChanged;
        BrandingService.OnBrandingChanged -= HandleBrandingChanged;
        _refreshTimer?.Dispose();
    }
}
