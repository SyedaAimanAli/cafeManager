@using RollUp.Core.Models

@if (IsOpen && Item != null)
{
    <div class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 animate-fade-in">
        <div class="absolute inset-0 bg-black/75 backdrop-blur-xs" @onclick="Close"></div>
        <div class="relative bg-surface border border-line w-full max-w-lg rounded-t-3xl sm:rounded-3xl max-h-[90vh] flex flex-col overflow-hidden shadow-2xl text-ink">
            <!-- Modal Image Header -->
            <div class="flex-shrink-0 relative h-48 bg-bg overflow-hidden">
                <img src="@Item.ImageUrl" alt="@Item.Name" class="w-full h-full object-cover" />
                <button type="button" @onclick="Close" 
                        class="absolute top-4 right-4 p-2 bg-black/60 hover:bg-black/80 text-white rounded-full shadow-lg transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
                @if (!Item.IsAvailable)
                {
                    <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                        <span class="bg-bad text-white px-4 py-1.5 rounded-full font-bold text-xs">Sold Out</span>
                    </div>
                }
            </div>

            <!-- Scrollable Content Body -->
            <div class="flex-1 overflow-y-auto p-6 space-y-5">
                <div>
                    <div class="flex items-start justify-between gap-3 mb-1">
                        <h2 class="font-display text-2xl font-bold text-ink">@Item.Name</h2>
                        <span class="text-xl font-mono font-bold whitespace-nowrap" style="color: @AccentColor;">$@Item.Price.ToString("F2")</span>
                    </div>
                    <p class="text-xs text-ink-muted leading-relaxed">@Item.Description</p>
                    @if (Item.Tags.Any())
                    {
                        <div class="flex flex-wrap gap-1.5 mt-3">
                            @foreach (var tag in Item.Tags)
                            {
                                <span class="px-2 py-0.5 bg-line/50 text-ink-muted text-[10px] font-semibold uppercase rounded-md border border-line">@tag</span>
                            }
                        </div>
                    }
                </div>

                @if (Item.Variants.Any())
                {
                    <div class="pt-2 border-t border-line/50">
                        <h3 class="font-display font-semibold text-xs text-ink-muted uppercase tracking-wider mb-2.5">Select Size / Variant</h3>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var variant in Item.Variants)
                            {
                                var isSelected = SelectedVariant == variant.Name;
                                <button type="button" @onclick="() => SelectedVariant = variant.Name"
                                        style="@(isSelected ? $"background-color: {AccentColor}; color: {AccentInk}; border-color: {AccentColor};" : string.Empty)"
                                        class="px-4 py-2 rounded-xl text-xs font-semibold border transition-all @(isSelected ? "shadow-sm" : "bg-bg border-line text-ink-muted hover:text-ink")">
                                    @variant.Name
                                    @if (variant.PriceModifier > 0)
                                    {
                                        <span class="ml-1 opacity-80">(+$@variant.PriceModifier.ToString("F2"))</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (Item.Addons.Any())
                {
                    <div class="pt-2 border-t border-line/50">
                        <h3 class="font-display font-semibold text-xs text-ink-muted uppercase tracking-wider mb-2.5">Customize / Add-ons</h3>
                        <div class="space-y-2">
                            @foreach (var addon in Item.Addons)
                            {
                                var isChecked = SelectedAddons.Contains(addon.Name);
                                <label class="flex items-center justify-between p-3 bg-bg/80 border border-line rounded-xl cursor-pointer hover:border-accent/40 transition-colors">
                                    <div class="flex items-center gap-3">
                                        <input type="checkbox" 
                                               checked="@isChecked"
                                               @onchange="() => ToggleAddon(addon.Name)"
                                               class="w-4 h-4 rounded border-line bg-surface text-accent focus:ring-accent" />
                                        <span class="text-xs font-medium text-ink">@addon.Name</span>
                                    </div>
                                    <span class="text-xs font-mono font-bold" style="color: @AccentColor;">+$@addon.Price.ToString("F2")</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="pt-2 border-t border-line/50">
                    <h3 class="font-display font-semibold text-xs text-ink-muted uppercase tracking-wider mb-2">Special Instructions</h3>
                    <textarea @bind="SpecialInstructions" 
                              placeholder="e.g. Extra hot, oat milk, no sugar…"
                              rows="2"
                              class="w-full px-4 py-2.5 bg-bg border border-line rounded-xl text-xs text-ink placeholder-ink-faint focus:outline-none focus:ring-2 focus:ring-accent resize-none"></textarea>
                </div>
            </div>

            <!-- Footer / Add to Order Bar -->
            <div class="flex-shrink-0 px-6 py-4 bg-surface border-t border-line">
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-2 bg-bg border border-line rounded-xl p-1">
                        <button type="button" @onclick="() => Quantity = Math.Max(1, Quantity - 1)"
                                class="w-8 h-8 rounded-lg bg-surface flex items-center justify-center text-ink hover:text-accent transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                            </svg>
                        </button>
                        <span class="font-mono font-bold text-xs text-ink w-7 text-center">@Quantity</span>
                        <button type="button" @onclick="() => Quantity++"
                                class="w-8 h-8 rounded-lg bg-surface flex items-center justify-center text-ink hover:text-accent transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                        </button>
                    </div>
                    
                    <button type="button" @onclick="Submit"
                            disabled="@(!Item.IsAvailable)"
                            style="background-color: @AccentColor; color: @AccentInk;"
                            class="flex-1 py-3 font-display font-bold rounded-xl text-xs md:text-sm hover:opacity-90 active:scale-[0.99] transition-all shadow-elevated disabled:opacity-40 disabled:cursor-not-allowed">
                        Add to Order • $@CalculateTotal().ToString("F2")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public MenuItem? Item { get; set; }
    [Parameter] public EventCallback<CartItem> OnAddToCart { get; set; }
    [Parameter] public string? CustomAccentColor { get; set; }

    private string SelectedVariant { get; set; } = string.Empty;
    private List<string> SelectedAddons { get; set; } = new();
    private string SpecialInstructions { get; set; } = string.Empty;
    private int Quantity { get; set; } = 1;

    private string AccentColor => string.IsNullOrWhiteSpace(CustomAccentColor) ? "#10b981" : CustomAccentColor;
    private string AccentInk => IsLight(AccentColor) ? "#18181b" : "#ffffff";

    private static bool IsLight(string hex)
    {
        if (string.IsNullOrEmpty(hex) || hex.Length < 7) return false;
        try
        {
            var r = Convert.ToInt32(hex.Substring(1, 2), 16);
            var g = Convert.ToInt32(hex.Substring(3, 2), 16);
            var b = Convert.ToInt32(hex.Substring(5, 2), 16);
            return (r * 0.299 + g * 0.587 + b * 0.114) > 160;
        }
        catch { return false; }
    }

    protected override void OnParametersSet()
    {
        if (Item != null && string.IsNullOrEmpty(SelectedVariant))
        {
            SelectedVariant = Item.Variants.FirstOrDefault()?.Name ?? string.Empty;
            SelectedAddons.Clear();
            SpecialInstructions = string.Empty;
            Quantity = 1;
        }
    }

    private void ToggleAddon(string addon)
    {
        if (SelectedAddons.Contains(addon))
            SelectedAddons.Remove(addon);
        else
            SelectedAddons.Add(addon);
    }

    private decimal CalculateTotal()
    {
        if (Item == null) return 0;
        
        var basePrice = Item.Price;
        var variant = Item.Variants.FirstOrDefault(v => v.Name == SelectedVariant);
        if (variant != null) basePrice += variant.PriceModifier;
        
        var addonsPrice = Item.Addons
            .Where(a => SelectedAddons.Contains(a.Name))
            .Sum(a => a.Price);
        
        return (basePrice + addonsPrice) * Quantity;
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Submit()
    {
        if (Item == null || !Item.IsAvailable) return;

        var cartItem = new CartItem
        {
            MenuItem = Item,
            Quantity = Quantity,
            SelectedVariant = SelectedVariant,
            SelectedAddons = new List<string>(SelectedAddons),
            SpecialInstructions = SpecialInstructions
        };

        await OnAddToCart.InvokeAsync(cartItem);
        await Close();
    }
}
