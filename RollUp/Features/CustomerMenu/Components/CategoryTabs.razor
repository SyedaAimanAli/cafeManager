<div class="sticky top-[73px] z-30 backdrop-blur-md border-b border-line bg-surface/90 transition-colors">
    <div class="max-w-lg mx-auto">
        <div class="flex overflow-x-auto scrollbar-hide gap-2 px-4 py-3">
            @foreach (var category in Categories)
            {
                var isSelected = category == SelectedCategory;
                <button type="button" @onclick="() => OnCategorySelected.InvokeAsync(category)"
                        style="@(isSelected ? $"background-color: {(string.IsNullOrWhiteSpace(CustomAccentColor) ? "var(--color-accent, #C4956A)" : CustomAccentColor)}; color: #ffffff;" : string.Empty)"
                        class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all @(isSelected ? "shadow-md font-bold scale-[1.02]" : "bg-bg/80 text-ink-muted hover:text-ink hover:border-accent/40 border border-line")">
                    @category
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public List<string> Categories { get; set; } = new();
    [Parameter] public string SelectedCategory { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnCategorySelected { get; set; }
    [Parameter] public string ThemeTemplate { get; set; } = "bistro";
    [Parameter] public string ColorScheme { get; set; } = "espresso";
    [Parameter] public string? CustomAccentColor { get; set; }
}
