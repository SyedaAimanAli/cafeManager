@using RollUp.Core.Models

@if (ShowCart)
{
    <div class="fixed inset-0 z-50">
        <div class="absolute inset-0 bg-black/50" @onclick="() => ShowCartChanged.InvokeAsync(false)"></div>
        <div class="absolute right-0 top-0 bottom-0 w-full max-w-md bg-white shadow-2xl flex flex-col">
            <div class="p-6 border-b border-gray-100 flex items-center justify-between">
                <h2 class="font-display text-xl font-semibold text-cafe-espresso">Your Order</h2>
                <button @onclick="() => ShowCartChanged.InvokeAsync(false)" class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @if (Cart.Count == 0)
            {
                <div class="flex-1 flex flex-col items-center justify-center p-6 text-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <p class="text-gray-500 mb-2">Your cart is empty</p>
                    <p class="text-sm text-gray-400">Add some items to get started</p>
                </div>
            }
            else
            {
                <div class="flex-1 overflow-y-auto p-6 space-y-4">
                    @foreach (var item in Cart)
                    {
                        <div class="bg-gray-50 rounded-xl p-4">
                            <div class="flex justify-between items-start mb-2">
                                <div class="flex-1">
                                    <h3 class="font-medium text-cafe-espresso">@item.MenuItem.Name</h3>
                                    @if (!string.IsNullOrEmpty(item.SelectedVariant))
                                    {
                                        <p class="text-sm text-cafe-mocha">@item.SelectedVariant</p>
                                    }
                                    @if (item.SelectedAddons.Any())
                                    {
                                        <p class="text-xs text-gray-500">+ @string.Join(", ", item.SelectedAddons)</p>
                                    }
                                </div>
                                <button @onclick="() => OnRemoveFromCart.InvokeAsync(item)" class="p-1 hover:bg-gray-200 rounded transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <button @onclick="() => OnUpdateQuantity.InvokeAsync((item, -1))" 
                                            class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center hover:bg-gray-100 transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                                        </svg>
                                    </button>
                                    <span class="font-medium text-cafe-espresso w-6 text-center">@item.Quantity</span>
                                    <button @onclick="() => OnUpdateQuantity.InvokeAsync((item, 1))"
                                            class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center hover:bg-gray-100 transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                        </svg>
                                    </button>
                                </div>
                                <span class="font-semibold text-cafe-espresso">$@item.TotalPrice.ToString("F2")</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="p-6 border-t border-gray-100 space-y-4">
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm text-gray-500">
                            <span>Subtotal</span>
                            <span>$@CartTotal.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between text-lg font-semibold text-cafe-espresso">
                            <span>Total</span>
                            <span>$@CartTotal.ToString("F2")</span>
                        </div>
                    </div>
                    
                    <div class="space-y-3">
                        <input value="@CustomerName"
                               @onchange="@(e => CustomerNameChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty))"
                               placeholder="Your name" 
                               class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-cafe-caramel focus:border-transparent" />
                        
                        <div class="flex gap-2">
                            <button @onclick="() => SelectedOrderTypeChanged.InvokeAsync(OrderType.DineIn)"
                                    class="@GetOrderTypeClass(OrderType.DineIn)">
                                Dine In
                            </button>
                            <button @onclick="() => SelectedOrderTypeChanged.InvokeAsync(OrderType.TakeAway)"
                                    class="@GetOrderTypeClass(OrderType.TakeAway)">
                                Take Away
                            </button>
                        </div>
                    </div>

                    <button @onclick="OnPlaceOrder"
                            disabled="@(string.IsNullOrWhiteSpace(CustomerName) || Cart.Count == 0)"
                            class="w-full py-4 bg-cafe-espresso text-white font-semibold rounded-xl hover:bg-cafe-mocha transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                        Place Order
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool ShowCart { get; set; }
    [Parameter] public EventCallback<bool> ShowCartChanged { get; set; }
    [Parameter] public List<CartItem> Cart { get; set; } = new();
    [Parameter] public decimal CartTotal { get; set; }
    [Parameter] public string CustomerName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> CustomerNameChanged { get; set; }
    [Parameter] public OrderType SelectedOrderType { get; set; } = OrderType.DineIn;
    [Parameter] public EventCallback<OrderType> SelectedOrderTypeChanged { get; set; }
    [Parameter] public EventCallback OnPlaceOrder { get; set; }
    [Parameter] public EventCallback<CartItem> OnRemoveFromCart { get; set; }
    [Parameter] public EventCallback<(CartItem item, int delta)> OnUpdateQuantity { get; set; }

    private string GetOrderTypeClass(OrderType type)
    {
        var baseClass = "flex-1 py-3 rounded-xl font-medium transition-colors ";
        return type == SelectedOrderType
            ? baseClass + "bg-cafe-espresso text-white"
            : baseClass + "bg-gray-100 text-cafe-mocha hover:bg-gray-200";
    }
}
