@using RollUp.Core.Models
@using RollUp.Features.Queue.Components

<div class="flex flex-col">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
            <div class="w-3 h-3 @DotColorClass rounded-full @DotAnimationClass"></div>
            <h2 class="text-lg font-semibold font-display text-ink">@Title</h2>
        </div>
        <span class="px-2.5 py-0.5 @BadgeColorClass text-xs font-semibold rounded-full">@Orders.Count</span>
    </div>
    
    <div class="flex-1 space-y-4 min-h-[200px] md:min-h-[calc(100vh-280px)]">
        @foreach (var order in Orders)
        {
            <OrderKanbanCard Order="order" 
                             ColumnType="ColumnType"
                             OnStatusChange="OnStatusChange"
                             OnCancel="OnCancel" />
        }

        @if (!Orders.Any())
        {
            <div class="bg-surface/50 rounded-xl border border-dashed border-line p-8 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-ink-faint mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    @EmptyIconPath
                </svg>
                <p class="text-ink-muted text-sm">@EmptyMessage</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public OrderStatus ColumnType { get; set; }
    [Parameter] public List<Order> Orders { get; set; } = new();
    [Parameter] public string DotColorClass { get; set; } = "bg-stone-500";
    [Parameter] public string DotAnimationClass { get; set; } = string.Empty;
    [Parameter] public string BadgeColorClass { get; set; } = "bg-surface text-ink-muted border border-line";
    [Parameter] public string EmptyMessage { get; set; } = "No orders";
    [Parameter] public RenderFragment? EmptyIconPath { get; set; }
    [Parameter] public EventCallback<(Order Order, OrderStatus Status)> OnStatusChange { get; set; }
    [Parameter] public EventCallback<int> OnCancel { get; set; }
}
