@page "/admin/queue"
@page "/kitchen"
@using RollUp.Core.Interfaces
@using RollUp.Core.Models
@using RollUp.Features.Queue.Components
@inject IOrderService OrderService
@inject IOrderNotificationService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Queue Management - RollUp</PageTitle>

<div class="min-h-screen bg-stone-100">
    <!-- Header -->
    <header class="bg-white border-b border-stone-200 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 md:px-6 py-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-cafe-espresso rounded-xl flex items-center justify-center flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
                            <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg md:text-xl font-semibold text-cafe-espresso">Kitchen Queue</h1>
                        <p class="text-xs md:text-sm text-stone-500">Manage incoming orders</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center justify-between md:justify-end gap-4 md:gap-6">
                    <div class="text-left md:text-right">
                        <p class="text-[10px] md:text-sm text-stone-500">Current Time</p>
                        <p class="text-base md:text-xl font-semibold text-cafe-espresso tabular-nums">@CurrentTime</p>
                    </div>
                    <div class="flex items-center gap-2 md:gap-3">
                        <button @onclick='() => Navigation.NavigateTo("/manage")' 
                                class="p-2 md:px-4 md:py-2 bg-cafe-mocha text-white text-xs md:text-sm font-medium rounded-lg hover:bg-cafe-espresso transition-colors flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span class="hidden sm:inline">Manage Menu</span>
                        </button>
                        <div class="flex items-center gap-2 md:gap-3 px-3 py-1.5 md:px-4 md:py-2 bg-stone-100 rounded-lg">
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                                <span class="text-sm text-stone-600">@PendingOrders.Count</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 bg-amber-500 rounded-full"></div>
                                <span class="text-sm text-stone-600">@PreparingOrders.Count</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 bg-emerald-500 rounded-full"></div>
                                <span class="text-sm text-stone-600">@ReadyOrders.Count</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 md:px-6 py-6 md:py-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Pending Column -->
            <QueueColumn Title="New Orders"
                         ColumnType="OrderStatus.Pending"
                         Orders="PendingOrders"
                         DotColorClass="bg-blue-500"
                         BadgeColorClass="bg-blue-100 text-blue-700"
                         EmptyMessage="No new orders"
                         OnStatusChange="@(async s => await MoveToStatus(s.Order.Id, s.Status))"
                         OnCancel="CancelOrder">
                <EmptyIconPath>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </EmptyIconPath>
            </QueueColumn>

            <!-- Preparing Column -->
            <QueueColumn Title="Preparing"
                         ColumnType="OrderStatus.Preparing"
                         Orders="PreparingOrders"
                         DotColorClass="bg-amber-500"
                         DotAnimationClass="animate-pulse"
                         BadgeColorClass="bg-amber-100 text-amber-700"
                         EmptyMessage="Nothing cooking"
                         OnStatusChange="@(async s => await MoveToStatus(s.Order.Id, s.Status))">
                <EmptyIconPath>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </EmptyIconPath>
            </QueueColumn>

            <!-- Ready Column -->
            <QueueColumn Title="Ready for Pickup"
                         ColumnType="OrderStatus.Ready"
                         Orders="ReadyOrders"
                         DotColorClass="bg-emerald-500"
                         BadgeColorClass="bg-emerald-100 text-emerald-700"
                         EmptyMessage="No orders ready"
                         OnStatusChange="@(async s => await MoveToStatus(s.Order.Id, s.Status))">
                <EmptyIconPath>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </EmptyIconPath>
            </QueueColumn>
        </div>
    </main>

    <!-- New Order Notification Toast -->
    @if (ShowNewOrderToast)
    {
        <div class="fixed bottom-8 right-8 z-50 animate-bounce-in">
            <div class="bg-cafe-espresso text-white p-6 rounded-2xl shadow-2xl border-2 border-cafe-caramel flex items-center gap-4 min-w-[320px]">
                <div class="w-12 h-12 bg-cafe-caramel rounded-xl flex items-center justify-center animate-pulse">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="font-bold text-lg">New Order Received!</h3>
                    <p class="text-cafe-cream text-sm">Check the "New Orders" column</p>
                </div>
                <button @onclick="() => ShowNewOrderToast = false" class="p-2 hover:bg-white/10 rounded-lg transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
    }
</div>

<style>
    @@keyframes bounce-in {
        0% { transform: scale(0.3); opacity: 0; }
        50% { transform: scale(1.05); opacity: 1; }
        70% { transform: scale(0.9); }
        100% { transform: scale(1); }
    }
    .animate-bounce-in {
        animation: bounce-in 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }
</style>

@code {
    private List<Order> PendingOrders = new();
    private List<Order> PreparingOrders = new();
    private List<Order> ReadyOrders = new();
    private string CurrentTime = string.Empty;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
        UpdateTime();
        
        _timer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                try
                {
                    UpdateTime();
                    StateHasChanged();
                }
                catch { /* Ignore background timer errors */ }
            });
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        NotificationService.OnOrdersChanged += OnOrdersChanged;
    }

    private async Task LoadOrders()
    {
        PendingOrders = await OrderService.GetOrdersByStatusAsync(OrderStatus.Pending);
        PreparingOrders = await OrderService.GetOrdersByStatusAsync(OrderStatus.Preparing);
        ReadyOrders = await OrderService.GetOrdersByStatusAsync(OrderStatus.Ready);
    }

    private bool ShowNewOrderToast = false;

    private async void OnOrdersChanged()
    {
        await InvokeAsync(async () =>
        {
            try
            {
                var oldPendingCount = PendingOrders.Count;
                await LoadOrders();

                if (PendingOrders.Count > oldPendingCount)
                {
                    ShowNewOrderToast = true;
                    // Only try to play sound if JS is ready (likely is since this is an event after interaction)
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("playNotificationSound");
                    }
                    catch { /* JS might not be ready or method missing */ }
                    
                    StateHasChanged();

                    // Auto-hide after 5 seconds
                    await Task.Delay(5000);
                    ShowNewOrderToast = false;
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in OnOrdersChanged: {ex.Message}");
            }
        });
    }

    private void UpdateTime()
    {
        CurrentTime = DateTime.Now.ToString("HH:mm:ss");
    }

    private async Task MoveToStatus(int orderId, OrderStatus newStatus)
    {
        await OrderService.UpdateOrderStatusAsync(orderId, newStatus);
    }

    private async Task CancelOrder(int orderId)
    {
        await OrderService.CancelOrderAsync(orderId);
    }

    public void Dispose()
    {
        _timer?.Dispose();
        NotificationService.OnOrdersChanged -= OnOrdersChanged;
    }
}
