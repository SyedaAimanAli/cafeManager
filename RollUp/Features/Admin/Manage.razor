@page "/manage"
@attribute [Authorize]

@using RollUp.Application.DTOs
@using RollUp.Core.Entities
@using RollUp.Core.Enums
@using RollUp.Core.Interfaces
@using RollUp.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject IBrandingService BrandingService
@inject IMenuService MenuService
@inject IUserService UserService
@inject IOutletService OutletService
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Settings & Management — RollUp</PageTitle>

<div class="p-4 md:p-8 space-y-8 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-line">
        <div>
            <h1 class="text-2xl md:text-3xl font-display font-bold text-ink">Settings & Operations</h1>
            <p class="text-xs md:text-sm text-ink-muted mt-1">
                Configure outlets, categories, staff permissions, accepted payment methods, and account
            </p>
        </div>

        <div class="flex items-center gap-2">
            @if (showSavedToast)
            {
                <span class="px-3 py-1.5 rounded-xl bg-ok/15 text-ok text-xs font-semibold animate-fade-in flex items-center gap-1.5">
                    <span>✓</span>
                    <span>@toastMessage</span>
                </span>
            }
        </div>
    </div>

    <!-- Navigation Section Tabs -->
    <div class="flex flex-wrap gap-2 pb-2 border-b border-line">
        <button type="button" @onclick="() => activeSection = 0"
                class="px-4 py-2 rounded-xl text-xs md:text-sm font-semibold transition-all @(activeSection == 0 ? "bg-accent text-accent-ink shadow-sm" : "bg-surface border border-line text-ink-muted hover:text-ink")">
            Outlets & Branding
        </button>
        <button type="button" @onclick="() => activeSection = 1"
                class="px-4 py-2 rounded-xl text-xs md:text-sm font-semibold transition-all @(activeSection == 1 ? "bg-accent text-accent-ink shadow-sm" : "bg-surface border border-line text-ink-muted hover:text-ink")">
            Menu Categories
        </button>
        <button type="button" @onclick="() => activeSection = 2"
                class="px-4 py-2 rounded-xl text-xs md:text-sm font-semibold transition-all @(activeSection == 2 ? "bg-accent text-accent-ink shadow-sm" : "bg-surface border border-line text-ink-muted hover:text-ink")">
            Team & Roles
        </button>
        <button type="button" @onclick="() => activeSection = 3"
                class="px-4 py-2 rounded-xl text-xs md:text-sm font-semibold transition-all @(activeSection == 3 ? "bg-accent text-accent-ink shadow-sm" : "bg-surface border border-line text-ink-muted hover:text-ink")">
            Payments & Checkout
        </button>
    </div>

    @* ── SECTION 0: OUTLETS & BRANDING ───────────────────────────────────── *@
    @if (activeSection == 0)
    {
        <div class="space-y-6">
            <!-- Quick Shortcuts to Studio and QR -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <a href="/menu" class="p-5 bg-surface border border-line rounded-card hover:border-accent transition-all group flex items-start justify-between">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-accent text-base">🎨</span>
                            <h3 class="font-display font-bold text-ink text-base group-hover:text-accent transition-colors">Design Studio</h3>
                        </div>
                        <p class="text-xs text-ink-muted">Customize templates, colors, typography, and live phone menu preview</p>
                    </div>
                    <span class="text-xs text-accent font-semibold flex items-center gap-1">&rarr;</span>
                </a>

                <a href="/share" class="p-5 bg-surface border border-line rounded-card hover:border-accent transition-all group flex items-start justify-between">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-accent text-base">📱</span>
                            <h3 class="font-display font-bold text-ink text-base group-hover:text-accent transition-colors">QR & Print Hub</h3>
                        </div>
                        <p class="text-xs text-ink-muted">Generate table standee QR codes and printable dine-in menus</p>
                    </div>
                    <span class="text-xs text-accent font-semibold flex items-center gap-1">&rarr;</span>
                </a>
            </div>

            <!-- Café Info Form -->
            <div class="p-6 bg-surface border border-line rounded-card space-y-4">
                <h3 class="font-display font-bold text-ink text-base">Café Profile</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-ink-muted mb-1.5">Business Name</label>
                        <input type="text" @bind="branding.BusinessName"
                               class="w-full px-4 py-2.5 bg-bg border border-line rounded-xl text-xs md:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-ink-muted mb-1.5">Tagline</label>
                        <input type="text" @bind="branding.Tagline" placeholder="e.g. Artisan Coffee & Baked Goods"
                               class="w-full px-4 py-2.5 bg-bg border border-line rounded-xl text-xs md:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-ink-muted mb-1.5">Phone Number</label>
                        <input type="text" @bind="branding.ContactPhone"
                               class="w-full px-4 py-2.5 bg-bg border border-line rounded-xl text-xs md:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-ink-muted mb-1.5">Contact Email</label>
                        <input type="email" @bind="branding.ContactEmail"
                               class="w-full px-4 py-2.5 bg-bg border border-line rounded-xl text-xs md:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-ink-muted mb-1.5">Street Address</label>
                        <input type="text" @bind="branding.Address"
                               class="w-full px-4 py-2.5 bg-bg border border-line rounded-xl text-xs md:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
                    </div>
                </div>

                <div class="pt-2 flex items-center gap-3">
                    <button type="button" @onclick="SaveBranding" disabled="@isSaving"
                            class="px-5 py-2.5 bg-accent text-accent-ink font-bold rounded-pill text-xs md:text-sm hover:opacity-90 disabled:opacity-50 transition-all flex items-center gap-2 shadow-sm cursor-pointer">
                        @if (isSaving)
                        {
                            <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <span>Save Profile</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        }
                    </button>

                    @if (isProfileSaved)
                    {
                        <span class="text-xs font-semibold text-ok animate-fade-in flex items-center gap-1">
                            ✓ Profile saved successfully!
                        </span>
                    }
                </div>
            </div>

            <!-- Outlets List -->
            <div id="branches" class="p-6 bg-surface border border-line rounded-card space-y-5 scroll-mt-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-display font-bold text-ink text-base">Branches & Locations</h3>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-accent/15 text-accent">@outlets.Count active</span>
                        </div>
                        <p class="text-xs text-ink-muted mt-0.5">Manage outlets, activate system scope, or inspect branch-specific queue & sales</p>
                    </div>
                    <button type="button" @onclick="() => showAddOutletModal = true"
                            class="px-4 py-2 bg-accent text-accent-ink font-bold rounded-pill text-xs hover:opacity-90 transition-all flex items-center gap-1.5 self-start sm:self-auto shadow-sm cursor-pointer">
                        <span>+</span>
                        <span>Add Branch</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @if (outlets.Any())
                    {
                        @foreach (var o in outlets)
                        {
                            var curOutlet = o;
                            var isActive = OutletService.ActiveOutletId == curOutlet.Id;
                            <div class="p-5 rounded-2xl border transition-all relative flex flex-col justify-between gap-4 @(isActive ? "bg-accent/5 border-accent ring-1 ring-accent/30 shadow-sm" : "bg-bg border-line hover:border-accent/40")">
                                <div>
                                    <div class="flex items-start justify-between gap-2 mb-2">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="text-lg">🏪</span>
                                            <div class="min-w-0">
                                                <h4 class="font-bold text-sm text-ink truncate">@curOutlet.Name</h4>
                                                <span class="text-[10px] text-ink-muted">@curOutlet.Address</span>
                                            </div>
                                        </div>
                                        <span class="px-2 py-0.5 rounded-pill bg-accent/15 text-accent text-[10px] font-bold flex-shrink-0">
                                            @curOutlet.OutletType.ToString()
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(curOutlet.Phone))
                                    {
                                        <div class="text-xs text-ink-faint flex items-center gap-1.5 mb-1">
                                            <span>📞</span>
                                            <span>@curOutlet.Phone</span>
                                        </div>
                                    }
                                </div>

                                <div class="pt-3 border-t border-line/60 flex items-center justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        @if (isActive)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-pill bg-ok/15 text-ok text-xs font-bold border border-ok/30">
                                                <span class="w-2 h-2 rounded-full bg-ok animate-pulse"></span>
                                                <span>Active Branch</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" @onclick="() => SwitchActiveBranch(curOutlet.Id)"
                                                    class="px-3.5 py-1.5 rounded-pill bg-accent text-accent-ink hover:opacity-90 font-bold text-xs transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
                                                    title="Set this as the active branch across all screens">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                                </svg>
                                                <span>Activate Branch</span>
                                            </button>
                                        }
                                    </div>

                                    <button type="button" @onclick="() => OpenBranchInfo(curOutlet.Id)"
                                            class="px-3 py-1.5 rounded-pill bg-surface hover:bg-line/50 border border-line text-ink-muted hover:text-ink text-xs font-semibold transition-colors flex items-center gap-1 cursor-pointer">
                                        <span>Branch Info</span>
                                        <span>&rarr;</span>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-span-full py-8 text-center text-xs text-ink-muted">
                            No branches configured. Click "+ Add Branch" above to add your first branch.
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ── SECTION 1: MENU CATEGORIES ──────────────────────────────────────── *@
    @if (activeSection == 1)
    {
        <div class="space-y-6">
            <!-- Segmented Sub-Tab Switcher: Active vs Archive -->
            <div class="flex items-center justify-between gap-4">
                <div class="inline-flex p-1 bg-surface rounded-2xl border border-line">
                    <button type="button" @onclick="() => categoryTab = 0"
                            class="px-5 py-2 rounded-xl text-xs md:text-sm font-semibold transition-all flex items-center gap-2 @(categoryTab == 0 ? "bg-accent text-accent-ink shadow-sm" : "text-ink-muted hover:text-ink")">
                        <span>Active Categories</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(categoryTab == 0 ? "bg-white/20 text-accent-ink" : "bg-line text-ink")">
                            @categories.Count
                        </span>
                    </button>
                    <button type="button" @onclick="() => categoryTab = 1"
                            class="px-5 py-2 rounded-xl text-xs md:text-sm font-semibold transition-all flex items-center gap-2 @(categoryTab == 1 ? "bg-accent text-accent-ink shadow-sm" : "text-ink-muted hover:text-ink")">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                        </svg>
                        <span>Archive</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(categoryTab == 1 ? "bg-white/20 text-accent-ink" : "bg-line text-ink")">
                            @archivedCategories.Count
                        </span>
                    </button>
                </div>
            </div>

            @if (categoryTab == 0)
            {
                <!-- Add Category Card -->
                <div class="p-6 bg-surface border border-line rounded-card space-y-4">
                    <h3 class="font-display font-bold text-ink text-base">Add New Menu Category</h3>
                    <div class="flex gap-2">
                        <input type="text" @bind="newCategoryName" placeholder="e.g. Cold Brews, Pastries, Gluten-Free"
                               class="flex-1 px-4 py-2.5 bg-bg border border-line rounded-xl text-xs md:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
                        <button type="button" @onclick="AddCategory"
                                class="px-6 py-2.5 bg-accent text-accent-ink font-bold rounded-pill text-xs md:text-sm hover:opacity-90 transition-all shadow-sm">
                            Add Category
                        </button>
                    </div>
                </div>

                <!-- Active Categories List -->
                <div class="p-6 bg-surface border border-line rounded-card space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="font-display font-bold text-ink text-base">Active Categories (@categories.Count)</h3>
                            <p class="text-xs text-ink-muted">Visible to customers on the ordering menu</p>
                        </div>
                    </div>
                    <div class="divide-y divide-line/40">
                        @if (categories.Any())
                        {
                            @foreach (var cat in categories)
                            {
                                var curCat = cat;
                                <div class="py-3.5 flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
                                        <span class="font-medium text-sm text-ink">@curCat</span>
                                    </div>
                                    <button type="button" @onclick="() => ArchiveCategory(curCat)"
                                            class="px-3 py-1.5 rounded-pill bg-bg hover:bg-line/50 border border-line text-xs text-ink-muted hover:text-bad font-semibold transition-colors flex items-center gap-1.5"
                                            title="Archive category (hides from customer menu)">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                                        </svg>
                                        <span>Archive</span>
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="py-6 text-center text-xs text-ink-muted">No active categories. Add one above!</div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Archived Categories List -->
                <div class="p-6 bg-surface border border-line rounded-card space-y-4">
                    <div class="p-4 rounded-xl bg-bg border border-line flex items-start gap-3 text-xs text-ink-muted">
                        <span class="text-base text-accent">📦</span>
                        <div>
                            <span class="font-semibold text-ink">Category Archive:</span>
                            <span> Archived categories are safely deactivated and hidden from customer ordering. Existing menu items retain their data, and you can restore any category back to the live menu at any time.</span>
                        </div>
                    </div>

                    <div class="divide-y divide-line/40 pt-1">
                        @if (archivedCategories.Any())
                        {
                            @foreach (var cat in archivedCategories)
                            {
                                var curCat = cat;
                                <div class="py-3.5 flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <span class="w-2.5 h-2.5 rounded-full bg-ink-faint"></span>
                                        <span class="font-medium text-sm text-ink-muted line-through">@curCat</span>
                                        <span class="px-2 py-0.5 rounded-pill bg-line text-ink-faint text-[10px] font-bold uppercase">Archived</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <button type="button" @onclick="() => RestoreCategory(curCat)"
                                                class="px-3 py-1.5 rounded-pill bg-accent/15 hover:bg-accent/25 text-accent text-xs font-semibold transition-colors flex items-center gap-1.5"
                                                title="Restore category back to live menu">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                            </svg>
                                            <span>Restore</span>
                                        </button>
                                        <button type="button" @onclick="() => PermanentlyDeleteCategory(curCat)"
                                                class="p-1.5 text-ink-faint hover:text-bad hover:bg-bad/10 rounded-lg transition-colors text-xs"
                                                title="Delete permanently from database">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="py-8 text-center text-xs text-ink-muted">
                                <p class="mb-1 font-semibold text-ink">No archived categories</p>
                                <p class="text-ink-faint">When you archive a category, it will safely appear here.</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* ── SECTION 2: TEAM & ROLES ─────────────────────────────────────────── *@
    @if (activeSection == 2)
    {
        <div class="space-y-6">
            <!-- Team Stats & Add Member -->
            <div class="p-6 bg-surface border border-line rounded-card flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h3 class="font-display font-bold text-ink text-base">Active Team Members (@users.Count)</h3>
                    <p class="text-xs text-ink-muted">Manage staff access roles for admin, kitchen queue, and counter POS</p>
                </div>

                <button type="button" @onclick="() => showAddUserModal = true"
                        class="px-4 py-2.5 bg-accent text-accent-ink font-bold rounded-pill text-xs md:text-sm hover:opacity-90 transition-all shadow-sm flex items-center gap-1.5">
                    <span>+ Add Member</span>
                </button>
            </div>

            <!-- Users List Table -->
            <div class="bg-surface border border-line rounded-card overflow-hidden">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b border-line bg-line/20 text-ink-muted uppercase tracking-wider text-[10px]">
                            <th class="p-4 font-semibold">Name</th>
                            <th class="p-4 font-semibold">Email</th>
                            <th class="p-4 font-semibold">Role</th>
                            <th class="p-4 font-semibold">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line/40">
                        @foreach (var user in users)
                        {
                            <tr class="hover:bg-line/20 transition-colors">
                                <td class="p-4 font-semibold text-ink">@user.FullName</td>
                                <td class="p-4 text-ink-muted">@user.Email</td>
                                <td class="p-4">
                                    <span class="px-2.5 py-0.5 rounded-pill text-[10px] font-bold @GetRoleBadgeClass(user.Role)">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="p-4">
                                    <span class="text-ok font-semibold text-[11px]">Active</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ── SECTION 3: PAYMENTS & CHECKOUT ──────────────────────────────────── *@
    @if (activeSection == 3)
    {
        <div class="space-y-6">
            <div class="p-6 bg-surface border border-line rounded-card space-y-4">
                <h3 class="font-display font-bold text-ink text-base">Accepted Payment Methods</h3>
                <p class="text-xs text-ink-muted">Toggle which payment options customers see during checkout and order placement</p>

                <div class="space-y-3 pt-2">
                    <div class="p-4 bg-bg border border-line rounded-xl flex items-center justify-between">
                        <div>
                            <div class="font-medium text-ink text-sm">Physical Cash</div>
                            <div class="text-xs text-ink-muted">Customer pays in person at pickup or counter</div>
                        </div>
                        <RollUpToggleSwitch Checked="@acceptCash" CheckedChanged="@(async val => { acceptCash = val; await SavePayments(); })" />
                    </div>

                    <div class="p-4 bg-bg border border-line rounded-xl flex items-center justify-between">
                        <div>
                            <div class="font-medium text-ink text-sm">Credit & Debit Cards</div>
                            <div class="text-xs text-ink-muted">Chip, PIN, swipe, or contactless card terminal</div>
                        </div>
                        <RollUpToggleSwitch Checked="@acceptCard" CheckedChanged="@(async val => { acceptCard = val; await SavePayments(); })" />
                    </div>

                    <div class="p-4 bg-bg border border-line rounded-xl flex items-center justify-between">
                        <div>
                            <div class="font-medium text-ink text-sm">Mobile Wallet / Apple Pay</div>
                            <div class="text-xs text-ink-muted">Digital wallet and instant customer scan pay</div>
                        </div>
                        <RollUpToggleSwitch Checked="@acceptMobileWallet" CheckedChanged="@(async val => { acceptMobileWallet = val; await SavePayments(); })" />
                    </div>
                </div>
            </div>

            <!-- Currency Settings -->
            <div class="p-6 bg-surface border border-line rounded-card space-y-3">
                <h3 class="font-display font-bold text-ink text-base">Store Currency</h3>
                <div class="max-w-xs">
                    <select @bind="branding.Currency" @bind:after="SaveBranding"
                            class="w-full px-4 py-2.5 bg-bg border border-line rounded-xl text-xs md:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent font-semibold">
                        <option value="USD">USD ($) — US Dollar</option>
                        <option value="EUR">EUR (€) — Euro</option>
                        <option value="GBP">GBP (£) — British Pound</option>
                        <option value="CAD">CAD ($) — Canadian Dollar</option>
                        <option value="AUD">AUD ($) — Australian Dollar</option>
                    </select>
                </div>
            </div>

            <!-- Sign Out Action -->
            <div class="p-6 bg-surface border border-line rounded-card flex items-center justify-between">
                <div>
                    <h3 class="font-display font-bold text-ink text-base">Session</h3>
                    <p class="text-xs text-ink-muted">Sign out of this device</p>
                </div>
                <button type="button" @onclick="HandleLogout"
                        class="px-4 py-2 bg-bad/10 text-bad hover:bg-bad/20 font-semibold rounded-pill text-xs transition-colors">
                    Sign Out
                </button>
            </div>
        </div>
    }
</div>

