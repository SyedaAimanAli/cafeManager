<!-- Branch Info Modal -->
@if (showOutletInfoModal && selectedOutletSummary != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-xs" @onclick="() => showOutletInfoModal = false"></div>
        <div class="relative bg-surface border border-line rounded-3xl p-6 sm:p-8 w-full max-w-lg shadow-2xl text-ink space-y-6">
            <!-- Modal Header -->
            <div class="flex items-start justify-between gap-4 pb-4 border-b border-line">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-xl">🏪</span>
                        <h3 class="font-display font-bold text-xl text-ink">@selectedOutletSummary.Name</h3>
                        <span class="px-2 py-0.5 rounded-pill bg-accent/15 text-accent text-[10px] font-bold">
                            @selectedOutletSummary.OutletType.ToString()
                        </span>
                    </div>
                    <p class="text-xs text-ink-muted">@selectedOutletSummary.Address</p>
                    @if (!string.IsNullOrEmpty(selectedOutletSummary.Phone))
                    {
                        <p class="text-xs text-ink-faint mt-0.5">📞 @selectedOutletSummary.Phone</p>
                    }
                </div>
                <button type="button" @onclick="() => showOutletInfoModal = false" class="text-ink-muted hover:text-ink text-2xl font-bold leading-none p-1">&times;</button>
            </div>

            <!-- Live Operations Grid -->
            <div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-ink-faint mb-3">Live Branch Operations</div>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    <div class="p-3.5 bg-bg rounded-2xl border border-line">
                        <div class="text-[10px] uppercase font-semibold text-ink-faint">Live Queue</div>
                        <div class="text-xl font-bold font-display text-amber-400 mt-1">@selectedOutletSummary.ActiveQueueCount</div>
                        <div class="text-[10px] text-ink-muted">in kitchen / ready</div>
                    </div>

                    <div class="p-3.5 bg-bg rounded-2xl border border-line">
                        <div class="text-[10px] uppercase font-semibold text-ink-faint">Today's Orders</div>
                        <div class="text-xl font-bold font-display text-ink mt-1">@selectedOutletSummary.TodayOrdersCount</div>
                        <div class="text-[10px] text-ink-muted">processed today</div>
                    </div>

                    <div class="p-3.5 bg-bg rounded-2xl border border-line col-span-2 sm:col-span-1">
                        <div class="text-[10px] uppercase font-semibold text-ink-faint">Today's Sales</div>
                        <div class="text-xl font-bold font-display text-accent mt-1">$@selectedOutletSummary.TodayRevenue.ToString("F2")</div>
                        <div class="text-[10px] text-ink-muted">revenue today</div>
                    </div>
                </div>
            </div>

            <!-- Branch Configuration & Links -->
            <div class="space-y-2">
                <div class="text-[10px] font-bold uppercase tracking-wider text-ink-faint">Branch Quick Actions</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <button type="button" @onclick='() => MakeSelectedActiveAndGo("/queue")'
                            class="p-3 rounded-xl bg-bg border border-line hover:border-accent text-left transition-all group flex items-center justify-between cursor-pointer">
                        <div>
                            <div class="text-xs font-bold text-ink group-hover:text-accent transition-colors">Kitchen Queue</div>
                            <div class="text-[10px] text-ink-muted">Open live order screen</div>
                        </div>
                        <span class="text-accent text-xs font-bold">&rarr;</span>
                    </button>

                    <a href="/order" target="_blank"
                       class="p-3 rounded-xl bg-bg border border-line hover:border-accent text-left transition-all group flex items-center justify-between">
                        <div>
                            <div class="text-xs font-bold text-ink group-hover:text-accent transition-colors">Customer Menu</div>
                            <div class="text-[10px] text-ink-muted">Open ordering page</div>
                        </div>
                        <span class="text-accent text-xs font-bold">↗</span>
                    </a>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="pt-3 border-t border-line flex items-center justify-between">
                <div>
                    @if (OutletService.ActiveOutletId == selectedOutletSummary.OutletId)
                    {
                        <span class="text-xs font-semibold text-ok flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-ok animate-pulse"></span>
                            Currently Active in System
                        </span>
                    }
                    else
                    {
                        <button type="button" @onclick="() => MakeSelectedActive(selectedOutletSummary.OutletId)"
                                class="px-4 py-2 bg-accent text-accent-ink text-xs font-bold rounded-pill hover:opacity-90 transition-all shadow-sm cursor-pointer">
                            Switch System to this Branch
                        </button>
                    }
                </div>

                <button type="button" @onclick="() => showOutletInfoModal = false"
                        class="px-4 py-2 rounded-xl text-xs font-semibold text-ink-muted hover:text-ink cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private int activeSection = 0;
    private TenantBrandingDto branding = new();
    private List<string> categories = new();
    private List<string> archivedCategories = new();
    private int categoryTab = 0;
    private List<UserListItemDto> users = new();
    private List<Outlet> outlets = new();

    private string newCategoryName = string.Empty;
    private bool isSaving = false;
    private bool isProfileSaved = false;
    private bool showSavedToast = false;
    private string toastMessage = "Saved successfully";

    // Payments
    private bool acceptCash = true;
    private bool acceptCard = true;
    private bool acceptMobileWallet = true;

    // Add User Modal
    private bool showAddUserModal = false;
    private string newUserFullName = string.Empty;
    private string newUserEmail = string.Empty;
    private string newUserRole = "Kitchen";

    // Add Branch Modal
    private bool showAddOutletModal = false;
    private string newOutletName = string.Empty;
    private string newOutletType = "Cafe";
    private string newOutletAddress = string.Empty;
    private string newOutletPhone = string.Empty;
    private bool isCreatingBranch = false;

    // Branch Info Modal
    private bool showOutletInfoModal = false;
    private OutletSummary? selectedOutletSummary;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        try
        {
            branding = await BrandingService.GetBrandingAsync();

            // Load payments
            if (!string.IsNullOrWhiteSpace(branding.AcceptedPaymentMethods))
            {
                acceptCash = branding.AcceptedPaymentMethods.Contains("Cash");
                acceptCard = branding.AcceptedPaymentMethods.Contains("Card");
                acceptMobileWallet = branding.AcceptedPaymentMethods.Contains("MobileWallet");
            }

            categories = await MenuService.GetCategoriesAsync();
            archivedCategories = await MenuService.GetArchivedCategoriesAsync();
            users = await UserService.GetUsersAsync();
            outlets = await OutletService.GetOutletsAsync();
            await OutletService.InitializeActiveOutletAsync();
            OutletService.OnActiveOutletChanged += HandleBranchChanged;
        }
        catch { }
    }

    private async Task ShowToastNotification(string message)
    {
        toastMessage = message;
        showSavedToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        showSavedToast = false;
        StateHasChanged();
    }

    private async Task SaveBranding()
    {
        isSaving = true;
        isProfileSaved = false;
        try
        {
            await BrandingService.UpdateBrandingAsync(branding);
            isProfileSaved = true;
            _ = ShowToastNotification("Café profile saved successfully!");
            _ = Task.Run(async () =>
            {
                await Task.Delay(3500);
                isProfileSaved = false;
                await InvokeAsync(StateHasChanged);
            });
        }
        catch { }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SavePayments()
    {
        var list = new List<string>();
        if (acceptCash) list.Add("Cash");
        if (acceptCard) list.Add("Card");
        if (acceptMobileWallet) list.Add("MobileWallet");

        branding.AcceptedPaymentMethods = string.Join(",", list);
        await SaveBranding();
    }

    private async Task AddCategory()
    {
        if (!string.IsNullOrWhiteSpace(newCategoryName))
        {
            var name = newCategoryName.Trim();
            await MenuService.AddCategoryAsync(name);
            newCategoryName = string.Empty;
            categories = await MenuService.GetCategoriesAsync();
            _ = ShowToastNotification($"Category \"{name}\" added");
        }
    }

    private async Task ArchiveCategory(string cat)
    {
        await MenuService.DeleteCategoryAsync(cat);
        categories = await MenuService.GetCategoriesAsync();
        archivedCategories = await MenuService.GetArchivedCategoriesAsync();
        _ = ShowToastNotification($"Category \"{cat}\" moved to archive");
    }

    private async Task RestoreCategory(string cat)
    {
        await MenuService.RestoreCategoryAsync(cat);
        categories = await MenuService.GetCategoriesAsync();
        archivedCategories = await MenuService.GetArchivedCategoriesAsync();
        _ = ShowToastNotification($"Category \"{cat}\" restored to active menu");
    }

    private async Task PermanentlyDeleteCategory(string cat)
    {
        await MenuService.PermanentlyDeleteCategoryAsync(cat);
        archivedCategories = await MenuService.GetArchivedCategoriesAsync();
        _ = ShowToastNotification($"Category \"{cat}\" permanently deleted");
    }

    private async Task AddUser()
    {
        if (!string.IsNullOrWhiteSpace(newUserFullName) && !string.IsNullOrWhiteSpace(newUserEmail))
        {
            try
            {
                if (Enum.TryParse<Role>(newUserRole, out var role))
                {
                    await UserService.CreateUserAsync(new CreateUserRequestDto
                    {
                        FullName = newUserFullName.Trim(),
                        Email = newUserEmail.Trim(),
                        Password = "Password123!",
                        Role = role
                    });
                }
                showAddUserModal = false;
                newUserFullName = string.Empty;
                newUserEmail = string.Empty;
                users = await UserService.GetUsersAsync();
            }
            catch { }
        }
    }

    private string GetRoleBadgeClass(Role role) => role switch
    {
        Role.Admin => "bg-purple-500/15 text-purple-600",
        Role.Manager => "bg-blue-500/15 text-blue-600",
        Role.Kitchen => "bg-amber-500/15 text-amber-600",
        Role.Cashier => "bg-emerald-500/15 text-emerald-600",
        _ => "bg-line text-ink-muted"
    };

    private async Task CreateBranch()
    {
        if (string.IsNullOrWhiteSpace(newOutletName)) return;

        try
        {
            isCreatingBranch = true;
            Enum.TryParse<OutletType>(newOutletType, out var type);
            var created = await OutletService.CreateOutletAsync(newOutletName, type, newOutletAddress, newOutletPhone);
            showAddOutletModal = false;
            newOutletName = string.Empty;
            newOutletAddress = string.Empty;
            newOutletPhone = string.Empty;

            outlets = await OutletService.GetOutletsAsync();
            _ = ShowToastNotification($"Branch \"{created.Name}\" created!");
        }
        catch { }
        finally
        {
            isCreatingBranch = false;
        }
    }

    private async Task OpenBranchInfo(int outletId)
    {
        selectedOutletSummary = await OutletService.GetOutletSummaryAsync(outletId);
        showOutletInfoModal = true;
    }

    private async Task SwitchActiveBranch(int outletId)
    {
        await OutletService.SetActiveOutletAsync(outletId);
        var target = outlets.FirstOrDefault(o => o.Id == outletId);
        _ = ShowToastNotification($"Switched system to {target?.Name ?? "Branch"}");
    }

    private async Task MakeSelectedActive(int outletId)
    {
        await OutletService.SetActiveOutletAsync(outletId);
        showOutletInfoModal = false;
        var target = outlets.FirstOrDefault(o => o.Id == outletId);
        _ = ShowToastNotification($"Active branch set to {target?.Name ?? "Branch"}");
    }

    private async Task MakeSelectedActiveAndGo(string url)
    {
        if (selectedOutletSummary != null)
        {
            await OutletService.SetActiveOutletAsync(selectedOutletSummary.OutletId);
        }
        showOutletInfoModal = false;
        Navigation.NavigateTo(url);
    }

    private async Task HandleLogout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/welcome", forceLoad: true);
    }

    private async void HandleBranchChanged()
    {
        await InvokeAsync(async () =>
        {
            outlets = await OutletService.GetOutletsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        OutletService.OnActiveOutletChanged -= HandleBranchChanged;
    }
}
