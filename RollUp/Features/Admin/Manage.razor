                        <input type="text" @bind="newOutletPhone" placeholder="e.g. +1 (555) 019-2834"
                               class="w-full px-4 py-2.5 bg-bg border border-line rounded-xl text-xs sm:text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
                    </div>
                </div>

