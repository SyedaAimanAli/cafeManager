@page "/manage"
@using RollUp.Core.Interfaces
@using RollUp.Core.Models
@using RollUp.Features.Admin.Components
@inject IMenuService MenuService
@inject IOrderService OrderService
@implements IDisposable

<PageTitle>Menu Management - RollUp</PageTitle>

<div class="min-h-screen bg-stone-50 pb-20 md:pb-0">
    <AdminNavbar />

    <!-- Action Bar -->
    <div class="bg-white border-b border-stone-200">
        <div class="max-w-7xl mx-auto px-4 md:px-6 py-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-xl font-bold text-cafe-espresso">Menu Items</h1>
                    <p class="text-xs text-stone-500">Add, edit, pricing, and availability for your menu items</p>
                </div>

                <div class="flex flex-wrap items-center gap-2 md:gap-4">
                    <div class="relative flex-1 md:flex-none">
                        <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="Search menu..."
                               class="w-full md:w-64 pl-10 pr-4 py-2 bg-stone-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-cafe-caramel transition-all" />
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="h-4 w-4 text-stone-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>

                    <div class="hidden lg:flex items-center gap-2 px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-xl border border-emerald-100 text-xs font-semibold">
                        <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
                        <span>@ActiveOrdersCount Active Orders</span>
                    </div>

                    <button @onclick="OpenAddModal"
                            class="px-4 py-2 bg-cafe-espresso text-white text-sm font-semibold rounded-xl hover:bg-cafe-mocha transition-all shadow-sm flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>Add Item</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 md:px-6 py-6 md:py-8">
        <!-- Stats Cards - Horizontal Scroll on Mobile -->
        <div class="flex md:grid md:grid-cols-4 gap-4 md:gap-6 mb-8 overflow-x-auto pb-4 md:pb-0 scrollbar-hide">
            <div class="min-w-[200px] md:min-w-0 flex-1">
                <DashboardStatsCard Title="Total Items" Value="@AllItems.Count.ToString()" Subtitle="Active menu items"
                                    IconColorClass="text-cafe-caramel" ValueColorClass="text-cafe-espresso">
                    <IconPath>
                        <path
                        d="M5.566 4.657A4.505 4.505 0 016.75 4.5h10.5c.41 0 .806.055 1.183.157A3 3 0 0015.75 3h-7.5a3 3 0 00-2.684 1.657zM2.25 12a3 3 0 013-3h13.5a3 3 0 013 3v6a3 3 0 01-3 3H5.25a3 3 0 01-3-3v-6zM5.25 7.5c-.41 0-.806.055-1.184.157A3 3 0 016.75 6h10.5a3 3 0 012.683 1.657A4.505 4.505 0 0018.75 7.5H5.25z" />
                    </IconPath>
                </DashboardStatsCard>
            </div>
            <div class="min-w-[200px] md:min-w-0 flex-1">
                <DashboardStatsCard Title="Available" Value="@AllItems.Count(i => i.IsAvailable).ToString()"
                                    Subtitle="Ready to order" IconColorClass="text-emerald-500" ValueColorClass="text-emerald-600">
                    <IconPath>
                        <path fill-rule="evenodd"
                              d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z"
                              clip-rule="evenodd" />
                    </IconPath>
                </DashboardStatsCard>
            </div>
            <div class="min-w-[200px] md:min-w-0 flex-1">
                <DashboardStatsCard Title="Sold Out" Value="@AllItems.Count(i => !i.IsAvailable).ToString()"
                                    Subtitle="Currently off menu" IconColorClass="text-red-500" ValueColorClass="text-red-600">
                    <IconPath>
                        <path fill-rule="evenodd"
                              d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm-1.72 6.97a.75.75 0 10-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 101.06 1.06L12 13.06l1.72 1.72a.75.75 0 101.06-1.06L13.06 12l1.72-1.72a.75.75 0 10-1.06-1.06L12 10.94l-1.72-1.72z"
                              clip-rule="evenodd" />
                    </IconPath>
                </DashboardStatsCard>
            </div>
            <div class="min-w-[200px] md:min-w-0 flex-1">
                <DashboardStatsCard Title="Active Orders" Value="@ActiveOrdersCount.ToString()"
                                    Subtitle="Orders in queue" IconColorClass="text-blue-500" ValueColorClass="text-blue-600">
                    <IconPath>
                        <path fill-rule="evenodd"
                              d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z"
                              clip-rule="evenodd" />
                    </IconPath>
                </DashboardStatsCard>
            </div>
        </div>

        <!-- Category Filter - Horizontal Scroll on Mobile -->
        <div class="flex items-center gap-2 mb-6 overflow-x-auto pb-2 scrollbar-hide">
            <button @onclick="() => FilterCategory = string.Empty" class="@GetFilterClass(string.Empty)">
                All
            </button>
            @foreach (var category in Categories)
            {
                <button @onclick="() => FilterCategory = category" class="@GetFilterClass(category)">
                    @category
                </button>
            }
        </div>

        <!-- Menu Items List (Responsive) -->
        <div class="bg-white rounded-2xl shadow-sm border border-stone-200 overflow-hidden">
            <!-- Desktop View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead
                        class="bg-stone-50 border-b border-stone-200 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-6 py-4">Item</th>
                            <th class="px-6 py-4">Category</th>
                            <th class="px-6 py-4">Tags</th>
                            <th class="px-6 py-4">Price</th>
                            <th class="px-6 py-4">Status</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100">
                        @foreach (var item in FilteredItems)
                        {
                            <tr class="hover:bg-stone-50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-xl overflow-hidden flex-shrink-0">
                                            <img src="@item.ImageUrl" class="w-full h-full object-cover" />
                                        </div>
                                        <div>
                                            <p class="font-medium text-cafe-espresso">@item.Name</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-stone-600">@item.Category</td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var tag in item.Tags)
                                        {
                                            <span
                                            class="text-[10px] px-1.5 py-0.5 bg-stone-100 text-stone-500 rounded border border-stone-200">@tag</span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 font-semibold text-cafe-caramel">$@item.Price.ToString("F2")</td>
                                <td class="px-6 py-4">
                                    <button @onclick="() => ToggleAvailability(item.Id)"
                                            class="@GetStatusClass(item.IsAvailable)">
                                        <div
                                            class="w-1.5 h-1.5 rounded-full @(item.IsAvailable ? "bg-emerald-500" : "bg-red-500")">
                                        </div>
                                        @(item.IsAvailable ? "Available" : "Sold Out")
                                    </button>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button @onclick="() => TogglePopular(item)"
                                                class="@GetPopularButtonClass(item.IsPopular)">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20"
                                                 fill="currentColor">
                                                <path
                                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                            </svg>
                                        </button>
                                        <button @onclick="() => OpenEditModal(item)"
                                                class="p-2 text-stone-400 hover:text-blue-600 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                                 viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </button>
                                        <button @onclick="() => ConfirmDelete(item)"
                                                class="p-2 text-stone-400 hover:text-red-600 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                                 viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile View (Cards) -->
            <div class="md:hidden divide-y divide-stone-100">
                @foreach (var item in FilteredItems)
                {
                    <div class="p-4 flex flex-col gap-3 hover:bg-stone-50 transition-colors">
                        <div class="flex items-center gap-4">
                            <div class="w-16 h-16 rounded-xl overflow-hidden flex-shrink-0 bg-stone-100">
                                <img src="@item.ImageUrl" class="w-full h-full object-cover" />
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-start justify-between gap-2">
                                    <h3 class="font-semibold text-cafe-espresso truncate">@item.Name</h3>
                                    <span class="font-bold text-cafe-caramel">$@item.Price.ToString("F2")</span>
                                </div>
                                <p class="text-xs text-stone-500 mt-0.5">@item.Category</p>
                                <div class="flex flex-wrap gap-1 mt-2">
                                    @foreach (var tag in item.Tags.Take(3))
                                    {
                                        <span
                                        class="text-[10px] px-1.5 py-0.5 bg-stone-100 text-stone-600 rounded border border-stone-200">@tag</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center justify-between mt-2 pt-3 border-t border-stone-100">
                            <button @onclick="() => ToggleAvailability(item.Id)" class="@GetStatusClass(item.IsAvailable)">
                                <div class="w-1.5 h-1.5 rounded-full @(item.IsAvailable ? "bg-emerald-500" : "bg-red-500")">
                                </div>
                                <span class="text-xs uppercase tracking-wider font-bold">@(item.IsAvailable ? "Available" :
                                             "Sold Out")</span>
                                </button>
                                <div class="flex items-center gap-1">
                                    <button @onclick="() => TogglePopular(item)" class="@GetPopularButtonClass(item.IsPopular)">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20"
                                             fill="currentColor">
                                            <path
                                            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                    </button>
                                    <button @onclick="() => OpenEditModal(item)"
                                            class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                                             stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <button @onclick="() => ConfirmDelete(item)"
                                            class="p-2 text-red-600 hover:bg-red-50 rounded-lg">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                                             stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!FilteredItems.Any())
                {
                    <div class="flex flex-col items-center justify-center py-12 md:py-20 text-stone-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 md:h-16 md:w-16 mb-4" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <p class="text-lg font-medium">No items found</p>
                        <p class="text-sm">Try adjusting your search or filters</p>
                    </div>
                }
            </div>
        </main>

        <MenuItemFormModal @bind-IsOpen="ShowModal" Item="EditingItem" IsEditing="IsEditing" Categories="Categories"
                           OnSave="SaveItem" />

        <!-- Delete Confirmation -->
        @if (ShowDeleteConfirm && ItemToDelete != null)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
                <div class="absolute inset-0 bg-stone-900/60 backdrop-blur-sm" @onclick="CancelDelete"></div>
                <div class="relative bg-white rounded-3xl p-6 md:p-8 max-w-md w-full shadow-2xl">
                    <div class="w-16 h-16 bg-red-50 rounded-2xl flex items-center justify-center mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-cafe-espresso mb-2">Delete Item?</h3>
                    <p class="text-stone-500 mb-8 leading-relaxed">This will remove <span
                        class="font-semibold text-cafe-espresso">@ItemToDelete.Name</span> from your active menu. This
                        action can be undone later in the archive.</p>
                        <div class="flex gap-3">
                            <button @onclick="CancelDelete"
                                    class="flex-1 py-3 px-4 bg-stone-100 text-stone-600 font-semibold rounded-xl hover:bg-stone-200 transition-all">
                                Cancel
                            </button>
                            <button @onclick="DeleteItem"
                                    class="flex-1 py-3 px-4 bg-red-500 text-white font-semibold rounded-xl hover:bg-red-600 shadow-lg shadow-red-200 transition-all">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

@code {
    private List<MenuItem> AllItems = new();
    private string SearchTerm = string.Empty;
    private string FilterCategory = string.Empty;

    private List<MenuItem> FilteredItems => AllItems
            .Where(i => (string.IsNullOrEmpty(FilterCategory) || i.Category == FilterCategory) &&
                        (string.IsNullOrEmpty(SearchTerm) ||
                         i.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                         i.Category.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                         i.Tags.Any(t => t.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))))
            .ToList();

    private List<string> Categories = new();
    private bool ShowModal;
    private bool IsEditing;
    private MenuItem EditingItem = new();
    private bool ShowDeleteConfirm;
    private MenuItem? ItemToDelete;
    private int ActiveOrdersCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await UpdateActiveOrdersCount();
        OrderService.OnOrdersChanged += HandleOrdersChanged;
    }

    private async Task UpdateActiveOrdersCount()
    {
        ActiveOrdersCount = (await OrderService.GetActiveOrdersAsync()).Count;
    }

    private async void HandleOrdersChanged()
    {
        await InvokeAsync(async () =>
        {
            try
            {
                await UpdateActiveOrdersCount();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in HandleOrdersChanged: {ex.Message}");
            }
        });
    }

    private async Task LoadData()
    {
        AllItems = await MenuService.GetAllItemsAsync();
        Categories = await MenuService.GetCategoriesAsync();
    }

    private string GetFilterClass(string category)
    {
        var baseClass = "px-4 py-2 rounded-xl text-sm font-semibold transition-all flex-shrink-0 ";
        var isActive = category == FilterCategory || (string.IsNullOrEmpty(category) && string.IsNullOrEmpty(FilterCategory));
        return isActive
            ? baseClass + "bg-cafe-espresso text-white shadow-md shadow-stone-200"
            : baseClass + "bg-white text-stone-500 border border-stone-200 hover:border-cafe-caramel hover:text-cafe-caramel";
    }

    private string GetStatusClass(bool isAvailable)
    {
        var baseClass = "flex items-center gap-2 px-3 py-1.5 rounded-lg text-[10px] md:text-xs font-bold transition-all ";
        return isAvailable
            ? baseClass + "bg-emerald-50 text-emerald-600 border border-emerald-100"
            : baseClass + "bg-red-50 text-red-600 border border-red-100";
    }

    private string GetPopularButtonClass(bool isPopular)
    {
        var baseClass = "p-2 rounded-xl transition-all ";
        return isPopular
            ? baseClass + "text-amber-500 bg-amber-50"
            : baseClass + "text-stone-300 hover:text-amber-500 hover:bg-stone-50";
    }

    private async Task ToggleAvailability(int id)
    {
        await MenuService.ToggleAvailabilityAsync(id);
        await LoadData();
    }

    private async Task TogglePopular(MenuItem item)
    {
        item.IsPopular = !item.IsPopular;
        await MenuService.UpdateItemAsync(item);
        await LoadData();
    }

    private void OpenAddModal()
    {
        IsEditing = false;
        EditingItem = new MenuItem
        {
            IsAvailable = true,
            Category = Categories.FirstOrDefault() ?? "General"
        };
        ShowModal = true;
    }

    private void OpenEditModal(MenuItem item)
    {
        IsEditing = true;
        EditingItem = new MenuItem
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            Price = item.Price,
            Category = item.Category,
            ImageUrl = item.ImageUrl,
            IsAvailable = item.IsAvailable,
            IsPopular = item.IsPopular,
            Tags = new List<string>(item.Tags),
            Variants = item.Variants.ToList(),
            Addons = item.Addons.ToList()
        };
        ShowModal = true;
    }

    private async Task SaveItem(MenuItem item)
    {
        if (IsEditing) await MenuService.UpdateItemAsync(item);
        else await MenuService.AddItemAsync(item);
        await LoadData();
    }

    private void ConfirmDelete(MenuItem item)
    {
        ItemToDelete = item;
        ShowDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        ItemToDelete = null;
        ShowDeleteConfirm = false;
    }

    private async Task DeleteItem()
    {
        if (ItemToDelete != null)
        {
            await MenuService.DeleteItemAsync(ItemToDelete.Id);
            await LoadData();
        }
        CancelDelete();
    }

    public void Dispose() => OrderService.OnOrdersChanged -= HandleOrdersChanged;
}
