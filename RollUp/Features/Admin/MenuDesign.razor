@page "/manage/design"
@using RollUp.Core.Interfaces
@using RollUp.Core.Models
@using RollUp.Application.DTOs
@inject IBrandingService BrandingService
@inject IMenuService MenuService
@inject NavigationManager Navigation

<PageTitle>Menu Design & Branding Studio - RollUp</PageTitle>

<div class="min-h-screen bg-stone-50 pb-20 md:pb-0">
    <AdminNavbar />

    <!-- Action Bar -->
    <div class="bg-white border-b border-stone-200">
        <div class="max-w-7xl mx-auto px-4 md:px-6 py-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-xl font-bold text-cafe-espresso">Menu Design & Branding Studio</h1>
                    <p class="text-xs text-stone-500">Customize templates, color schemes, fonts, and live menu presentation</p>
                </div>

                <div class="flex items-center gap-3">
                    @if (isSaved)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                            Saved successfully!
                        </span>
                    }

                    <button @onclick="SaveBranding" disabled="@isSaving"
                            class="px-5 py-2.5 bg-cafe-espresso text-white text-sm font-semibold rounded-xl hover:bg-cafe-mocha transition-all shadow-sm flex items-center gap-2 disabled:opacity-50">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                        </svg>
                        <span>@(isSaving ? "Saving..." : "Save Branding")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 md:px-6 py-6 md:py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Controls Column -->
            <div class="lg:col-span-7 space-y-6">
                
                <!-- 1. Theme Templates -->
                <div class="bg-white rounded-3xl p-6 md:p-7 border border-stone-200 shadow-xs space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="font-bold text-stone-800 text-base">1. Menu Template Style</h2>
                            <p class="text-xs text-stone-500">Select the visual personality for your customer menu</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Bistro Classic -->
                        <div @onclick='() => SetTemplate("bistro")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.ThemeTemplate == "bistro" ? "border-amber-700 bg-amber-50/50 shadow-xs" : "border-stone-200 hover:border-stone-300 bg-white")">
                            <div class="w-full h-16 rounded-xl bg-gradient-to-br from-stone-800 to-amber-900 flex items-center justify-center text-white mb-3 shadow-inner">
                                <span class="font-display font-bold text-sm tracking-wider">Bistro</span>
                            </div>
                            <div class="font-bold text-xs text-stone-800">Bistro Classic</div>
                            <div class="text-[11px] text-stone-500 mt-0.5">Warm, elegant serif cafe</div>
                        </div>

                        <!-- Modern Minimalist -->
                        <div @onclick='() => SetTemplate("minimal")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.ThemeTemplate == "minimal" ? "border-stone-900 bg-stone-50 shadow-xs" : "border-stone-200 hover:border-stone-300 bg-white")">
                            <div class="w-full h-16 rounded-xl bg-stone-900 flex items-center justify-center text-white mb-3 shadow-inner">
                                <span class="font-sans font-semibold text-xs uppercase tracking-widest">Minimal</span>
                            </div>
                            <div class="font-bold text-xs text-stone-800">Modern Minimal</div>
                            <div class="text-[11px] text-stone-500 mt-0.5">Clean high-contrast grid</div>
                        </div>

                        <!-- Dark Velvet -->
                        <div @onclick='() => SetTemplate("dark-velvet")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.ThemeTemplate == "dark-velvet" ? "border-purple-800 bg-purple-50/50 shadow-xs" : "border-stone-200 hover:border-stone-300 bg-white")">
                            <div class="w-full h-16 rounded-xl bg-gradient-to-br from-slate-950 via-purple-950 to-stone-900 flex items-center justify-center text-amber-300 mb-3 shadow-inner">
                                <span class="font-cinzel font-bold text-xs tracking-widest">VELVET</span>
                            </div>
                            <div class="font-bold text-xs text-stone-800">Dark Velvet</div>
                            <div class="text-[11px] text-stone-500 mt-0.5">Moody luxury night lounge</div>
                        </div>

                        <!-- Artisan Rustic -->
                        <div @onclick='() => SetTemplate("artisan")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.ThemeTemplate == "artisan" ? "border-orange-700 bg-orange-50/50 shadow-xs" : "border-stone-200 hover:border-stone-300 bg-white")">
                            <div class="w-full h-16 rounded-xl bg-gradient-to-br from-stone-800 to-orange-800 flex items-center justify-center text-amber-100 mb-3 shadow-inner">
                                <span class="font-serif italic font-bold text-sm">Artisan</span>
                            </div>
                            <div class="font-bold text-xs text-stone-800">Artisan Rustic</div>
                            <div class="text-[11px] text-stone-500 mt-0.5">Earth & bakery craft</div>
                        </div>

                        <!-- Vibrant Emerald -->
                        <div @onclick='() => SetTemplate("emerald")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.ThemeTemplate == "emerald" ? "border-emerald-700 bg-emerald-50/50 shadow-xs" : "border-stone-200 hover:border-stone-300 bg-white")">
                            <div class="w-full h-16 rounded-xl bg-gradient-to-br from-emerald-950 to-teal-800 flex items-center justify-center text-emerald-200 mb-3 shadow-inner">
                                <span class="font-poppins font-bold text-xs tracking-wider">MATCHA</span>
                            </div>
                            <div class="font-bold text-xs text-stone-800">Botanical Matcha</div>
                            <div class="text-[11px] text-stone-500 mt-0.5">Fresh organic greenery</div>
                        </div>

                        <!-- Amber Luxe -->
                        <div @onclick='() => SetTemplate("amber")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.ThemeTemplate == "amber" ? "border-amber-600 bg-amber-50/50 shadow-xs" : "border-stone-200 hover:border-stone-300 bg-white")">
                            <div class="w-full h-16 rounded-xl bg-gradient-to-br from-amber-900 to-yellow-700 flex items-center justify-center text-amber-100 mb-3 shadow-inner">
                                <span class="font-display font-bold text-xs tracking-widest">AMBER</span>
                            </div>
                            <div class="font-bold text-xs text-stone-800">Amber Luxe</div>
                            <div class="text-[11px] text-stone-500 mt-0.5">Warm honey & espresso</div>
                        </div>
                    </div>
                </div>

                <!-- 2. Color Schemes -->
                <div class="bg-white rounded-3xl p-6 md:p-7 border border-stone-200 shadow-xs space-y-4">
                    <div>
                        <h2 class="font-bold text-stone-800 text-base">2. Color Palette</h2>
                        <p class="text-xs text-stone-500">Pick a cohesive palette for buttons, badges, prices, and backgrounds</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Warm Espresso -->
                        <div @onclick='() => SetColorScheme("espresso")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex items-center justify-between @(branding.ColorScheme == "espresso" ? "border-amber-800 bg-amber-50/40" : "border-stone-200 hover:border-stone-300")">
                            <div>
                                <div class="font-bold text-xs text-stone-800">Warm Espresso & Latte</div>
                                <div class="text-[11px] text-stone-500">Coffee, caramel & cream</div>
                            </div>
                            <div class="flex items-center -space-x-1.5">
                                <span class="w-6 h-6 rounded-full bg-[#3D2314] ring-2 ring-white"></span>
                                <span class="w-6 h-6 rounded-full bg-[#C4956A] ring-2 ring-white"></span>
                                <span class="w-6 h-6 rounded-full bg-[#FDF6E9] ring-2 ring-white border border-stone-300"></span>
                            </div>
                        </div>

                        <!-- Matcha Green -->
                        <div @onclick='() => SetColorScheme("matcha")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex items-center justify-between @(branding.ColorScheme == "matcha" ? "border-emerald-800 bg-emerald-50/40" : "border-stone-200 hover:border-stone-300")">
                            <div>
                                <div class="font-bold text-xs text-stone-800">Matcha & Forest</div>
                                <div class="text-[11px] text-stone-500">Forest green, sage & mint</div>
                            </div>
                            <div class="flex items-center -space-x-1.5">
                                <span class="w-6 h-6 rounded-full bg-[#1E3A2F] ring-2 ring-white"></span>
                                <span class="w-6 h-6 rounded-full bg-[#10B981] ring-2 ring-white"></span>
                                <span class="w-6 h-6 rounded-full bg-[#ECFDF5] ring-2 ring-white border border-stone-300"></span>
                            </div>
                        </div>

                        <!-- Royal Berry -->
                        <div @onclick='() => SetColorScheme("royal-plum")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex items-center justify-between @(branding.ColorScheme == "royal-plum" ? "border-purple-800 bg-purple-50/40" : "border-stone-200 hover:border-stone-300")">
                            <div>
                                <div class="font-bold text-xs text-stone-800">Royal Plum & Rose</div>
                                <div class="text-[11px] text-stone-500">Deep wine, rose & blush</div>
                            </div>
                            <div class="flex items-center -space-x-1.5">
                                <span class="w-6 h-6 rounded-full bg-[#3B1F2B] ring-2 ring-white"></span>
                                <span class="w-6 h-6 rounded-full bg-[#DB2777] ring-2 ring-white"></span>
                                <span class="w-6 h-6 rounded-full bg-[#FDF2F8] ring-2 ring-white border border-stone-300"></span>
                            </div>
                        </div>

                        <!-- Midnight Slate -->
                        <div @onclick='() => SetColorScheme("midnight")'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all flex items-center justify-between @(branding.ColorScheme == "midnight" ? "border-slate-800 bg-slate-50" : "border-stone-200 hover:border-stone-300")">
                            <div>
                                <div class="font-bold text-xs text-stone-800">Midnight Slate & Gold</div>
                                <div class="text-[11px] text-stone-500">Charcoal, amber & silver</div>
                            </div>
                            <div class="flex items-center -space-x-1.5">
                                <span class="w-6 h-6 rounded-full bg-[#0F172A] ring-2 ring-white"></span>
                                <span class="w-6 h-6 rounded-full bg-[#F59E0B] ring-2 ring-white"></span>
                                <span class="w-6 h-6 rounded-full bg-[#F8FAFC] ring-2 ring-white border border-stone-300"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Typography Styles -->
                <div class="bg-white rounded-3xl p-6 md:p-7 border border-stone-200 shadow-xs space-y-4">
                    <div>
                        <h2 class="font-bold text-stone-800 text-base">3. Typography & Font Pairing</h2>
                        <p class="text-xs text-stone-500">Choose heading and body font pairing for your menu</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div @onclick='() => branding.FontFamily = "inter"'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.FontFamily == "inter" ? "border-amber-800 bg-amber-50/40" : "border-stone-200 hover:border-stone-300")">
                            <div class="font-sans font-bold text-sm text-stone-900">Modern Sans (Inter)</div>
                            <div class="text-xs text-stone-500 mt-1">Crisp, highly legible digital typography</div>
                        </div>

                        <div @onclick='() => branding.FontFamily = "playfair"'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.FontFamily == "playfair" ? "border-amber-800 bg-amber-50/40" : "border-stone-200 hover:border-stone-300")">
                            <div class="font-display font-bold text-sm text-stone-900">Artisan Serif (Playfair)</div>
                            <div class="text-xs text-stone-500 mt-1">Classic coffeehouse & bistro elegance</div>
                        </div>

                        <div @onclick='() => branding.FontFamily = "poppins"'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.FontFamily == "poppins" ? "border-amber-800 bg-amber-50/40" : "border-stone-200 hover:border-stone-300")">
                            <div class="font-poppins font-bold text-sm text-stone-900">Geometric (Poppins)</div>
                            <div class="text-xs text-stone-500 mt-1">Clean, friendly, modern casual aesthetic</div>
                        </div>

                        <div @onclick='() => branding.FontFamily = "cinzel"'
                             class="p-4 rounded-2xl border-2 cursor-pointer transition-all @(branding.FontFamily == "cinzel" ? "border-amber-800 bg-amber-50/40" : "border-stone-200 hover:border-stone-300")">
                            <div class="font-cinzel font-bold text-sm text-stone-900">Cinzel & Cormorant</div>
                            <div class="text-xs text-stone-500 mt-1">Gourmet fine dining & luxury roasters</div>
                        </div>
                    </div>
                </div>

                <!-- 4. Business Identity Information -->
                <div class="bg-white rounded-3xl p-6 md:p-7 border border-stone-200 shadow-xs space-y-4">
                    <div>
                        <h2 class="font-bold text-stone-800 text-base">4. Business Header & Details</h2>
                        <p class="text-xs text-stone-500">Details printed on physical menus, QR cards, and digital headers</p>
                    </div>

                    <div class="space-y-4 text-sm">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block font-semibold text-stone-700 mb-1">Business Name</label>
                                <input type="text" @bind="branding.BusinessName" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
                            </div>
                            <div>
                                <label class="block font-semibold text-stone-700 mb-1">Tagline</label>
                                <input type="text" @bind="branding.Tagline" placeholder="e.g. Artisan Specialty Coffee" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block font-semibold text-stone-700 mb-1">Currency Code</label>
                                <input type="text" @bind="branding.Currency" placeholder="USD / EUR / GBP" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none uppercase" />
                            </div>
                            <div>
                                <label class="block font-semibold text-stone-700 mb-1">Contact Phone</label>
                                <input type="text" @bind="branding.ContactPhone" placeholder="+1 (555) 019-2834" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
                            </div>
                            <div>
                                <label class="block font-semibold text-stone-700 mb-1">Contact Email</label>
                                <input type="text" @bind="branding.ContactEmail" placeholder="hello@rollup.com" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
                            </div>
                        </div>

                        <div>
                            <label class="block font-semibold text-stone-700 mb-1">Physical Address</label>
                            <input type="text" @bind="branding.Address" placeholder="124 Roaster Blvd, Downtown" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Live Interactive Device Preview -->
            <div class="lg:col-span-5 sticky top-24 space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-stone-500">Live Customer Menu Preview</span>
                    <a href="/menu" target="_blank" class="text-xs font-semibold text-cafe-caramel hover:underline flex items-center gap-1">
                        <span>Open full menu</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                </div>

                <!-- Phone Frame Preview Mockup -->
                <div class="mx-auto w-full max-w-[360px] rounded-[40px] border-8 border-stone-800 bg-stone-800 p-2 shadow-2xl">
                    <div class="rounded-[30px] overflow-hidden min-h-[580px] max-h-[640px] overflow-y-auto scrollbar-hide text-stone-800 @GetPreviewThemeClass()">
                        
                        <!-- Header inside preview -->
                        <div class="p-4 border-b @GetPreviewHeaderBorder()">
                            <div class="text-center space-y-1">
                                <h3 class="text-lg font-bold @GetFontClass()">@(string.IsNullOrWhiteSpace(branding.BusinessName) ? "RollUp Cafe" : branding.BusinessName)</h3>
                                <p class="text-[11px] opacity-75">@(string.IsNullOrWhiteSpace(branding.Tagline) ? "Artisan Coffee & Kitchen" : branding.Tagline)</p>
                            </div>

                            <!-- Category Badges Mock -->
                            <div class="flex gap-2 overflow-x-auto mt-4 pb-1 scrollbar-hide">
                                <span class="px-3 py-1 rounded-full text-xs font-semibold shrink-0 @GetActiveCategoryBadgeClass()">All Items</span>
                                <span class="px-3 py-1 rounded-full text-xs font-semibold shrink-0 @GetInactiveCategoryBadgeClass()">Hot Coffee</span>
                                <span class="px-3 py-1 rounded-full text-xs font-semibold shrink-0 @GetInactiveCategoryBadgeClass()">Cold Brews</span>
                                <span class="px-3 py-1 rounded-full text-xs font-semibold shrink-0 @GetInactiveCategoryBadgeClass()">Bakery</span>
                            </div>
                        </div>

                        <!-- Sample Items in Preview -->
                        <div class="p-4 space-y-3">
                            <div class="p-3 rounded-2xl border flex gap-3 items-center @GetItemCardClass()">
                                <div class="w-14 h-14 rounded-xl bg-amber-900/20 flex items-center justify-center text-xl shrink-0">
                                    ☕
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-bold text-xs truncate">Caramel Macchiato</div>
                                    <div class="text-[10px] opacity-70 line-clamp-1">Steamed milk, vanilla syrup, espresso & caramel drizzle</div>
                                    <div class="font-bold text-xs mt-1 @GetPriceColorClass()">@branding.Currency 4.95</div>
                                </div>
                                <button class="p-1.5 rounded-lg text-xs font-bold shrink-0 @GetActionButtonClass()">
                                    +
                                </button>
                            </div>

                            <div class="p-3 rounded-2xl border flex gap-3 items-center @GetItemCardClass()">
                                <div class="w-14 h-14 rounded-xl bg-amber-900/20 flex items-center justify-center text-xl shrink-0">
                                    🥐
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-bold text-xs truncate">Almond Butter Croissant</div>
                                    <div class="text-[10px] opacity-70 line-clamp-1">Flaky French pastry filled with almond frangipane</div>
                                    <div class="font-bold text-xs mt-1 @GetPriceColorClass()">@branding.Currency 3.75</div>
                                </div>
                                <button class="p-1.5 rounded-lg text-xs font-bold shrink-0 @GetActionButtonClass()">
                                    +
                                </button>
                            </div>

                            <div class="p-3 rounded-2xl border flex gap-3 items-center @GetItemCardClass()">
                                <div class="w-14 h-14 rounded-xl bg-amber-900/20 flex items-center justify-center text-xl shrink-0">
                                    🧊
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-bold text-xs truncate">Nitro Cold Brew</div>
                                    <div class="text-[10px] opacity-70 line-clamp-1">Slow steeped 24hr single-origin infused with nitrogen</div>
                                    <div class="font-bold text-xs mt-1 @GetPriceColorClass()">@branding.Currency 5.25</div>
                                </div>
                                <button class="p-1.5 rounded-lg text-xs font-bold shrink-0 @GetActionButtonClass()">
                                    +
                                </button>
                            </div>
                        </div>

                        <!-- Footer Cart Button in Preview -->
                        <div class="p-4 border-t @GetPreviewHeaderBorder()">
                            <div class="w-full py-2.5 rounded-xl font-bold text-xs text-center shadow-sm @GetCartButtonClass()">
                                View Order (3 items) • @branding.Currency 13.95
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    private TenantBrandingDto branding = new();
    private bool isSaving = false;
    private bool isSaved = false;

    protected override async Task OnInitializedAsync()
    {
        branding = await BrandingService.GetBrandingAsync();
    }

    private void SetTemplate(string template)
    {
        branding.ThemeTemplate = template;
        isSaved = false;
    }

    private void SetColorScheme(string scheme)
    {
        branding.ColorScheme = scheme;
        isSaved = false;
    }

    private async Task SaveBranding()
    {
        isSaving = true;
        isSaved = false;
        try
        {
            var success = await BrandingService.UpdateBrandingAsync(branding);
            if (success)
            {
                isSaved = true;
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetFontClass() => branding.FontFamily switch
    {
        "playfair" => "font-display",
        "poppins" => "font-poppins",
        "cinzel" => "font-cinzel",
        _ => "font-sans"
    };

    private string GetPreviewThemeClass()
    {
        if (branding.ThemeTemplate == "dark-velvet")
        {
            return "bg-slate-950 text-stone-100";
        }
        if (branding.ThemeTemplate == "emerald")
        {
            return "bg-emerald-950/95 text-stone-100";
        }
        if (branding.ThemeTemplate == "minimal")
        {
            return "bg-white text-stone-900";
        }
        if (branding.ThemeTemplate == "amber")
        {
            return "bg-amber-50/90 text-stone-900";
        }
        // bistro default
        return "bg-[#FDF6E9] text-stone-900";
    }

    private string GetPreviewHeaderBorder()
    {
        if (branding.ThemeTemplate == "dark-velvet" || branding.ThemeTemplate == "emerald")
            return "border-white/10";
        return "border-stone-200/60";
    }

    private string GetItemCardClass()
    {
        if (branding.ThemeTemplate == "dark-velvet")
            return "bg-white/5 border-white/10 text-stone-100";
        if (branding.ThemeTemplate == "emerald")
            return "bg-white/10 border-white/15 text-stone-100";
        if (branding.ThemeTemplate == "minimal")
            return "bg-white border-stone-200 shadow-2xs";
        return "bg-white/80 border-amber-900/10 shadow-2xs";
    }

    private string GetActiveCategoryBadgeClass() => branding.ColorScheme switch
    {
        "matcha" => "bg-emerald-700 text-white",
        "royal-plum" => "bg-pink-700 text-white",
        "midnight" => "bg-amber-500 text-slate-950 font-bold",
        _ => "bg-[#3D2314] text-white"
    };

    private string GetInactiveCategoryBadgeClass()
    {
        if (branding.ThemeTemplate == "dark-velvet" || branding.ThemeTemplate == "emerald")
            return "bg-white/10 text-stone-300";
        return "bg-stone-100 text-stone-600";
    }

    private string GetPriceColorClass() => branding.ColorScheme switch
    {
        "matcha" => "text-emerald-500",
        "royal-plum" => "text-pink-500",
        "midnight" => "text-amber-400",
        _ => "text-amber-700"
    };

    private string GetActionButtonClass() => branding.ColorScheme switch
    {
        "matcha" => "bg-emerald-600 text-white hover:bg-emerald-700",
        "royal-plum" => "bg-pink-600 text-white hover:bg-pink-700",
        "midnight" => "bg-amber-500 text-slate-950 hover:bg-amber-400",
        _ => "bg-[#3D2314] text-white hover:bg-[#6B4423]"
    };

    private string GetCartButtonClass() => branding.ColorScheme switch
    {
        "matcha" => "bg-emerald-600 text-white",
        "royal-plum" => "bg-pink-600 text-white",
        "midnight" => "bg-amber-500 text-slate-950 font-extrabold",
        _ => "bg-[#3D2314] text-white"
    };
}
