@page "/manage/categories"
@using RollUp.Core.Interfaces
@inject IMenuService MenuService
@inject NavigationManager Navigation

<PageTitle>Category Management - RollUp</PageTitle>

<div class="min-h-screen bg-stone-50 pb-20 md:pb-0">
    <AdminNavbar />

    <!-- Action Bar -->
    <div class="bg-white border-b border-stone-200">
        <div class="max-w-4xl mx-auto px-4 md:px-6 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-xl font-bold text-cafe-espresso">Categories</h1>
                    <p class="text-xs text-stone-500">Organize and sort your menu categories</p>
                </div>
            </div>
        </div>
    </div>

    <main class="max-w-3xl mx-auto px-4 md:px-6 py-6 md:py-8">
        <!-- Add Category Form -->
        <div class="bg-white rounded-3xl shadow-sm border border-stone-200 p-6 md:p-8 mb-8">
            <h3 class="text-sm font-bold text-stone-400 uppercase tracking-widest mb-6">Create New Category</h3>
            <div class="flex flex-col md:flex-row gap-4">
                <input @bind="NewCategoryName" 
                       @onkeyup="HandleKeyUp"
                       placeholder="e.g., Seasonal Specials"
                       class="flex-1 px-5 py-3 bg-stone-50 border-none rounded-2xl focus:ring-2 focus:ring-cafe-caramel transition-all" />
                <button @onclick="AddCategory"
                        disabled="@(string.IsNullOrWhiteSpace(NewCategoryName))"
                        class="px-8 py-3 bg-cafe-espresso text-white font-bold rounded-2xl hover:bg-cafe-mocha transition-all disabled:opacity-50 shadow-lg shadow-stone-200">
                    Add Category
                </button>
            </div>
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="flex items-center gap-2 mt-4 text-red-500 text-sm bg-red-50 p-3 rounded-xl border border-red-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    @ErrorMessage
                </div>
            }
        </div>

        <!-- Categories List -->
        <div class="bg-white rounded-3xl shadow-sm border border-stone-200 overflow-hidden">
            <div class="px-6 md:px-8 py-5 border-b border-stone-100 bg-stone-50/50">
                <h3 class="text-sm font-bold text-stone-400 uppercase tracking-widest">Active Categories (@Categories.Count)</h3>
            </div>
            <div class="divide-y divide-stone-100">
                @if (Categories.Any())
                {
                    @foreach (var category in Categories)
                    {
                        <div class="px-6 md:px-8 py-5 flex items-center justify-between group hover:bg-stone-50 transition-all">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 bg-cafe-cream rounded-xl flex items-center justify-center text-cafe-mocha shadow-inner">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                    </svg>
                                </div>
                                <span class="font-bold text-cafe-espresso">@category</span>
                            </div>
                            <button @onclick="() => ConfirmDelete(category)"
                                    class="p-3 text-stone-300 hover:text-red-500 hover:bg-red-50 rounded-xl transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="px-6 py-16 text-center text-stone-400">
                        <div class="w-16 h-16 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                            </svg>
                        </div>
                        <p class="text-lg font-medium">No categories found</p>
                        <p class="text-sm">Start by adding your first category above.</p>
                    </div>
                }
            </div>
        </div>
    </main>

    <!-- Delete Confirmation Modal -->
    @if (ShowDeleteConfirm)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-stone-900/60 backdrop-blur-sm" @onclick="() => ShowDeleteConfirm = false"></div>
            <div class="relative bg-white rounded-3xl p-6 md:p-8 max-w-md w-full shadow-2xl">
                <div class="w-16 h-16 bg-red-50 rounded-2xl flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-cafe-espresso mb-2">Delete Category?</h3>
                <p class="text-stone-500 mb-8 leading-relaxed">Deleting <span class="font-bold text-cafe-espresso">@CategoryToDelete</span> will hide it from the menu. Existing items in this category will remain safe but will need a new category assigned.</p>
                <div class="flex gap-3">
                    <button @onclick="() => ShowDeleteConfirm = false" class="flex-1 py-3 px-4 bg-stone-100 text-stone-600 font-semibold rounded-xl hover:bg-stone-200 transition-all">
                        Cancel
                    </button>
                    <button @onclick="DeleteCategory" class="flex-1 py-3 px-4 bg-red-500 text-white font-semibold rounded-xl hover:bg-red-600 shadow-lg shadow-red-200 transition-all">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<string> Categories = new();
    private string NewCategoryName = string.Empty;
    private string ErrorMessage = string.Empty;
    private bool ShowDeleteConfirm;
    private string CategoryToDelete = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        Categories = await MenuService.GetCategoriesAsync();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddCategory();
    }

    private async Task AddCategory()
    {
        if (string.IsNullOrWhiteSpace(NewCategoryName)) return;

        if (Categories.Contains(NewCategoryName, StringComparer.OrdinalIgnoreCase))
        {
            ErrorMessage = "This category already exists.";
            return;
        }

        ErrorMessage = string.Empty;
        await MenuService.AddCategoryAsync(NewCategoryName);
        NewCategoryName = string.Empty;
        await LoadCategories();
    }

    private void ConfirmDelete(string category)
    {
        CategoryToDelete = category;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteCategory()
    {
        await MenuService.DeleteCategoryAsync(CategoryToDelete);
        ShowDeleteConfirm = false;
        await LoadCategories();
    }
}
