@page "/manage/reports"
@using RollUp.Core.Interfaces
@using RollUp.Application.DTOs
@using System.Globalization
@inject IReportService ReportService
@inject IBrandingService BrandingService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Sales & Order Reports - RollUp</PageTitle>

<div class="min-h-screen bg-stone-50 pb-20 md:pb-12 print:bg-white print:pb-0">
    <AdminNavbar />

    <!-- Action & Timeframe Filter Bar -->
    <div class="bg-white border-b border-stone-200 no-print sticky top-16 z-30 shadow-2xs">
        <div class="max-w-7xl mx-auto px-4 md:px-6 py-4">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div>
                    <h1 class="text-xl font-bold text-cafe-espresso flex items-center gap-2">
                        <span>📊</span>
                        <span>Sales & Order Reports</span>
                    </h1>
                    <p class="text-xs text-stone-500">Revenue trajectory, product performance, category distribution & peak rush traffic</p>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <!-- Timeframe Pills -->
                    <div class="flex items-center bg-stone-100 p-1 rounded-2xl border border-stone-200 text-xs font-semibold">
                        <button @onclick='() => ChangeTimeframe("today")'
                                class="px-3.5 py-1.5 rounded-xl transition-all @(selectedTimeframe == "today" ? "bg-white text-stone-900 shadow-xs font-bold" : "text-stone-600 hover:text-stone-900")">
                            Today
                        </button>
                        <button @onclick='() => ChangeTimeframe("7days")'
                                class="px-3.5 py-1.5 rounded-xl transition-all @(selectedTimeframe == "7days" ? "bg-white text-stone-900 shadow-xs font-bold" : "text-stone-600 hover:text-stone-900")">
                            Last 7 Days
                        </button>
                        <button @onclick='() => ChangeTimeframe("30days")'
                                class="px-3.5 py-1.5 rounded-xl transition-all @(selectedTimeframe == "30days" ? "bg-white text-stone-900 shadow-xs font-bold" : "text-stone-600 hover:text-stone-900")">
                            Last 30 Days
                        </button>
                        <button @onclick='() => ChangeTimeframe("all")'
                                class="px-3.5 py-1.5 rounded-xl transition-all @(selectedTimeframe == "all" ? "bg-white text-stone-900 shadow-xs font-bold" : "text-stone-600 hover:text-stone-900")">
                            All Time
                        </button>
                    </div>

                    <!-- Print / Export Action -->
                    <button @onclick="TriggerPrint"
                            class="px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-semibold rounded-xl transition-all flex items-center gap-1.5 border border-stone-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-stone-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                        </svg>
                        <span>Print Report</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="max-w-7xl mx-auto px-4 md:px-6 py-6 md:py-8 space-y-8">
        
        @if (isLoading)
        {
            <div class="py-24 text-center text-stone-400">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-2 border-amber-800 border-t-transparent mb-2"></div>
                <p class="text-sm">Calculating sales and aggregating reports...</p>
            </div>
        }
        else
        {
            <!-- 1. Key Performance Metric KPI Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
                
                <!-- KPI 1: Gross Sales -->
                <div class="bg-white rounded-3xl p-6 border border-stone-200/80 shadow-xs relative overflow-hidden">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-stone-500 uppercase tracking-wider">Gross Revenue</span>
                        <div class="w-9 h-9 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-base">
                            💰
                        </div>
                    </div>
                    <div class="text-3xl font-extrabold text-stone-900 tracking-tight">
                        @branding.Currency @report.TotalRevenue.ToString("N2")
                    </div>
                    <div class="flex items-center gap-2 mt-2 text-xs text-stone-500">
                        <span>Avg Order:</span>
                        <strong class="text-stone-700 font-semibold">@branding.Currency @report.AverageOrderValue.ToString("N2")</strong>
                    </div>
                </div>

                <!-- KPI 2: Total Orders -->
                <div class="bg-white rounded-3xl p-6 border border-stone-200/80 shadow-xs relative overflow-hidden">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-stone-500 uppercase tracking-wider">Total Orders</span>
                        <div class="w-9 h-9 rounded-2xl bg-blue-100 text-blue-800 flex items-center justify-center text-base">
                            📦
                        </div>
                    </div>
                    <div class="text-3xl font-extrabold text-stone-900 tracking-tight">
                        @report.TotalOrders
                    </div>
                    <div class="flex items-center gap-2 mt-2 text-xs text-stone-500">
                        <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-medium border border-blue-100">🍽️ @report.DineInCount Dine-In</span>
                        <span class="px-2 py-0.5 rounded-full bg-stone-100 text-stone-700 font-medium">🛍️ @report.TakeawayCount Takeaway</span>
                    </div>
                </div>

                <!-- KPI 3: Top Selling Item -->
                <div class="bg-white rounded-3xl p-6 border border-stone-200/80 shadow-xs relative overflow-hidden">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-stone-500 uppercase tracking-wider">Top Selling Product</span>
                        <div class="w-9 h-9 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-base">
                            🥐
                        </div>
                    </div>
                    <div class="text-lg font-bold text-stone-900 truncate" title="@report.TopSellingItemName">
                        @report.TopSellingItemName
                    </div>
                    <div class="flex items-center gap-2 mt-2 text-xs text-emerald-700 font-semibold">
                        <span>@report.TopSellingItemUnits units sold</span>
                        <span>•</span>
                        <span>@branding.Currency @report.TopSellingItemRevenue.ToString("N2")</span>
                    </div>
                </div>

                <!-- KPI 4: Completion Rate -->
                <div class="bg-white rounded-3xl p-6 border border-stone-200/80 shadow-xs relative overflow-hidden">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-stone-500 uppercase tracking-wider">Order Status</span>
                        <div class="w-9 h-9 rounded-2xl bg-purple-100 text-purple-800 flex items-center justify-center text-base">
                            ⚡
                        </div>
                    </div>
                    <div class="text-3xl font-extrabold text-stone-900 tracking-tight">
                        @(report.TotalOrders > 0 ? ((double)report.CompletedOrders / report.TotalOrders * 100).ToString("F0") : "100")%
                    </div>
                    <div class="flex items-center gap-2 mt-2 text-xs text-stone-500">
                        <span class="text-emerald-600 font-medium">✔ @report.CompletedOrders Done</span>
                        @if (report.ActiveOrders > 0)
                        {
                            <span class="text-amber-600 font-medium">⏳ @report.ActiveOrders In-Queue</span>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. Visual Charts Row (Revenue Trajectory & Category Share) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Chart 1: Revenue Trajectory Chart -->
                <div class="lg:col-span-8 bg-white rounded-3xl p-6 md:p-7 border border-stone-200/80 shadow-xs">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="font-bold text-stone-900 text-base">Daily Revenue & Orders Trajectory</h2>
                            <p class="text-xs text-stone-500">Sales volume across @GetTimeframeLabel()</p>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <div class="flex items-center gap-1.5">
                                <span class="w-3 h-3 rounded-full bg-amber-800"></span>
                                <span class="text-stone-600">Revenue</span>
                            </div>
                        </div>
                    </div>

                    <!-- Custom Interactive SVG Trajectory Chart -->
                    <div class="h-64 w-full relative flex items-end pt-6">
                        @if (report.DailyRevenue.Any())
                        {
                            var maxRev = Math.Max(report.DailyRevenue.Max(d => d.Revenue), 100m);
                            var count = report.DailyRevenue.Count;

                            <div class="w-full h-full flex items-end justify-between gap-2 px-2 border-b border-stone-200 pb-2 relative">
                                <!-- Background horizontal gridlines -->
                                <div class="absolute inset-0 flex flex-col justify-between pointer-events-none opacity-30">
                                    <div class="border-b border-stone-200 border-dashed w-full"></div>
                                    <div class="border-b border-stone-200 border-dashed w-full"></div>
                                    <div class="border-b border-stone-200 border-dashed w-full"></div>
                                </div>

                                @foreach (var point in report.DailyRevenue)
                                {
                                    var heightPct = (double)(point.Revenue / maxRev) * 85;
                                    var displayHeight = Math.Max(heightPct, 6);

                                    <div class="flex-1 flex flex-col items-center gap-2 group relative z-10">
                                        <!-- Hover Floating Tooltip -->
                                        <div class="opacity-0 group-hover:opacity-100 transition-all absolute -top-12 bg-stone-900 text-white text-[11px] py-1 px-2.5 rounded-xl whitespace-nowrap shadow-xl pointer-events-none z-20">
                                            <div class="font-bold">@branding.Currency @point.Revenue.ToString("N2")</div>
                                            <div class="text-[9px] text-stone-300">@point.OrdersCount Orders</div>
                                        </div>

                                        <!-- Bar Column -->
                                        <div class="w-full max-w-[42px] bg-gradient-to-t from-amber-900 to-amber-600 rounded-t-xl transition-all duration-300 group-hover:from-amber-800 group-hover:to-amber-500 shadow-2xs cursor-pointer"
                                             style="height: @(displayHeight.ToString("F1", CultureInfo.InvariantCulture))%;">
                                        </div>

                                        <!-- X Axis Label -->
                                        <div class="text-[10px] text-stone-500 truncate max-w-[50px] text-center font-medium">
                                            @point.DayLabel.Split(',').LastOrDefault()?.Trim()
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-xs text-stone-400">
                                No sales recorded in this period.
                            </div>
                        }
                    </div>
                </div>

                <!-- Chart 2: Category Revenue Breakdown Share -->
                <div class="lg:col-span-4 bg-white rounded-3xl p-6 md:p-7 border border-stone-200/80 shadow-xs flex flex-col justify-between">
                    <div>
                        <h2 class="font-bold text-stone-900 text-base">Category Revenue Share</h2>
                        <p class="text-xs text-stone-500 mb-6">Contribution by menu section</p>

                        <!-- Segmented Progress Bar -->
                        <div class="w-full h-4 rounded-full bg-stone-100 overflow-hidden flex shadow-inner mb-6">
                            @foreach (var cat in report.CategorySales)
                            {
                                <div style="width: @(cat.RevenuePercentage.ToString("F1", CultureInfo.InvariantCulture))%; background-color: @cat.ColorHex;"
                                     title="@cat.CategoryName: @cat.RevenuePercentage.ToString("F1")%"
                                     class="h-full transition-all duration-500 first:rounded-l-full last:rounded-r-full">
                                </div>
                            }
                        </div>

                        <!-- Category List -->
                        <div class="space-y-3.5">
                            @foreach (var cat in report.CategorySales)
                            {
                                <div class="flex items-center justify-between text-xs">
                                    <div class="flex items-center gap-2">
                                        <span class="w-3 h-3 rounded-full shrink-0" style="background-color: @cat.ColorHex;"></span>
                                        <span class="font-semibold text-stone-800 truncate max-w-[140px]">@cat.CategoryName</span>
                                    </div>
                                    <div class="text-right">
                                        <span class="font-bold text-stone-900">@branding.Currency @cat.Revenue.ToString("N2")</span>
                                        <span class="text-stone-400 text-[10px] ml-1">(@cat.RevenuePercentage.ToString("F0")%)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="pt-4 mt-6 border-t border-stone-100 text-center">
                        <span class="text-[11px] text-stone-400">Total @report.CategorySales.Count categories active</span>
                    </div>
                </div>
            </div>

            <!-- 3. Peak Rush Hours Analysis Heatmap -->
            <div class="bg-white rounded-3xl p-6 md:p-7 border border-stone-200/80 shadow-xs">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="font-bold text-stone-900 text-base">Peak Rush Hours Traffic (7 AM - 9 PM)</h2>
                        <p class="text-xs text-stone-500">Hourly order density to optimize kitchen staffing and prep workflows</p>
                    </div>
                </div>

                <div class="grid grid-cols-5 sm:grid-cols-8 md:grid-cols-15 gap-2 pt-2">
                    @foreach (var hour in report.HourlyTraffic)
                    {
                        var maxOrders = Math.Max(report.HourlyTraffic.Max(h => h.OrdersCount), 1);
                        var intensity = (double)hour.OrdersCount / maxOrders;
                        var bgClass = intensity switch
                        {
                            > 0.7 => "bg-amber-600 text-white font-bold",
                            > 0.4 => "bg-amber-300 text-amber-950 font-semibold",
                            > 0.1 => "bg-amber-100 text-amber-900",
                            _ => "bg-stone-100 text-stone-500"
                        };

                        <div class="p-2.5 rounded-2xl text-center flex flex-col items-center justify-center gap-1 transition-all hover:scale-105 @bgClass"
                             title="@hour.HourLabel: @hour.OrdersCount Orders (@branding.Currency @hour.Revenue.ToString("N2"))">
                            <span class="text-[10px] opacity-80 whitespace-nowrap">@hour.HourLabel</span>
                            <span class="text-sm">@hour.OrdersCount</span>
                        </div>
                    }
                </div>
            </div>

            <!-- 4. Product-Wise Orders & Sales Leaderboard Table -->
            <div class="bg-white rounded-3xl border border-stone-200/80 shadow-xs overflow-hidden">
                <div class="p-6 border-b border-stone-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 class="font-bold text-stone-900 text-base">Product-Wise Performance & Orders</h2>
                        <p class="text-xs text-stone-500">Ranking of best-selling items, units sold, and revenue generated</p>
                    </div>

                    <!-- Search Box -->
                    <div class="relative w-full sm:w-64">
                        <input type="text" @bind="productSearchQuery" @bind:event="oninput" placeholder="Filter items..."
                               class="w-full pl-9 pr-4 py-2 bg-stone-50 border border-stone-200 rounded-xl text-xs focus:ring-2 focus:ring-amber-800 focus:outline-none" />
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3 top-2.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-stone-50/70 text-stone-500 uppercase text-[10px] tracking-wider border-b border-stone-200">
                                <th class="py-3 px-6">Rank & Product</th>
                                <th class="py-3 px-4">Category</th>
                                <th class="py-3 px-4 text-right">Unit Price</th>
                                <th class="py-3 px-6 text-right">Units Sold</th>
                                <th class="py-3 px-6 text-right">Total Revenue</th>
                                <th class="py-3 px-6 text-right">Sales Share</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-stone-100 text-xs">
                            @if (FilteredProducts.Any())
                            {
                                int rank = 1;
                                var maxUnits = Math.Max(FilteredProducts.Max(p => p.UnitsSold), 1);

                                @foreach (var prod in FilteredProducts)
                                {
                                    <tr class="hover:bg-stone-50/60 transition-colors">
                                        <td class="py-3.5 px-6">
                                            <div class="flex items-center gap-3">
                                                <span class="w-5 font-bold text-stone-400 text-xs">#@(rank++)</span>
                                                <img src="@prod.ImageUrl" alt="@prod.ItemName" class="w-9 h-9 rounded-xl object-cover shrink-0 shadow-2xs" />
                                                <span class="font-bold text-stone-900">@prod.ItemName</span>
                                            </div>
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-stone-100 text-stone-700 border border-stone-200">
                                                @prod.CategoryName
                                            </span>
                                        </td>
                                        <td class="py-3.5 px-4 text-right font-medium text-stone-600">
                                            @branding.Currency @prod.UnitPrice.ToString("N2")
                                        </td>
                                        <td class="py-3.5 px-6 text-right">
                                            <div class="inline-flex items-center gap-2 font-bold text-stone-900">
                                                <span>@prod.UnitsSold</span>
                                                <div class="w-16 h-1.5 rounded-full bg-stone-100 overflow-hidden hidden sm:block">
                                                    <div class="h-full bg-amber-800 rounded-full" style="width: @(((double)prod.UnitsSold / maxUnits * 100).ToString("F0"))%;"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3.5 px-6 text-right font-bold text-stone-900">
                                            @branding.Currency @prod.Revenue.ToString("N2")
                                        </td>
                                        <td class="py-3.5 px-6 text-right font-semibold text-stone-500">
                                            @prod.RevenuePercentage.ToString("F1")%
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="py-8 text-center text-stone-400">
                                        No product sales matched your search.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </main>
</div>

@code {
    private SalesReportSummaryDto report = new();
    private TenantBrandingDto branding = new();
    private string selectedTimeframe = "7days";
    private string productSearchQuery = string.Empty;
    private bool isLoading = true;

    private IEnumerable<ProductSalesItemDto> FilteredProducts =>
        string.IsNullOrWhiteSpace(productSearchQuery)
            ? report.ProductSales
            : report.ProductSales.Where(p => 
                p.ItemName.Contains(productSearchQuery, StringComparison.OrdinalIgnoreCase) || 
                p.CategoryName.Contains(productSearchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        branding = await BrandingService.GetBrandingAsync();
        await LoadReport();
    }

    private async Task ChangeTimeframe(string timeframe)
    {
        selectedTimeframe = timeframe;
        await LoadReport();
    }

    private async Task LoadReport()
    {
        isLoading = true;
        try
        {
            report = await ReportService.GetSalesReportAsync(selectedTimeframe);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetTimeframeLabel() => selectedTimeframe switch
    {
        "today" => "Today",
        "7days" => "the Last 7 Days",
        "30days" => "the Last 30 Days",
        _ => "All Time"
    };

    private async Task TriggerPrint()
    {
        await JSRuntime.InvokeVoidAsync("rollupTools.triggerPrint");
    }
}
