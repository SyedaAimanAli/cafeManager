@page "/manage/users"
@using RollUp.Core.Entities
@using RollUp.Core.Enums
@using RollUp.Core.Interfaces
@using RollUp.Application.DTOs
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>User & Role Management - RollUp</PageTitle>

<div class="min-h-screen bg-stone-50 pb-20 md:pb-0">
    <AdminNavbar />

    <!-- Action Bar -->
    <div class="bg-white border-b border-stone-200">
        <div class="max-w-7xl mx-auto px-4 md:px-6 py-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-xl font-bold text-cafe-espresso">Team & Role Management</h1>
                    <p class="text-xs text-stone-500">Manage cafe staff, kitchen operators, cashiers, and access roles</p>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <button @onclick="OpenAddModal"
                            class="px-4 py-2 bg-cafe-espresso text-white text-sm font-semibold rounded-xl hover:bg-cafe-mocha transition-all shadow-sm flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                        </svg>
                        <span>Add Team Member</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 md:px-6 py-6 md:py-8 space-y-6">
        <!-- Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-xs">
                <div class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-1">Total Team</div>
                <div class="text-2xl font-bold text-cafe-espresso">@Users.Count</div>
                <div class="text-xs text-stone-500 mt-1">Registered staff members</div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-xs">
                <div class="text-xs font-bold text-purple-600 uppercase tracking-wider mb-1">Admins & Managers</div>
                <div class="text-2xl font-bold text-purple-700">@Users.Count(u => u.Role == Role.Admin || u.Role == Role.Manager)</div>
                <div class="text-xs text-stone-500 mt-1">Full management access</div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-xs">
                <div class="text-xs font-bold text-amber-600 uppercase tracking-wider mb-1">Kitchen Display</div>
                <div class="text-2xl font-bold text-amber-700">@Users.Count(u => u.Role == Role.Kitchen)</div>
                <div class="text-xs text-stone-500 mt-1">KDS & order prep</div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-xs">
                <div class="text-xs font-bold text-emerald-600 uppercase tracking-wider mb-1">Cashiers & POS</div>
                <div class="text-2xl font-bold text-emerald-700">@Users.Count(u => u.Role == Role.Cashier)</div>
                <div class="text-xs text-stone-500 mt-1">Front desk & checkout</div>
            </div>
        </div>

        <!-- Tab Controls -->
        <div class="flex items-center gap-2 border-b border-stone-200 pb-2">
            <button @onclick="() => activeTab = TabMembers" 
                    class="px-4 py-2 text-sm font-semibold rounded-xl transition-all @(activeTab == TabMembers ? "bg-cafe-espresso text-white shadow-xs" : "text-stone-600 hover:bg-stone-100")">
                Team Members (@FilteredUsers.Count())
            </button>
            <button @onclick="() => activeTab = TabRoleGuide" 
                    class="px-4 py-2 text-sm font-semibold rounded-xl transition-all @(activeTab == TabRoleGuide ? "bg-cafe-espresso text-white shadow-xs" : "text-stone-600 hover:bg-stone-100")">
                Role & Permissions Matrix
            </button>
        </div>

        @if (activeTab == TabMembers)
        {
            <!-- Search & Filters -->
            <div class="flex flex-col sm:flex-row gap-3 items-center justify-between">
                <div class="relative w-full sm:w-80">
                    <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search by name or email..."
                           class="w-full pl-10 pr-4 py-2.5 bg-white border border-stone-200 rounded-xl text-sm focus:ring-2 focus:ring-cafe-caramel focus:outline-none transition-all" />
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-stone-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>

                <div class="flex items-center gap-2 w-full sm:w-auto overflow-x-auto pb-1">
                    <button @onclick="() => selectedRoleFilter = null" 
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all @(selectedRoleFilter == null ? "bg-cafe-espresso text-white" : "bg-white border border-stone-200 text-stone-600 hover:bg-stone-50")">
                        All Roles
                    </button>
                    @foreach (Role role in Enum.GetValues<Role>())
                    {
                        <button @onclick="() => selectedRoleFilter = role" 
                                class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all @(selectedRoleFilter == role ? "bg-cafe-espresso text-white" : "bg-white border border-stone-200 text-stone-600 hover:bg-stone-50")">
                            @role.ToString()
                        </button>
                    }
                </div>
            </div>

            <!-- Users Table -->
            <div class="bg-white rounded-2xl border border-stone-200 shadow-xs overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead class="bg-stone-50 border-b border-stone-200 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                            <tr>
                                <th class="px-6 py-3.5">User</th>
                                <th class="px-6 py-3.5">Role</th>
                                <th class="px-6 py-3.5">Assigned Outlet</th>
                                <th class="px-6 py-3.5">Status</th>
                                <th class="px-6 py-3.5 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-stone-100">
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="5" class="px-6 py-12 text-center text-stone-500">
                                        <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-cafe-caramel border-t-transparent mb-2"></div>
                                        <p class="text-xs">Loading team members...</p>
                                    </td>
                                </tr>
                            }
                            else if (!FilteredUsers.Any())
                            {
                                <tr>
                                    <td colspan="5" class="px-6 py-12 text-center text-stone-500">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mx-auto text-stone-300 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                        </svg>
                                        <p class="font-medium text-stone-700">No team members found</p>
                                        <p class="text-xs text-stone-400 mt-1">Try adjusting your search or add a new team member.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var user in FilteredUsers)
                                {
                                    <tr class="hover:bg-stone-50 transition-colors">
                                        <!-- User Name & Email -->
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-white text-xs shadow-xs @GetUserAvatarBg(user.Role)">
                                                    @GetInitials(user.FullName)
                                                </div>
                                                <div>
                                                    <div class="font-semibold text-stone-800">@user.FullName</div>
                                                    <div class="text-xs text-stone-500">@user.Email</div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Role Badge -->
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @GetRoleBadgeClass(user.Role)">
                                                @user.Role.ToString()
                                            </span>
                                        </td>

                                        <!-- Assigned Outlet -->
                                        <td class="px-6 py-4 text-stone-600">
                                            <span class="inline-flex items-center gap-1.5">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                                </svg>
                                                @user.OutletName
                                            </span>
                                        </td>

                                        <!-- Status -->
                                        <td class="px-6 py-4">
                                            @if (user.IsActive)
                                            {
                                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-stone-500">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span>
                                                    Inactive
                                                </span>
                                            }
                                        </td>

                                        <!-- Actions -->
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <button @onclick="() => OpenEditModal(user)" 
                                                        class="p-1.5 text-stone-500 hover:text-cafe-espresso hover:bg-stone-100 rounded-lg transition-colors"
                                                        title="Edit details & role">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                </button>

                                                <button @onclick="() => OpenResetPasswordModal(user)" 
                                                        class="p-1.5 text-stone-500 hover:text-amber-700 hover:bg-amber-50 rounded-lg transition-colors"
                                                        title="Reset Password">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                                                    </svg>
                                                </button>

                                                <button @onclick="() => OpenDeleteModal(user)" 
                                                        class="p-1.5 text-stone-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                                                        title="Delete user">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <!-- Role & Permissions Matrix -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                
                <!-- Admin Card -->
                <div class="bg-white rounded-2xl border border-purple-200 p-6 shadow-xs relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-purple-50 rounded-bl-full -mr-4 -mt-4"></div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold">
                            👑
                        </div>
                        <div>
                            <h3 class="font-bold text-stone-800">Admin</h3>
                            <span class="text-xs text-purple-600 font-semibold">Full Organization Access</span>
                        </div>
                    </div>
                    <ul class="text-xs text-stone-600 space-y-2">
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Manage all menu items, prices & categories</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Add/remove team members & assign roles</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Customize menu branding, themes & printables</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Access all outlets and reports</li>
                    </ul>
                </div>

                <!-- Manager Card -->
                <div class="bg-white rounded-2xl border border-blue-200 p-6 shadow-xs relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-blue-50 rounded-bl-full -mr-4 -mt-4"></div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold">
                            💼
                        </div>
                        <div>
                            <h3 class="font-bold text-stone-800">Manager</h3>
                            <span class="text-xs text-blue-600 font-semibold">Store Operations</span>
                        </div>
                    </div>
                    <ul class="text-xs text-stone-600 space-y-2">
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Update menu item availability & stock</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Monitor orders, refunds & active queues</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Print QR codes & table stands</li>
                        <li class="flex items-center gap-2"><span class="text-stone-300">✗</span> Cannot delete admin accounts</li>
                    </ul>
                </div>

                <!-- Kitchen Card -->
                <div class="bg-white rounded-2xl border border-amber-200 p-6 shadow-xs relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-amber-50 rounded-bl-full -mr-4 -mt-4"></div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
                            🍳
                        </div>
                        <div>
                            <h3 class="font-bold text-stone-800">Kitchen / KDS</h3>
                            <span class="text-xs text-amber-600 font-semibold">Order Fulfillment</span>
                        </div>
                    </div>
                    <ul class="text-xs text-stone-600 space-y-2">
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> View real-time incoming kitchen tickets</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Transition order status (Pending ➔ Preparing ➔ Ready)</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Audio chimes on new orders</li>
                        <li class="flex items-center gap-2"><span class="text-stone-300">✗</span> No access to menu price changes or users</li>
                    </ul>
                </div>

                <!-- Cashier Card -->
                <div class="bg-white rounded-2xl border border-emerald-200 p-6 shadow-xs relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-50 rounded-bl-full -mr-4 -mt-4"></div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                            💳
                        </div>
                        <div>
                            <h3 class="font-bold text-stone-800">Cashier</h3>
                            <span class="text-xs text-emerald-600 font-semibold">Point of Sale & Checkout</span>
                        </div>
                    </div>
                    <ul class="text-xs text-stone-600 space-y-2">
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Take counter walk-in orders</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Manage table seatings and queue tickets</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Mark payments as completed</li>
                    </ul>
                </div>

                <!-- Customer Card -->
                <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-xs relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-stone-100 rounded-bl-full -mr-4 -mt-4"></div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-stone-100 text-stone-700 flex items-center justify-center font-bold">
                            📱
                        </div>
                        <div>
                            <h3 class="font-bold text-stone-800">Customer</h3>
                            <span class="text-xs text-stone-500 font-semibold">Dine-in & Online Guest</span>
                        </div>
                    </div>
                    <ul class="text-xs text-stone-600 space-y-2">
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Scan QR code to view digital menu</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Place dine-in table or takeaway orders</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500">✓</span> Track order ticket number in live queue</li>
                    </ul>
                </div>
            </div>
        }
    </main>
</div>

<!-- Add User Modal -->
@if (showAddModal)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-xs flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl space-y-5 animate-in fade-in zoom-in-95 duration-150">
            <div class="flex items-center justify-between border-b border-stone-100 pb-4">
                <h3 class="text-lg font-bold text-cafe-espresso">Add Team Member</h3>
                <button @onclick="() => showAddModal = false" class="text-stone-400 hover:text-stone-600 p-1">
                    ✕
                </button>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="p-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-xs">
                    @errorMessage
                </div>
            }

            <div class="space-y-4 text-sm">
                <div>
                    <label class="block font-semibold text-stone-700 mb-1">Full Name</label>
                    <input type="text" @bind="newUserName" placeholder="e.g. Sarah Jenkins"
                           class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
                </div>

                <div>
                    <label class="block font-semibold text-stone-700 mb-1">Email Address</label>
                    <input type="email" @bind="newUserEmail" placeholder="sarah@rollup.com"
                           class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
                </div>

                <div>
                    <label class="block font-semibold text-stone-700 mb-1">Temporary Password</label>
                    <input type="password" @bind="newUserPassword" placeholder="Minimum 6 characters"
                           class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-stone-700 mb-1">Role</label>
                        <select @bind="newUserRole" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none">
                            <option value="@Role.Admin">Admin</option>
                            <option value="@Role.Manager">Manager</option>
                            <option value="@Role.Kitchen">Kitchen / KDS</option>
                            <option value="@Role.Cashier">Cashier</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-stone-700 mb-1">Assigned Outlet</label>
                        <select @bind="newUserOutletId" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none">
                            <option value="">All Outlets</option>
                            @foreach (var outlet in Outlets)
                            {
                                <option value="@outlet.Id">@outlet.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
                <button @onclick="() => showAddModal = false" class="px-4 py-2 text-stone-600 hover:bg-stone-100 rounded-xl text-sm font-semibold">
                    Cancel
                </button>
                <button @onclick="HandleCreateUser" disabled="@isSubmitting"
                        class="px-5 py-2 bg-cafe-espresso text-white rounded-xl text-sm font-semibold hover:bg-cafe-mocha transition-colors disabled:opacity-50">
                    @(isSubmitting ? "Creating..." : "Create Member")
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit User Modal -->
@if (showEditModal && editingUser != null)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-xs flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl space-y-5 animate-in fade-in zoom-in-95 duration-150">
            <div class="flex items-center justify-between border-b border-stone-100 pb-4">
                <h3 class="text-lg font-bold text-cafe-espresso">Edit Team Member</h3>
                <button @onclick="() => showEditModal = false" class="text-stone-400 hover:text-stone-600 p-1">
                    ✕
                </button>
            </div>

            <div class="space-y-4 text-sm">
                <div>
                    <label class="block font-semibold text-stone-700 mb-1">Full Name</label>
                    <input type="text" @bind="editingUser.FullName"
                           class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
                </div>

                <div>
                    <label class="block font-semibold text-stone-700 mb-1">Email</label>
                    <input type="text" value="@editingUser.Email" disabled
                           class="w-full px-4 py-2.5 bg-stone-100 border border-stone-200 rounded-xl text-stone-500 cursor-not-allowed" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-stone-700 mb-1">Role</label>
                        <select @bind="editingUser.Role" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none">
                            <option value="@Role.Admin">Admin</option>
                            <option value="@Role.Manager">Manager</option>
                            <option value="@Role.Kitchen">Kitchen / KDS</option>
                            <option value="@Role.Cashier">Cashier</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-stone-700 mb-1">Assigned Outlet</label>
                        <select @bind="editingUser.OutletId" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-cafe-caramel focus:outline-none">
                            <option value="">All Outlets</option>
                            @foreach (var outlet in Outlets)
                            {
                                <option value="@outlet.Id">@outlet.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <input type="checkbox" id="userActiveToggle" @bind="editingUser.IsActive" class="w-4 h-4 text-cafe-espresso rounded accent-amber-800" />
                    <label for="userActiveToggle" class="font-semibold text-stone-700 text-sm">Account is Active</label>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
                <button @onclick="() => showEditModal = false" class="px-4 py-2 text-stone-600 hover:bg-stone-100 rounded-xl text-sm font-semibold">
                    Cancel
                </button>
                <button @onclick="HandleUpdateUser" disabled="@isSubmitting"
                        class="px-5 py-2 bg-cafe-espresso text-white rounded-xl text-sm font-semibold hover:bg-cafe-mocha transition-colors disabled:opacity-50">
                    @(isSubmitting ? "Saving..." : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

<!-- Reset Password Modal -->
@if (showResetModal && resetTargetUser != null)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-xs flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 md:p-8 shadow-2xl space-y-5 animate-in fade-in zoom-in-95 duration-150">
            <div class="flex items-center justify-between border-b border-stone-100 pb-4">
                <h3 class="text-lg font-bold text-cafe-espresso">Reset Password</h3>
                <button @onclick="() => showResetModal = false" class="text-stone-400 hover:text-stone-600 p-1">
                    ✕
                </button>
            </div>

            <p class="text-xs text-stone-500">
                Set a new password for <span class="font-semibold text-stone-800">@resetTargetUser.FullName</span> (@resetTargetUser.Email).
            </p>

            <div>
                <label class="block font-semibold text-stone-700 text-sm mb-1">New Password</label>
                <input type="password" @bind="newResetPassword" placeholder="Minimum 6 characters"
                       class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-sm focus:ring-2 focus:ring-cafe-caramel focus:outline-none" />
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
                <button @onclick="() => showResetModal = false" class="px-4 py-2 text-stone-600 hover:bg-stone-100 rounded-xl text-sm font-semibold">
                    Cancel
                </button>
                <button @onclick="HandleResetPassword" disabled="@(string.IsNullOrWhiteSpace(newResetPassword) || isSubmitting)"
                        class="px-5 py-2 bg-amber-700 text-white rounded-xl text-sm font-semibold hover:bg-amber-800 transition-colors disabled:opacity-50">
                    @(isSubmitting ? "Resetting..." : "Update Password")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && deleteTargetUser != null)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-xs flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 animate-in fade-in zoom-in-95 duration-150">
            <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            </div>

            <div class="text-center">
                <h3 class="text-lg font-bold text-stone-800">Remove Team Member?</h3>
                <p class="text-xs text-stone-500 mt-1">
                    Are you sure you want to remove <span class="font-semibold text-stone-800">@deleteTargetUser.FullName</span>? They will no longer be able to log in.
                </p>
            </div>

            <div class="flex items-center justify-center gap-3 pt-4 border-t border-stone-100">
                <button @onclick="() => showDeleteModal = false" class="px-4 py-2 text-stone-600 hover:bg-stone-100 rounded-xl text-sm font-semibold">
                    Cancel
                </button>
                <button @onclick="HandleDeleteUser" disabled="@isSubmitting"
                        class="px-5 py-2 bg-red-600 text-white rounded-xl text-sm font-semibold hover:bg-red-700 transition-colors disabled:opacity-50">
                    @(isSubmitting ? "Deleting..." : "Yes, Remove")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string TabMembers = "members";
    private const string TabRoleGuide = "guide";
    private string activeTab = TabMembers;

    private List<UserListItemDto> Users = new();
    private List<Outlet> Outlets = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;

    private string searchTerm = string.Empty;
    private Role? selectedRoleFilter = null;

    // Modals state
    private bool showAddModal = false;
    private bool showEditModal = false;
    private bool showResetModal = false;
    private bool showDeleteModal = false;

    // Add form
    private string newUserName = string.Empty;
    private string newUserEmail = string.Empty;
    private string newUserPassword = string.Empty;
    private Role newUserRole = Role.Cashier;
    private int? newUserOutletId = null;

    // Edit form
    private UpdateUserRequestDto? editingUser;

    // Reset password
    private UserListItemDto? resetTargetUser;
    private string newResetPassword = string.Empty;

    // Delete target
    private UserListItemDto? deleteTargetUser;

    private IEnumerable<UserListItemDto> FilteredUsers
    {
        get
        {
            var list = Users.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                list = list.Where(u => u.FullName.ToLower().Contains(term) || u.Email.ToLower().Contains(term));
            }

            if (selectedRoleFilter.HasValue)
            {
                list = list.Where(u => u.Role == selectedRoleFilter.Value);
            }

            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            Users = await UserService.GetUsersAsync();
            Outlets = await UserService.GetOutletsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        newUserName = string.Empty;
        newUserEmail = string.Empty;
        newUserPassword = string.Empty;
        newUserRole = Role.Cashier;
        newUserOutletId = null;
        errorMessage = null;
        showAddModal = true;
    }

    private async Task HandleCreateUser()
    {
        if (string.IsNullOrWhiteSpace(newUserName) || string.IsNullOrWhiteSpace(newUserEmail) || string.IsNullOrWhiteSpace(newUserPassword))
        {
            errorMessage = "Please fill in all required fields.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var created = await UserService.CreateUserAsync(new CreateUserRequestDto
            {
                FullName = newUserName,
                Email = newUserEmail,
                Password = newUserPassword,
                Role = newUserRole,
                OutletId = newUserOutletId
            });

            if (created != null)
            {
                showAddModal = false;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenEditModal(UserListItemDto user)
    {
        editingUser = new UpdateUserRequestDto
        {
            Id = user.Id,
            FullName = user.FullName,
            Email = user.Email,
            Role = user.Role,
            OutletId = user.OutletId,
            IsActive = user.IsActive
        };
        showEditModal = true;
    }

    private async Task HandleUpdateUser()
    {
        if (editingUser == null || string.IsNullOrWhiteSpace(editingUser.FullName)) return;

        isSubmitting = true;
        try
        {
            var success = await UserService.UpdateUserAsync(editingUser);
            if (success)
            {
                showEditModal = false;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenResetPasswordModal(UserListItemDto user)
    {
        resetTargetUser = user;
        newResetPassword = string.Empty;
        showResetModal = true;
    }

    private async Task HandleResetPassword()
    {
        if (resetTargetUser == null || string.IsNullOrWhiteSpace(newResetPassword)) return;

        isSubmitting = true;
        try
        {
            var success = await UserService.ResetPasswordAsync(resetTargetUser.Id, newResetPassword);
            if (success)
            {
                showResetModal = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenDeleteModal(UserListItemDto user)
    {
        deleteTargetUser = user;
        showDeleteModal = true;
    }

    private async Task HandleDeleteUser()
    {
        if (deleteTargetUser == null) return;

        isSubmitting = true;
        try
        {
            var success = await UserService.DeleteUserAsync(deleteTargetUser.Id);
            if (success)
            {
                showDeleteModal = false;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private static string GetUserAvatarBg(Role role) => role switch
    {
        Role.Admin => "bg-purple-600",
        Role.Manager => "bg-blue-600",
        Role.Kitchen => "bg-amber-600",
        Role.Cashier => "bg-emerald-600",
        _ => "bg-stone-600"
    };

    private static string GetRoleBadgeClass(Role role) => role switch
    {
        Role.Admin => "bg-purple-50 text-purple-700 border border-purple-200",
        Role.Manager => "bg-blue-50 text-blue-700 border border-blue-200",
        Role.Kitchen => "bg-amber-50 text-amber-700 border border-amber-200",
        Role.Cashier => "bg-emerald-50 text-emerald-700 border border-emerald-200",
        _ => "bg-stone-50 text-stone-700 border border-stone-200"
    };
}
