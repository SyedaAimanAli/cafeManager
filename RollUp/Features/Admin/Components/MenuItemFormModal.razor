@using RollUp.Core.Models

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/50" @onclick="Close"></div>
        <div class="relative bg-white rounded-t-3xl md:rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col mt-auto md:mt-0 overflow-hidden shadow-2xl">
            <div class="flex-shrink-0 bg-white border-b border-stone-200 px-6 py-4 flex items-center justify-between">
                <h2 class="text-xl font-semibold text-cafe-espresso">
                    @(IsEditing ? "Edit Item" : "Add New Item")
                </h2>
                <button @onclick="Close" class="p-2 hover:bg-stone-100 rounded-lg transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-6 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="col-span-2">
                        <RollUpInput Label="Item Name" @bind-Value="Item.Name" />
                    </div>
                    
                    <div class="col-span-2">
                        <RollUpInput Label="Description" @bind-Value="Item.Description" IsTextArea="true" Rows="2" />
                    </div>

                    <div>
                        <RollUpInput Label="Price ($)" @bind-Value="PriceString" Type="number" Step="0.01" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-stone-700 mb-2">Category</label>
                        <select @bind="Item.Category"
                                class="w-full px-4 py-3 border border-stone-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-cafe-caramel focus:border-transparent">
                            @foreach (var category in Categories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-medium text-stone-700 mb-2">Item Image</label>
                        <div class="flex items-center gap-4">
                            @if (!string.IsNullOrEmpty(Item.ImageUrl))
                            {
                                <div class="relative w-16 h-16 rounded-lg overflow-hidden border border-stone-200">
                                    @if (IsUploading)
                                    {
                                        <div class="absolute inset-0 bg-white/80 flex flex-col items-center justify-center">
                                            <div class="w-8 h-8 border-4 border-cafe-caramel border-t-transparent rounded-full animate-spin mb-2"></div>
                                            <span class="text-xs font-medium text-cafe-espresso">Uploading...</span>
                                        </div>
                                    }
                                    <img src="@(string.IsNullOrEmpty(Item.ImageUrl) ? "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=400" : Item.ImageUrl)" 
                                         class="w-full h-full object-cover" />
                                </div>
                            }
                            <div class="flex-1 space-y-3">
                                <label class="block text-sm font-medium text-cafe-espresso">Item Image</label>
                                <div class="flex flex-col gap-2">
                                    <InputFile OnChange="HandleFileSelected" class="hidden" id="fileInput" disabled="@IsUploading" />
                                    <label for="fileInput" class="inline-flex items-center justify-center px-4 py-2 bg-stone-100 text-stone-600 text-sm font-medium rounded-xl hover:bg-stone-200 transition-colors cursor-pointer border-2 border-dashed border-stone-300">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                                        </svg>
                                        @(IsUploading ? "Processing..." : "Upload Photo")
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2">
                            <RollUpInput @bind-Value="Item.ImageUrl" Placeholder="Or paste URL here..." />
                        </div>
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-medium text-stone-700 mb-2">Tags</label>
                        <div class="flex flex-wrap gap-2 mb-3">
                            @foreach (var tag in Item.Tags)
                            {
                                <span class="flex items-center gap-1 px-3 py-1 bg-cafe-cream text-cafe-mocha text-sm rounded-full">
                                    @tag
                                    <button @onclick="() => RemoveTag(tag)" class="hover:text-red-600">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                        </svg>
                                    </button>
                                </span>
                            }
                        </div>
                        <div class="flex gap-2">
                            <input @bind="NewTag" 
                                   @onkeyup="HandleTagKeyUp"
                                   placeholder="Add a tag (e.g., Vegan, Spicy)..."
                                   class="flex-1 px-4 py-2 border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-cafe-caramel focus:border-transparent" />
                            <button @onclick="AddTag" type="button"
                                    class="px-4 py-2 bg-stone-100 text-stone-600 rounded-lg hover:bg-stone-200 transition-colors">
                                Add
                            </button>
                        </div>
                    </div>

                    <div class="col-span-2 flex items-center gap-6">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" @bind="Item.IsAvailable"
                                   class="w-5 h-5 rounded border-stone-300 text-cafe-caramel focus:ring-cafe-caramel" />
                            <span class="text-stone-700">Available for ordering</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" @bind="Item.IsPopular"
                                   class="w-5 h-5 rounded border-stone-300 text-amber-500 focus:ring-amber-500" />
                            <span class="text-stone-700">Mark as popular</span>
                        </label>
                    </div>
                </div>

            </div>

            <div class="flex-shrink-0 flex justify-end gap-3 px-6 py-4 bg-stone-50 border-t border-stone-200 rounded-b-2xl">
                    <button @onclick="Close"
                            class="px-6 py-3 text-stone-600 hover:bg-stone-100 rounded-xl transition-colors">
                        Cancel
                    </button>
                    <button @onclick="Save"
                            class="px-6 py-3 bg-cafe-espresso text-white rounded-xl hover:bg-cafe-mocha transition-colors">
                        @(IsEditing ? "Save Changes" : "Add Item")
                    </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public MenuItem Item { get; set; } = new();
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public List<string> Categories { get; set; } = new();
    [Parameter] public EventCallback<MenuItem> OnSave { get; set; }

    private string PriceString
    {
        get => Item.Price.ToString("0.00");
        set
        {
            if (decimal.TryParse(value, out var price))
            {
                Item.Price = price;
            }
        }
    }

    private string NewTag = string.Empty;
    private bool IsUploading;

    private void AddTag()
    {
        if (!string.IsNullOrWhiteSpace(NewTag) && !Item.Tags.Contains(NewTag))
        {
            Item.Tags.Add(NewTag.Trim());
            NewTag = string.Empty;
        }
    }

    private void RemoveTag(string tag) => Item.Tags.Remove(tag);

    private void HandleTagKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTag();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try 
        {
            IsUploading = true;
            StateHasChanged();

            var format = "image/png";
            var resizedFile = await file.RequestImageFileAsync(format, 400, 400);
            using var stream = resizedFile.OpenReadStream(1024 * 1024 * 5); // 5MB limit
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            Item.ImageUrl = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        finally
        {
            IsUploading = false;
            StateHasChanged();
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Save()
    {
        await OnSave.InvokeAsync(Item);
        await Close();
    }
}
