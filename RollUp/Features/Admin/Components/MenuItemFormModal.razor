@using RollUp.Core.Models

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-xs" @onclick="Close"></div>
        <div class="relative bg-surface rounded-t-3xl md:rounded-card border border-line w-full max-w-2xl max-h-[90vh] flex flex-col mt-auto md:mt-0 overflow-hidden shadow-elevated">
            <div class="flex-shrink-0 bg-surface border-b border-line px-6 py-4 flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-display font-bold text-ink">
                        @(IsEditing ? "Edit Menu Item" : "Add New Menu Item")
                    </h2>
                    @if (!string.IsNullOrEmpty(BranchName))
                    {
                        <span class="inline-flex items-center gap-1 text-[11px] text-accent font-semibold mt-0.5">
                            <span>📍 Branch:</span> <strong>@BranchName</strong>
                        </span>
                    }
                </div>
                <button @onclick="Close" class="p-2 hover:bg-line/40 rounded-lg transition-colors text-ink-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-6 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="col-span-2">
                        <RollUpInput Label="Item Name *" @bind-Value="Item.Name" Error="@nameError" Placeholder="e.g. Caramel Macchiato, Butter Croissant" />
                    </div>
                    
                    <div class="col-span-2">
                        <RollUpInput Label="Description" @bind-Value="Item.Description" IsTextArea="true" Rows="2" Placeholder="Short description of the item ingredients and flavor notes" />
                    </div>

                    <div>
                        <RollUpInput Label="Price ($) *" @bind-Value="PriceString" Type="number" Step="0.01" Error="@priceError" Placeholder="e.g. 4.75" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-ink mb-2">Category</label>
                        <select @bind="Item.Category"
                                class="w-full px-4 py-3 bg-bg border border-line rounded-xl text-ink focus:outline-none focus:ring-2 focus:ring-accent">
                            @if (!Categories.Any())
                            {
                                <option value="Hot Coffee">Hot Coffee</option>
                                <option value="Cold Brews & Iced">Cold Brews & Iced</option>
                                <option value="Bakery & Pastries">Bakery & Pastries</option>
                                <option value="Espresso">Espresso</option>
                            }
                            else
                            {
                                @foreach (var category in Categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-medium text-ink mb-2">Item Image</label>
                        <div class="flex items-center gap-4">
                            @if (!string.IsNullOrEmpty(Item.ImageUrl))
                            {
                                <div class="relative w-16 h-16 rounded-xl overflow-hidden border border-line">
                                    @if (IsUploading)
                                    {
                                        <div class="absolute inset-0 bg-surface/80 flex flex-col items-center justify-center">
                                            <div class="w-6 h-6 border-2 border-accent border-t-transparent rounded-full animate-spin mb-1"></div>
                                            <span class="text-[10px] font-medium text-ink">Uploading...</span>
                                        </div>
                                    }
                                    <img src="@(string.IsNullOrEmpty(Item.ImageUrl) ? "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=400" : Item.ImageUrl)" 
                                         class="w-full h-full object-cover" />
                                </div>
                            }
                            <div class="flex-1 space-y-2">
                                <InputFile OnChange="HandleFileSelected" class="hidden" id="fileInput" disabled="@IsUploading" />
                                <label for="fileInput" class="inline-flex items-center justify-center px-4 py-2 bg-bg text-ink text-xs font-semibold rounded-xl hover:bg-line/50 transition-colors cursor-pointer border border-dashed border-line">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                                    </svg>
                                    @(IsUploading ? "Processing..." : "Upload Photo")
                                </label>
                            </div>
                        </div>
                        <div class="mt-2">
                            <RollUpInput @bind-Value="Item.ImageUrl" Placeholder="Or paste URL here (https://...)..." />
                        </div>
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-medium text-ink mb-2">Tags</label>
                        <div class="flex flex-wrap gap-2 mb-3">
                            @foreach (var tag in Item.Tags)
                            {
                                var curTag = tag;
                                <span class="flex items-center gap-1.5 px-3 py-1 bg-accent/15 text-accent-ink text-xs font-semibold rounded-pill">
                                    @curTag
                                    <button type="button" @onclick="() => RemoveTag(curTag)" class="hover:text-bad">
                                        &times;
                                    </button>
                                </span>
                            }
                        </div>
                        <div class="flex gap-2">
                            <input @bind="NewTag" 
                                   @onkeyup="HandleTagKeyUp"
                                   placeholder="Add a tag (e.g., Vegan, Gluten-Free)..."
                                   class="flex-1 px-4 py-2 bg-bg border border-line rounded-xl text-xs text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
                            <button @onclick="AddTag" type="button"
                                    class="px-4 py-2 bg-bg hover:bg-line border border-line text-ink font-semibold rounded-xl text-xs transition-colors">
                                Add
                            </button>
                        </div>
                    </div>

                    <div class="col-span-2 flex items-center gap-6">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" @bind="Item.IsAvailable"
                                   class="w-4 h-4 rounded border-line text-accent focus:ring-accent" />
                            <span class="text-xs font-medium text-ink">Available for ordering</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" @bind="Item.IsPopular"
                                   class="w-4 h-4 rounded border-line text-accent focus:ring-accent" />
                            <span class="text-xs font-medium text-ink">Mark as popular</span>
                        </label>
                    </div>
                </div>

            </div>

            <div class="flex-shrink-0 flex justify-end gap-3 px-6 py-4 bg-surface border-t border-line">
                <button @onclick="Close"
                        class="px-5 py-2.5 text-ink-muted hover:text-ink text-xs font-semibold rounded-xl transition-colors cursor-pointer">
                    Cancel
                </button>
                <button @onclick="Save" disabled="@isSaving"
                        class="px-6 py-2.5 bg-accent text-accent-ink font-bold rounded-pill text-xs hover:opacity-90 disabled:opacity-50 shadow-sm transition-all flex items-center gap-1.5 cursor-pointer">
                    @if (isSaving)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-accent-ink border-t-transparent rounded-full animate-spin"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>@(IsEditing ? "Save Changes" : "Add Item")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public MenuItem Item { get; set; } = new();
    [Parameter] public string BranchName { get; set; } = string.Empty;
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public List<string> Categories { get; set; } = new();
    [Parameter] public EventCallback<MenuItem> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string? nameError;
    private string? priceError;
    private bool isSaving;

    private string PriceString
    {
        get => Item.Price > 0 ? Item.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : (IsEditing ? "0.00" : "");
        set
        {
            priceError = null;
            if (string.IsNullOrWhiteSpace(value))
            {
                Item.Price = 0;
            }
            else if (decimal.TryParse(value.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var price))
            {
                Item.Price = price;
            }
        }
    }

    private string NewTag = string.Empty;
    private bool IsUploading;

    private void AddTag()
    {
        if (!string.IsNullOrWhiteSpace(NewTag) && !Item.Tags.Contains(NewTag))
        {
            Item.Tags.Add(NewTag.Trim());
            NewTag = string.Empty;
        }
    }

    private void RemoveTag(string tag) => Item.Tags.Remove(tag);

    private void HandleTagKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTag();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try 
        {
            IsUploading = true;
            StateHasChanged();

            var format = "image/png";
            var resizedFile = await file.RequestImageFileAsync(format, 400, 400);
            using var stream = resizedFile.OpenReadStream(1024 * 1024 * 5); // 5MB limit
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            Item.ImageUrl = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        finally
        {
            IsUploading = false;
            StateHasChanged();
        }
    }

    private async Task Close()
    {
        nameError = null;
        priceError = null;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }

    private async Task Save()
    {
        nameError = null;
        priceError = null;

        if (string.IsNullOrWhiteSpace(Item.Name))
        {
            nameError = "Item name is required.";
        }

        if (Item.Price <= 0)
        {
            priceError = "Please enter a valid price greater than $0.00.";
        }

        if (nameError != null || priceError != null)
        {
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(Item.Category))
        {
            Item.Category = Categories.FirstOrDefault() ?? "Hot Coffee";
        }

        if (string.IsNullOrWhiteSpace(Item.ImageUrl))
        {
            Item.ImageUrl = "https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=400";
        }

        try
        {
            isSaving = true;
            StateHasChanged();
            await OnSave.InvokeAsync(Item);
            await Close();
        }
        finally
        {
            isSaving = false;
        }
    }
}
