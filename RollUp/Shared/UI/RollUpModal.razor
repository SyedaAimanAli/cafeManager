@* RollUpModal — centered overlay modal with header / body / footer slots *@
@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        @* Backdrop *@
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @onclick="Close"></div>

        @* Panel *@
        <div class="relative bg-surface rounded-card w-full max-h-[90vh] overflow-y-auto shadow-modal @MaxWidthClass">
            @if (ShowHeader)
            {
                <div class="sticky top-0 z-10 bg-surface border-b border-line px-6 py-4 flex items-center justify-between rounded-t-card">
                    <h2 class="font-display text-xl font-semibold text-ink">
                        @Title
                    </h2>
                    @if (ShowCloseButton)
                    {
                        <button @onclick="Close" class="p-2 hover:bg-bg rounded-lg transition-colors text-ink-faint hover:text-ink">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
            }

            <div class="p-6">
                @ChildContent
            </div>

            @if (Footer != null)
            {
                <div class="sticky bottom-0 bg-surface border-t border-line px-6 py-4 rounded-b-card">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public string MaxWidthClass { get; set; } = "max-w-2xl";

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
