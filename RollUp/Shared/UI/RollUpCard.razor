@* RollUpCard — surface container with optional header and footer slots *@
<div class="@GetCardClass()">
    @if (Header != null)
    {
        <div class="px-4 py-3 border-b border-line bg-surface/50">
            @Header
        </div>
    }
    <div class="p-4 @BodyClass">
        @ChildContent
    </div>
    @if (Footer != null)
    {
        <div class="px-4 py-3 border-t border-line bg-surface/50 mt-auto">
            @Footer
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string BodyClass { get; set; } = string.Empty;

    private string GetCardClass()
    {
        return $"bg-surface rounded-card border border-line shadow-card overflow-hidden flex flex-col {Class}";
    }
}
