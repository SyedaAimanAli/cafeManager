@* RollUpBadge — inline status badge with optional dot indicator *@
<span class="@GetBadgeClass()">
    @if (DotColor != null)
    {
        <div class="w-2 h-2 rounded-full mr-2 @DotColor @(Pulse ? "animate-pulse" : "")"></div>
    }
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Variant { get; set; } = "default"; // default, success, warning, danger, info
    [Parameter] public string? DotColor { get; set; }
    [Parameter] public bool Pulse { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private string GetBadgeClass()
    {
        const string baseClass = "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium";

        var variantClass = Variant switch
        {
            "success" => "bg-ok-bg text-ok-text border border-ok/20",
            "warning" => "bg-warn-bg text-warn-text border border-warn/20",
            "danger"  => "bg-bad-bg text-bad-text border border-bad/20",
            "info"    => "bg-blue-50 text-blue-700 border border-blue-100",
            _         => "bg-bg text-ink-muted border border-line",
        };

        return $"{baseClass} {variantClass} {Class}";
    }
}
