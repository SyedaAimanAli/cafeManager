@* RollUpToggleSwitch — accessible on/off toggle with optional label and description *@
<button type="button"
        role="switch"
        aria-checked="@Checked"
        @onclick="HandleToggle"
        class="flex items-center gap-3 @Class"
        disabled="@Disabled">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="text-sm font-body text-current @(Disabled ? "opacity-50" : string.Empty)">@Label</span>
    }
    <div class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-pill transition-colors duration-200 ease-in-out @(Checked ? "bg-accent border border-accent" : "bg-zinc-800 border border-zinc-700") @(Disabled ? "opacity-50 cursor-not-allowed" : string.Empty)">
        <span class="pointer-events-none inline-block h-5 w-5 rounded-full @(Checked ? "bg-white" : "bg-zinc-400") shadow-sm ring-0 transition-transform duration-200 ease-in-out my-auto @(Checked ? "translate-x-5 ml-0.5" : "translate-x-0.5")"></span>
    </div>
    @if (!string.IsNullOrEmpty(Description))
    {
        <span class="text-xs text-ink-muted">@Description</span>
    }
</button>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }

    private async Task HandleToggle()
    {
        if (!Disabled)
            await CheckedChanged.InvokeAsync(!Checked);
    }
}
