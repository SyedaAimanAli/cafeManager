@* RollUpInput — labelled text / textarea input with validation error display *@
<div class="w-full">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-ink mb-2">@Label</label>
    }

    @if (IsTextArea)
    {
        <textarea value="@Value"
                  @oninput="OnInputChanged"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  class="w-full px-4 py-3 bg-surface border @(string.IsNullOrEmpty(Error) ? "border-line" : "border-bad") rounded-xl text-ink placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent resize-none @CssClass"></textarea>
    }
    else
    {
        <input type="@Type"
               value="@Value"
               @oninput="OnInputChanged"
               step="@Step"
               placeholder="@Placeholder"
               class="w-full px-4 py-3 bg-surface border @(string.IsNullOrEmpty(Error) ? "border-line" : "border-bad") rounded-xl text-ink placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent @CssClass" />
    }

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="text-bad text-xs mt-1">@Error</p>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Step { get; set; } = "any";
    [Parameter] public bool IsTextArea { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string? Error { get; set; }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
    }
}
