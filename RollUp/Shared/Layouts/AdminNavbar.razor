@using RollUp.Infrastructure.Authentication
@using RollUp.Core.Interfaces
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider
@inject ITenantContext TenantContext

<header class="bg-white border-b border-stone-200 sticky top-0 z-40 shadow-xs no-print">
    <!-- Top Bar -->
    <div class="max-w-7xl mx-auto px-4 md:px-6">
        <div class="flex items-center justify-between h-16 gap-4">
            
            <!-- Brand & Tenant Badge -->
            <div class="flex items-center gap-3 md:gap-4">
                <a href="/manage" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 bg-cafe-espresso rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-cafe-mocha transition-colors shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-400" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12.378 1.602a.75.75 0 00-.756 0L3 6.632l9 5.25 9-5.25-8.622-5.03zM21.75 7.93l-9 5.25v9l8.628-5.032a.75.75 0 00.372-.648V7.93zM11.25 22.18v-9l-9-5.25v8.57a.75.75 0 00.372.648l8.628 5.033z" />
                        </svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="font-display font-bold text-lg text-cafe-espresso">RollUp</span>
                            <span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 bg-amber-100 text-amber-800 rounded-full">Admin</span>
                        </div>
                        <p class="text-xs text-stone-500 truncate max-w-[140px] md:max-w-[200px]">
                            @(string.IsNullOrWhiteSpace(TenantContext.CurrentTenantName) ? "RollUp Cafe" : TenantContext.CurrentTenantName)
                        </p>
                    </div>
                </a>
            </div>

            <!-- Quick Live Launchers (Desktop) -->
            <div class="hidden lg:flex items-center gap-2 bg-stone-100/80 p-1.5 rounded-2xl border border-stone-200/80">
                <a href="/queue" target="_blank" 
                   class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl text-stone-700 hover:text-cafe-espresso hover:bg-white hover:shadow-xs transition-all">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span>Live Display</span>
                </a>

                <a href="/kitchen" 
                   class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl text-stone-700 hover:text-cafe-espresso hover:bg-white hover:shadow-xs transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                    <span>Kitchen KDS</span>
                </a>

                <a href="/menu" target="_blank" 
                   class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl text-stone-700 hover:text-cafe-espresso hover:bg-white hover:shadow-xs transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                    <span>Customer Menu</span>
                </a>
            </div>

            <!-- Right Actions & Mobile Toggle -->
            <div class="flex items-center gap-2">
                <!-- Logout Button -->
                <button @onclick="HandleLogout" 
                        class="px-3 py-2 text-xs font-semibold text-stone-600 hover:text-red-600 hover:bg-red-50 rounded-xl transition-colors flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span class="hidden sm:inline">Logout</span>
                </button>

                <!-- Mobile Menu Button -->
                <button @onclick="() => showMobileMenu = !showMobileMenu" 
                        class="md:hidden p-2 text-stone-600 hover:bg-stone-100 rounded-xl transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Navigation Tabs (Desktop Sub-Nav) -->
        <nav class="hidden md:flex items-center gap-1 border-t border-stone-100 overflow-x-auto scrollbar-hide py-1">
            <NavLink href="/manage" Match="NavLinkMatch.All"
                     class="px-4 py-2.5 text-sm font-medium rounded-xl transition-all flex items-center gap-2"
                     ActiveClass="bg-cafe-espresso text-white shadow-xs font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                </svg>
                <span>Menu Items</span>
            </NavLink>

            <NavLink href="/manage/categories"
                     class="px-4 py-2.5 text-sm font-medium rounded-xl transition-all flex items-center gap-2"
                     ActiveClass="bg-cafe-espresso text-white shadow-xs font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
                <span>Categories</span>
            </NavLink>

            <NavLink href="/manage/users"
                     class="px-4 py-2.5 text-sm font-medium rounded-xl transition-all flex items-center gap-2"
                     ActiveClass="bg-cafe-espresso text-white shadow-xs font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <span>Users & Roles</span>
            </NavLink>

            <NavLink href="/manage/design"
                     class="px-4 py-2.5 text-sm font-medium rounded-xl transition-all flex items-center gap-2"
                     ActiveClass="bg-cafe-espresso text-white shadow-xs font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4 5 5 0 014-4h4a4 4 0 014 4 5 5 0 01-4 4H7zm0 0v-4m0 4h4m6-12l2-2m0 0l2 2m-2-2v6m-6-6h6" />
                </svg>
                <span>Menu Design & Colors</span>
            </NavLink>

            <NavLink href="/manage/qr"
                     class="px-4 py-2.5 text-sm font-medium rounded-xl transition-all flex items-center gap-2"
                     ActiveClass="bg-cafe-espresso text-white shadow-xs font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                </svg>
                <span>Printable QR Card</span>
            </NavLink>

            <NavLink href="/manage/printable-menu"
                     class="px-4 py-2.5 text-sm font-medium rounded-xl transition-all flex items-center gap-2"
                     ActiveClass="bg-cafe-espresso text-white shadow-xs font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                <span>Printable Menu Booklet</span>
            </NavLink>

            <NavLink href="/manage/reports"
                     class="px-4 py-2.5 text-sm font-medium rounded-xl transition-all flex items-center gap-2"
                     ActiveClass="bg-cafe-espresso text-white shadow-xs font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                <span>Sales & Reports</span>
            </NavLink>
        </nav>
    </div>

    <!-- Mobile Dropdown -->
    @if (showMobileMenu)
    {
        <div class="md:hidden border-t border-stone-200 bg-white px-4 py-4 space-y-2">
            <a href="/manage" @onclick="() => showMobileMenu = false" class="block px-3 py-2 rounded-lg font-medium text-stone-800 hover:bg-stone-100">🍽️ Menu Items</a>
            <a href="/manage/categories" @onclick="() => showMobileMenu = false" class="block px-3 py-2 rounded-lg font-medium text-stone-800 hover:bg-stone-100">🏷️ Categories</a>
            <a href="/manage/users" @onclick="() => showMobileMenu = false" class="block px-3 py-2 rounded-lg font-medium text-stone-800 hover:bg-stone-100">👥 Users & Roles</a>
            <a href="/manage/design" @onclick="() => showMobileMenu = false" class="block px-3 py-2 rounded-lg font-medium text-stone-800 hover:bg-stone-100">🎨 Menu Design & Colors</a>
            <a href="/manage/qr" @onclick="() => showMobileMenu = false" class="block px-3 py-2 rounded-lg font-medium text-stone-800 hover:bg-stone-100">🔲 Printable QR Card</a>
            <a href="/manage/printable-menu" @onclick="() => showMobileMenu = false" class="block px-3 py-2 rounded-lg font-medium text-stone-800 hover:bg-stone-100">📖 Printable Menu Booklet</a>
            <a href="/manage/reports" @onclick="() => showMobileMenu = false" class="block px-3 py-2 rounded-lg font-medium text-stone-800 hover:bg-stone-100">📊 Sales & Reports</a>
            
            <div class="border-t border-stone-200 pt-3 mt-3 space-y-2">
                <a href="/queue" target="_blank" class="block px-3 py-2 rounded-lg text-sm font-semibold text-emerald-700 bg-emerald-50">📺 Open Live Queue Display</a>
                <a href="/kitchen" class="block px-3 py-2 rounded-lg text-sm font-semibold text-amber-700 bg-amber-50">👨‍🍳 Open Kitchen KDS</a>
                <a href="/menu" target="_blank" class="block px-3 py-2 rounded-lg text-sm font-semibold text-blue-700 bg-blue-50">📱 Open Customer Menu</a>
            </div>
        </div>
    }
</header>

@code {
    private bool showMobileMenu = false;

    private async Task HandleLogout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
