@code {
    private ErrorBoundary? errorBoundary;

    // Dynamic Branding
    private string accentHex  = "#10b981";
    private string accentInk  = "#ffffff";
    private string accentMuted = "rgba(16,185,129,0.20)";
    private string headingFontFamily = "'Bricolage Grotesque', sans-serif";
    private string surfaceHex = "#18181b";
    private string bgHex = "#09090b";
    private string lineHex = "#27272a";

    // User
    private string userName    = string.Empty;
    private string userEmail   = string.Empty;
    private string userInitials = "?";
    private string tenantName  = string.Empty;

    // Branches / Outlets
    private List<Outlet> branches = new();
    private Outlet? currentOutlet;
    private bool isBranchMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        // ── Auth state & Tenant claims FIRST ──────────────────────────────
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                // Standard JWT claim types
                userName  = user.FindFirst("name")?.Value
                          ?? user.FindFirst("full_name")?.Value
                          ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                          ?? string.Empty;
                userEmail = user.FindFirst("email")?.Value
                          ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                          ?? string.Empty;

                userInitials = BuildInitials(userName.Length > 0 ? userName : userEmail);
            }
            else
            {
                NavigationManager.NavigateTo("/login", replace: true);
                return;
            }
        }
        catch 
        { 
            NavigationManager.NavigateTo("/login", replace: true);
            return;
        }

        NavigationManager.LocationChanged += HandleLocationChanged;

        // ── Subscribe to real-time branding updates ───────────────────────
        BrandingService.OnBrandingChanged += HandleBrandingChanged;

        // ── Initial Branding ──────────────────────────────────────────────
        try
        {
            var branding = await BrandingService.GetBrandingAsync();
            ApplyBranding(branding);
        }
        catch { /* silently use defaults */ }

        // ── Branch context ────────────────────────────────────────────────
        OutletService.OnActiveOutletChanged += HandleOutletChanged;
        try
        {
            await OutletService.InitializeActiveOutletAsync();
            branches = await OutletService.GetOutletsAsync();
            currentOutlet = OutletService.ActiveOutlet;
        }
        catch { /* silently ignore */ }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                NavigationManager.NavigateTo("/login", replace: true);
            }
        }
        catch { }
    }

    private void ToggleBranchMenu()
    {
        isBranchMenuOpen = !isBranchMenuOpen;
    }

    private async Task SelectBranch(int outletId)
    {
        isBranchMenuOpen = false;
        await OutletService.SetActiveOutletAsync(outletId);
    }

    private async void HandleOutletChanged()
    {
        currentOutlet = OutletService.ActiveOutlet;
        branches = await OutletService.GetOutletsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void Recover() => errorBoundary?.Recover();

    private async Task LogoutAsync()
    {
        await CustomAuth.MarkUserAsLoggedOut();
        NavigationManager.NavigateTo("/login", replace: true);
    }

    // ── Helpers ────────────────────────────────────────────────────────────

    private static string BuildInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[^1][0])}";
        return name.Length >= 2
            ? $"{char.ToUpper(name[0])}{char.ToUpper(name[1])}"
            : name[0].ToString().ToUpper();
    }

    private static bool IsLightColor(string hex)
    {
        if (string.IsNullOrEmpty(hex) || hex.Length < 7) return false;
        var r = Convert.ToInt32(hex.Substring(1, 2), 16);
        var g = Convert.ToInt32(hex.Substring(3, 2), 16);
        var b = Convert.ToInt32(hex.Substring(5, 2), 16);
        return (r * 0.299 + g * 0.587 + b * 0.114) > 160;
    }

    private static string HexToRgba(string hex, float alpha)
    {
        if (string.IsNullOrEmpty(hex) || hex.Length < 7) return $"rgba(196,149,106,{alpha})";
        var r = Convert.ToInt32(hex.Substring(1, 2), 16);
        var g = Convert.ToInt32(hex.Substring(3, 2), 16);
        var b = Convert.ToInt32(hex.Substring(5, 2), 16);
        return $"rgba({r},{g},{b},{alpha.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
    }

    private void HandleBrandingChanged(RollUp.Application.DTOs.TenantBrandingDto dto)
    {
        ApplyBranding(dto);
        InvokeAsync(StateHasChanged);
    }

    private void ApplyBranding(RollUp.Application.DTOs.TenantBrandingDto branding)
    {
        var hex = !string.IsNullOrWhiteSpace(branding.CustomAccentColor) ? branding.CustomAccentColor : "#10b981";
        accentHex   = hex;
        accentInk   = IsLightColor(hex) ? "#18181b" : "#ffffff";
        accentMuted = HexToRgba(hex, 0.20f);
        tenantName  = branding.BusinessName;
        headingFontFamily = GetHeadingFontFamily(branding.HeadingFont);

        var (bg, surface, line) = GetThemeColors(branding.ThemeTemplate);
        bgHex = bg;
        surfaceHex = surface;
        lineHex = line;
    }

    private static (string bg, string surface, string line) GetThemeColors(string? theme) => theme?.ToLowerInvariant() switch
    {
        "bistro" => ("#0c0a09", "#1c1917", "#292524"),      // warm espresso dark
        "modern" => ("#09090b", "#18181b", "#27272a"),      // obsidian clean dark
        "rustic" => ("#100e0c", "#1f1a16", "#2e2620"),      // bronze craft timber dark
        "minimalist" => ("#09090b", "#121214", "#202024"),  // deep minimalist dark
        "elegant" => ("#0a0a0c", "#141416", "#242428"),     // sleek onyx luxury charcoal
        "minimal" => ("#09090b", "#18181b", "#27272a"),     // alias
        "luxury" => ("#0a0a0c", "#141416", "#242428"),      // alias
        "clean" => ("#0f172a", "#1e293b", "#334155"),       // midnight navy slate
        _ => ("#09090b", "#18181b", "#27272a")
    };

    private static string GetHeadingFontFamily(string? font) => font?.ToLowerInvariant() switch
    {
        "fraunces" => "'Fraunces', Georgia, serif",
        "dm-sans" => "'DM Sans', sans-serif",
        "playfair" => "'Playfair Display', Georgia, serif",
        "bricolage" => "'Bricolage Grotesque', sans-serif",
        _ => "'Bricolage Grotesque', sans-serif"
    };

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        BrandingService.OnBrandingChanged -= HandleBrandingChanged;
        OutletService.OnActiveOutletChanged -= HandleOutletChanged;
    }
}
