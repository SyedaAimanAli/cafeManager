@inherits LayoutComponentBase
@implements IDisposable
@using RollUp.Core.Entities
@using RollUp.Core.Interfaces
@inject IBrandingService BrandingService
@inject IOutletService OutletService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject CustomAuthStateProvider CustomAuth

<HeadContent>
    <style>
        :root {
            --color-accent: @accentHex;
            --color-accent-ink: @accentInk;
            --color-accent-muted: @accentMuted;
            --font-display: @headingFontFamily;
            --color-surface: @surfaceHex;
            --color-bg: @bgHex;
            --color-ink: #fafaf9;
            --color-ink-muted: #a1a1aa;
            --color-ink-faint: #71717a;
            --color-line: @lineHex;
        }
        h1, h2, h3, h4, .font-display {
            font-family: var(--font-display), 'Bricolage Grotesque', sans-serif !important;
        }
    </style>
</HeadContent>

<!-- Outer shell: sidebar + main -->
<div class="flex min-h-screen bg-bg text-ink font-body">

    <!-- ── LEFT SIDEBAR (desktop ≥lg) ─────────────────────────────────────── -->
    <aside class="hidden lg:flex w-60 min-h-screen sticky top-0 flex-col bg-surface border-r border-line z-40">

        <!-- Logo / brand -->
        <div class="px-5 pt-6 pb-4 flex flex-col gap-1">
            <div class="flex items-center gap-2">
                <!-- RollUp logomark -->
                <span class="w-5 h-5 rounded-md bg-accent flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                         class="w-3 h-3 text-accent-ink">
                        <path fill-rule="evenodd"
                              d="M3.5 2A1.5 1.5 0 002 3.5v13A1.5 1.5 0 003.5 18h13a1.5 1.5 0 001.5-1.5V3.5A1.5 1.5 0 0016.5 2h-13zm3.75 8.25a.75.75 0 000 1.5h5.5a.75.75 0 000-1.5h-5.5zm0-3a.75.75 0 000 1.5h5.5a.75.75 0 000-1.5h-5.5z"
                              clip-rule="evenodd" />
                    </svg>
                </span>
                <span class="font-display font-bold text-ink text-base leading-none tracking-tight">RollUp</span>
            </div>

            <!-- Active Branch Indicator (Click to open Settings Branches) -->
            <div class="mt-3">
                <a href="/manage"
                   class="w-full flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl bg-bg border border-line text-left hover:border-accent hover:bg-line/20 transition-all group cursor-pointer shadow-2xs"
                   title="Click to view & manage branches in Settings">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <span class="w-2 h-2 rounded-full bg-ok animate-pulse flex-shrink-0"></span>
                        <div class="truncate">
                            <div class="text-[9px] text-ink-faint font-semibold uppercase tracking-wider leading-none mb-0.5">Active Branch</div>
                            <div class="text-xs font-bold text-ink truncate leading-tight group-hover:text-accent transition-colors">@(currentOutlet?.Name ?? "Main Branch")</div>
                        </div>
                    </div>
                    <span class="text-[10px] text-ink-muted group-hover:text-accent font-medium flex items-center gap-0.5 transition-colors flex-shrink-0">
                        <span>Settings</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </span>
                </a>
            </div>
        </div>

        <!-- Nav links -->
        <nav class="flex-1 px-3 py-2 flex flex-col gap-0.5">
            <NavLink href="/queue" Match="NavLinkMatch.Prefix"
                     class="flex items-center gap-3 px-4 py-3 rounded-xl text-muted hover:text-ink hover:bg-accent-muted transition-all font-body text-sm font-medium"
                     ActiveClass="bg-accent-muted text-accent font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px] flex-shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                Queue
            </NavLink>

            <NavLink href="/menu" Match="NavLinkMatch.Prefix"
                     class="flex items-center gap-3 px-4 py-3 rounded-xl text-muted hover:text-ink hover:bg-accent-muted transition-all font-body text-sm font-medium"
                     ActiveClass="bg-accent-muted text-accent font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px] flex-shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.966 8.966 0 00-6 2.292m0-14.25v14.25" />
                </svg>
                Menu
            </NavLink>

            <NavLink href="/share" Match="NavLinkMatch.Prefix"
                     class="flex items-center gap-3 px-4 py-3 rounded-xl text-muted hover:text-ink hover:bg-accent-muted transition-all font-body text-sm font-medium"
                     ActiveClass="bg-accent-muted text-accent font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px] flex-shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M6.75 6.75h.75v.75h-.75v-.75zM6.75 16.5h.75v.75h-.75V16.5zM16.5 6.75h.75v.75h-.75v-.75zM13.5 13.5h.75v.75h-.75V13.5zM13.5 19.5h.75v.75h-.75v-.75zM19.5 13.5h.75v.75h-.75V13.5zM19.5 19.5h.75v.75h-.75v-.75zM16.5 16.5h.75v.75h-.75V16.5z" />
                </svg>
                QR &amp; Print
            </NavLink>

            <NavLink href="/insights" Match="NavLinkMatch.Prefix"
                     class="flex items-center gap-3 px-4 py-3 rounded-xl text-muted hover:text-ink hover:bg-accent-muted transition-all font-body text-sm font-medium"
                     ActiveClass="bg-accent-muted text-accent font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px] flex-shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
                Insights
            </NavLink>

            <NavLink href="/manage" Match="NavLinkMatch.Prefix"
                     class="flex items-center gap-3 px-4 py-3 rounded-xl text-muted hover:text-ink hover:bg-accent-muted transition-all font-body text-sm font-medium"
                     ActiveClass="bg-accent-muted text-accent font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px] flex-shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Manage
            </NavLink>
        </nav>

        <!-- Bottom: user + logout -->
        <div class="px-3 pb-5 pt-3 border-t border-line flex items-center gap-3">
            <!-- Avatar initials -->
            <div class="w-8 h-8 rounded-full bg-accent flex items-center justify-center flex-shrink-0">
                <span class="text-accent-ink text-xs font-display font-bold select-none">@userInitials</span>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-ink text-xs font-semibold font-body truncate leading-tight">@userName</p>
                <p class="text-muted text-[10px] font-body truncate leading-tight">@userEmail</p>
            </div>
            <button @onclick="LogoutAsync" title="Sign out"
                    class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-muted hover:text-bad hover:bg-bad/10 transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                </svg>
            </button>
        </div>
    </aside>

    <!-- ── MAIN CONTENT AREA ──────────────────────────────────────────────── -->
    <div class="flex-1 flex flex-col min-w-0">
        <!-- Mobile Top Bar (<lg) -->
        <header class="lg:hidden flex items-center justify-between px-4 py-3 bg-surface border-b border-line sticky top-0 z-40">
            <div class="flex items-center gap-2 min-w-0">
                <span class="w-5 h-5 rounded-md bg-accent flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 text-accent-ink">
                        <path fill-rule="evenodd" d="M3.5 2A1.5 1.5 0 002 3.5v13A1.5 1.5 0 003.5 18h13a1.5 1.5 0 001.5-1.5V3.5A1.5 1.5 0 0016.5 2h-13zm3.75 8.25a.75.75 0 000 1.5h5.5a.75.75 0 000-1.5h-5.5zm0-3a.75.75 0 000 1.5h5.5a.75.75 0 000-1.5h-5.5z" clip-rule="evenodd" />
                    </svg>
                </span>
                <span class="font-display font-bold text-ink text-sm truncate">RollUp</span>
            </div>

            <div>
                <a href="/manage"
                   class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-bg border border-line text-xs font-bold text-ink hover:border-accent transition-colors cursor-pointer"
                   title="Click to view & manage branches in Settings">
                    <span class="w-1.5 h-1.5 rounded-full bg-ok animate-pulse"></span>
                    <span class="truncate max-w-[120px]">@(currentOutlet?.Name ?? "Branch")</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-ink-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </div>
        </header>

        <!-- ── MAIN CONTENT ──────────────────────────────────────────────────── -->
        <main class="flex-1 min-w-0 overflow-auto pb-20 lg:pb-0">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="min-h-screen bg-bg flex items-center justify-center p-4">
                        <div class="bg-surface p-8 rounded-card shadow-lg max-w-md text-center border border-line">
                            <div class="w-16 h-16 bg-bad/10 rounded-full flex items-center justify-center mx-auto mb-4">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-bad" fill="none"
                                     viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            </div>
                            <h1 class="text-xl font-bold font-display text-ink mb-2">Something went wrong</h1>
                            <p class="text-muted font-body mb-4">@ex.Message</p>
                            <button @onclick="Recover"
                                    class="px-6 py-2 bg-accent text-accent-ink rounded-pill hover:opacity-90 transition-all font-body font-medium">
                                Try Again
                            </button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

<!-- ── BOTTOM TAB BAR (mobile <lg) ─────────────────────────────────────── -->
<nav class="fixed bottom-0 inset-x-0 z-50 bg-surface border-t border-line flex items-end justify-around px-2 pb-safe h-16 lg:hidden">

    <!-- Queue -->
    <NavLink href="/queue" Match="NavLinkMatch.Prefix"
             class="flex flex-col items-center gap-0.5 text-[10px] py-2 px-3 text-muted hover:text-ink transition-colors font-body"
             ActiveClass="text-accent">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px]">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
        Queue
    </NavLink>

    <!-- Menu -->
    <NavLink href="/menu" Match="NavLinkMatch.Prefix"
             class="flex flex-col items-center gap-0.5 text-[10px] py-2 px-3 text-muted hover:text-ink transition-colors font-body"
             ActiveClass="text-accent">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px]">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.966 8.966 0 00-6 2.292m0-14.25v14.25" />
        </svg>
        Menu
    </NavLink>

    <!-- QR & Print — RAISED center button -->
    <div class="relative flex flex-col items-center flex-1">
        <NavLink href="/share" Match="NavLinkMatch.Prefix"
                 class="absolute -top-5 left-1/2 -translate-x-1/2 w-14 h-14 rounded-full bg-accent text-accent-ink flex items-center justify-center shadow-elevated hover:opacity-90 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z" />
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M6.75 6.75h.75v.75h-.75v-.75zM6.75 16.5h.75v.75h-.75V16.5zM16.5 6.75h.75v.75h-.75v-.75zM13.5 13.5h.75v.75h-.75V13.5zM13.5 19.5h.75v.75h-.75v-.75zM19.5 13.5h.75v.75h-.75V13.5zM19.5 19.5h.75v.75h-.75v-.75zM16.5 16.5h.75v.75h-.75V16.5z" />
            </svg>
        </NavLink>
        <!-- spacer so justify-around works -->
        <span class="h-16 w-14 block"></span>
    </div>

    <!-- Insights -->
    <NavLink href="/insights" Match="NavLinkMatch.Prefix"
             class="flex flex-col items-center gap-0.5 text-[10px] py-2 px-3 text-muted hover:text-ink transition-colors font-body"
             ActiveClass="text-accent">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px]">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
        </svg>
        Insights
    </NavLink>

    <!-- Manage -->
    <NavLink href="/manage" Match="NavLinkMatch.Prefix"
             class="flex flex-col items-center gap-0.5 text-[10px] py-2 px-3 text-muted hover:text-ink transition-colors font-body"
             ActiveClass="text-accent">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px]">
            <path stroke-linecap="round" stroke-linejoin="round"
