@page "/"
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>RollUp - Multi-Tenant Cafe Platform</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-cafe-cream via-white to-cafe-latte/30 flex flex-col justify-between p-6">
    <!-- Top Bar with Auth State & Tenant Info -->
    <div class="max-w-6xl mx-auto w-full flex items-center justify-between py-2">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-cafe-espresso rounded-xl flex items-center justify-center text-white shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" d="M2.625 6.75a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0A.75.75 0 018.25 6h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75zM2.625 12a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zM7.5 12a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12A.75.75 0 017.5 12zm-4.875 5.25a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75z" clip-rule="evenodd" />
                </svg>
            </div>
            <div>
                <span class="font-display font-bold text-cafe-espresso text-lg leading-tight block">RollUp</span>
                <span class="text-xs text-stone-500">Cloud Cafe Management</span>
            </div>
        </div>

        <!-- Auth Indicator -->
        <AuthorizeView>
            <Authorized>
                <div class="flex items-center gap-4">
                    <div class="text-right hidden sm:block">
                        <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
                            @(context.User.FindFirst("tenant_name")?.Value ?? "Active Tenant")
                        </div>
                        <div class="text-sm font-bold text-cafe-espresso">
                            @context.User.Identity?.Name
                            <span class="text-xs font-normal text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full ml-1">
                                @(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")
                            </span>
                        </div>
                    </div>
                    <button @onclick="Logout" class="px-4 py-2 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 border border-red-200 rounded-xl transition-colors">
                        Sign Out
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="flex items-center gap-3">
                    <a href="/login" class="px-4 py-2 text-sm font-semibold text-cafe-espresso hover:text-cafe-mocha transition-colors">
                        Sign In
                    </a>
                    <a href="/signup" class="px-4 py-2 text-sm font-bold bg-cafe-espresso hover:bg-cafe-mocha text-white rounded-xl shadow-md transition-all">
                        Register Cafe
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <!-- Main Content -->
    <div class="max-w-5xl mx-auto w-full my-8">
        <!-- Hero Header -->
        <div class="text-center mb-10">
            <h1 class="font-display text-4xl sm:text-5xl font-bold text-cafe-espresso mb-3 tracking-tight">
                Modern Cafe & Multi-Tenant Operations
            </h1>
            <p class="text-lg text-cafe-mocha max-w-2xl mx-auto">
                All-in-one ordering, live kitchen queue, customer displays, and isolated tenant management.
            </p>
        </div>

        <!-- Onboarding Promotion Banner -->
        <div class="mb-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-cafe-espresso via-stone-900 to-cafe-espresso text-white shadow-2xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6 border border-stone-800">
            <div class="space-y-2 text-center md:text-left z-10">
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full text-xs font-semibold uppercase tracking-wider">
                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                    Multi-Tenancy Ready
                </div>
                <h2 class="text-2xl sm:text-3xl font-bold font-display">Are you opening a new Cafe?</h2>
                <p class="text-stone-300 text-sm max-w-xl">
                    Launch your business in under 60 seconds. Set your custom logo, currency, country, city, and get instant QR ordering menus.
                </p>
            </div>
            <div class="shrink-0 z-10">
                <a href="/signup" class="inline-flex items-center gap-2 px-6 py-3.5 bg-gradient-to-r from-cafe-caramel to-amber-500 text-stone-950 font-bold rounded-2xl shadow-lg hover:shadow-amber-500/20 hover:scale-105 transition-all text-sm">
                    <span>Onboard Your Cafe</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </a>
            </div>
        </div>

        <!-- Modules Grid -->
        <div class="grid md:grid-cols-3 gap-6">
            <!-- Customer Menu -->
            <a href="/menu" class="group">
                <div class="bg-white rounded-2xl p-7 shadow-lg border border-stone-200 hover:shadow-xl hover:border-cafe-caramel transition-all hover:-translate-y-1">
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-5 group-hover:bg-blue-500 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
                            <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-cafe-espresso mb-1">Customer Menu</h2>
                    <p class="text-stone-500 text-sm mb-4">Interactive digital QR menu with customizable variants, addons, and cart.</p>
                    <div class="flex items-center text-cafe-caramel font-medium text-sm">
                        <span>Open Menu</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </div>
                </div>
            </a>

            <!-- Queue Display -->
            <a href="/queue" class="group">
                <div class="bg-white rounded-2xl p-7 shadow-lg border border-stone-200 hover:shadow-xl hover:border-cafe-caramel transition-all hover:-translate-y-1">
                    <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center mb-5 group-hover:bg-emerald-500 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
                            <path fill-rule="evenodd" d="M2.25 5.25a3 3 0 013-3h13.5a3 3 0 013 3V15a3 3 0 01-3 3h-3v.257c0 .597.237 1.17.659 1.591l.621.622a.75.75 0 01-.53 1.28h-9a.75.75 0 01-.53-1.28l.621-.622a2.25 2.25 0 00.659-1.59V18h-3a3 3 0 01-3-3V5.25zm1.5 0v7.5a1.5 1.5 0 001.5 1.5h13.5a1.5 1.5 0 001.5-1.5v-7.5a1.5 1.5 0 00-1.5-1.5H5.25a1.5 1.5 0 00-1.5 1.5z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-cafe-espresso mb-1">Live Queue Display</h2>
                    <p class="text-stone-500 text-sm mb-4">Full-screen TV/LED display for order readiness and live ticket status.</p>
                    <div class="flex items-center text-cafe-caramel font-medium text-sm">
                        <span>Open Display</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </div>
                </div>
            </a>

            <!-- Kitchen Queue -->
            <a href="/kitchen" class="group">
                <div class="bg-white rounded-2xl p-7 shadow-lg border border-stone-200 hover:shadow-xl hover:border-cafe-caramel transition-all hover:-translate-y-1">
                    <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-5 group-hover:bg-amber-500 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-600 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12.378 1.602a.75.75 0 00-.756 0L3 6.632l9 5.25 9-5.25-8.622-5.03zM21.75 7.93l-9 5.25v9l8.628-5.032a.75.75 0 00.372-.648V7.93zM11.25 22.18v-9l-9-5.25v8.57a.75.75 0 00.372.648l8.628 5.033z" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-cafe-espresso mb-1">Kitchen Queue</h2>
                    <p class="text-stone-500 text-sm mb-4">Kanban ticket management with audio chime notifications for chefs.</p>
                    <div class="flex items-center text-cafe-caramel font-medium text-sm">
                        <span>Open Kitchen</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </div>
                </div>
            </a>
        </div>

        <!-- Management Bar -->
        <div class="mt-8 bg-white/70 backdrop-blur-xs border border-stone-200/80 rounded-3xl p-6 shadow-sm">
            <div class="text-center mb-4">
                <h3 class="font-bold text-cafe-espresso text-base">Cafe Administration & Tools</h3>
                <p class="text-xs text-stone-500">Configure your menu, team access, branding styles, and printable QR stands</p>
            </div>
            <div class="flex flex-wrap items-center justify-center gap-3">
                <a href="/manage" class="inline-flex items-center gap-2 px-4 py-2.5 bg-cafe-espresso text-white rounded-xl hover:bg-cafe-mocha shadow-xs transition-all text-xs font-semibold">
                    <span>🍽️ Menu Items</span>
                </a>
                <a href="/manage/categories" class="inline-flex items-center gap-2 px-4 py-2.5 bg-stone-100 text-stone-700 rounded-xl hover:bg-stone-200 transition-all text-xs font-semibold">
                    <span>🏷️ Categories</span>
                </a>
                <a href="/manage/users" class="inline-flex items-center gap-2 px-4 py-2.5 bg-stone-100 text-stone-700 rounded-xl hover:bg-stone-200 transition-all text-xs font-semibold">
                    <span>👥 Team & Roles</span>
                </a>
                <a href="/manage/design" class="inline-flex items-center gap-2 px-4 py-2.5 bg-stone-100 text-stone-700 rounded-xl hover:bg-stone-200 transition-all text-xs font-semibold">
                    <span>🎨 Menu Design & Colors</span>
                </a>
                <a href="/manage/qr" class="inline-flex items-center gap-2 px-4 py-2.5 bg-stone-100 text-stone-700 rounded-xl hover:bg-stone-200 transition-all text-xs font-semibold">
                    <span>🔲 Table QR Card</span>
                </a>
                <a href="/manage/printable-menu" class="inline-flex items-center gap-2 px-4 py-2.5 bg-stone-100 text-stone-700 rounded-xl hover:bg-stone-200 transition-all text-xs font-semibold">
                    <span>📖 Menu Booklet</span>
                </a>
                <a href="/manage/reports" class="inline-flex items-center gap-2 px-4 py-2.5 bg-stone-100 text-stone-700 rounded-xl hover:bg-stone-200 transition-all text-xs font-semibold">
                    <span>📊 Sales & Reports</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="max-w-5xl mx-auto w-full text-center text-stone-400 text-xs py-4 border-t border-stone-200/60">
        <p>RollUp Multi-Tenant Cafe Management Platform &copy; @DateTime.UtcNow.Year</p>
    </div>
</div>

@code {
    private async Task Logout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}

