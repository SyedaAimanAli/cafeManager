@page "/register"
@layout EmptyLayout
@using RollUp.Application.DTOs
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Register Your Café — RollUp</PageTitle>

<div class="min-h-screen bg-black text-ink flex flex-col overflow-hidden relative">

    <!-- Decorative blobs (Warm Orange) -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full bg-accent opacity-20 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full bg-accent opacity-15 blur-3xl"></div>
    </div>

    <!-- Top Nav -->
    <nav class="relative z-10 flex items-center justify-between px-6 py-5 max-w-xl mx-auto w-full">
        <a href="/welcome" class="flex items-center gap-2.5 group">
            <span class="w-7 h-7 rounded-md bg-accent flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                     class="w-3.5 h-3.5 text-accent-ink">
                    <path fill-rule="evenodd"
                          d="M3.5 2A1.5 1.5 0 002 3.5v13A1.5 1.5 0 003.5 18h13a1.5 1.5 0 001.5-1.5V3.5A1.5 1.5 0 0016.5 2h-13zm3.75 8.25a.75.75 0 000 1.5h5.5a.75.75 0 000-1.5h-5.5zm0-3a.75.75 0 000 1.5h5.5a.75.75 0 000-1.5h-5.5z"
                          clip-rule="evenodd" />
                </svg>
            </span>
            <span class="font-display font-bold text-white text-base">RollUp</span>
        </a>
        <div class="text-sm text-white/50">
            Already have an account?
            <a href="/login" class="text-accent font-semibold hover:opacity-80 transition-opacity ml-1">Sign in</a>
        </div>
    </nav>

    <!-- Form -->
    <main class="relative z-10 flex-1 flex items-center justify-center px-4 py-8">
        <div class="w-full max-w-md">

            <div class="mb-8 text-center">
                <h1 class="font-display text-3xl font-bold text-white mb-2">Create your workspace</h1>
                <p class="text-white/50 font-body text-sm">You'll finish setup on the next screen</p>
            </div>

            <!-- Error -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-5 p-4 rounded-xl bg-bad/20 border border-bad/40 text-bad-text text-sm flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-bad shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="bg-surface border border-line rounded-card p-8 space-y-5 shadow-elevated">

                <div class="space-y-1">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-ink-muted">Café / Business Name</label>
                    <input id="reg-cafe-name" type="text" @bind="cafeName"
                           placeholder="e.g. The Corner Cup"
                           class="w-full bg-bg border border-line rounded-xl px-4 py-3 text-ink placeholder-ink-faint focus:outline-none focus:ring-2 focus:ring-accent text-sm transition-all" />
                </div>

                <div class="space-y-1">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-ink-muted">Your Full Name</label>
                    <input id="reg-full-name" type="text" @bind="fullName"
                           placeholder="e.g. Sarah Johnson"
                           class="w-full bg-bg border border-line rounded-xl px-4 py-3 text-ink placeholder-ink-faint focus:outline-none focus:ring-2 focus:ring-accent text-sm transition-all" />
                </div>

                <div class="space-y-1">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-ink-muted">Email Address</label>
                    <input id="reg-email" type="email" @bind="email"
                           placeholder="you@example.com"
                           class="w-full bg-bg border border-line rounded-xl px-4 py-3 text-ink placeholder-ink-faint focus:outline-none focus:ring-2 focus:ring-accent text-sm transition-all" />
                </div>

                <div class="space-y-1">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-ink-muted">Password</label>
                    <input id="reg-password" type="password" @bind="password"
                           placeholder="Minimum 6 characters"
                           class="w-full bg-bg border border-line rounded-xl px-4 py-3 text-ink placeholder-ink-faint focus:outline-none focus:ring-2 focus:ring-accent text-sm transition-all" />
                </div>

                <button id="btn-create-workspace" @onclick="HandleRegister"
                        disabled="@isLoading"
                        class="w-full py-4 px-6 bg-accent text-accent-ink font-bold rounded-pill shadow-elevated hover:opacity-90 disabled:opacity-50 active:scale-[0.98] transition-all flex items-center justify-center gap-2 mt-2">
                    @if (isLoading)
                    {
                        <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Creating workspace…</span>
                    }
                    else
                    {
                        <span>Create workspace</span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="2" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                    }
                </button>

                <p class="text-center text-white/30 text-xs pt-2">
                    By registering you agree to our Terms of Service
                </p>
            </div>
        </div>
    </main>
</div>

@code {
    private string cafeName = string.Empty;
    private string fullName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private bool isLoading = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/queue", replace: true);
            }
        }
        catch { }
    }

    private async Task HandleRegister()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(cafeName)) { errorMessage = "Café name is required."; return; }
        if (string.IsNullOrWhiteSpace(fullName)) { errorMessage = "Your full name is required."; return; }
        if (string.IsNullOrWhiteSpace(email)) { errorMessage = "Email address is required."; return; }

        var trimmedEmail = email.Trim();
        var emailPattern = @"^[^@\s]+@[^@\s]+\.[a-zA-Z]{2,}$";
        if (!System.Text.RegularExpressions.Regex.IsMatch(trimmedEmail, emailPattern) || !System.Net.Mail.MailAddress.TryCreate(trimmedEmail, out var parsedAddress) || parsedAddress.Address != trimmedEmail)
        {
            errorMessage = "Please enter a valid email address (e.g. name@example.com).";
            return;
        }

        if (string.IsNullOrWhiteSpace(password) || password.Length < 6) { errorMessage = "Password must be at least 6 characters."; return; }

        isLoading = true;

        try
        {
            var request = new TenantOnboardingRequestDto
            {
                BusinessName    = cafeName.Trim(),
                AdminFullName   = fullName.Trim(),
                AdminEmail      = trimmedEmail,
                AdminPassword   = password,
                Country         = "United States",
                City            = string.Empty,
            };

            var response = await AuthService.OnboardTenantAsync(request);

            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                await AuthStateProvider.MarkUserAsAuthenticated(response.Token);
                Navigation.NavigateTo("/setup", replace: true);
            }
            else
            {
                errorMessage = "Registration failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Registration error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
