@page "/setup"
@page "/signup"
@page "/onboard"
@attribute [Authorize]
@layout EmptyLayout

@using RollUp.Application.DTOs
@using RollUp.Core.Entities
@using RollUp.Core.Enums
@using RollUp.Core.Interfaces
@using RollUp.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject IBrandingService BrandingService
@inject IMenuService MenuService
@inject AppDbContext DbContext
@inject ITenantContext TenantContext
@inject NavigationManager Navigation

<PageTitle>Café Setup Wizard — RollUp</PageTitle>

@if (isComplete)
{
    <!-- Completion Celebration Screen -->
    <div class="min-h-screen bg-black text-ink flex flex-col items-center justify-center p-6 text-center relative overflow-hidden">
        <div class="pointer-events-none absolute inset-0 overflow-hidden">
            <div class="absolute -top-32 -left-32 w-[500px] h-[500px] rounded-full bg-accent opacity-20 blur-3xl"></div>
            <div class="absolute -bottom-32 -right-32 w-[500px] h-[500px] rounded-full bg-accent opacity-15 blur-3xl"></div>
        </div>

        <div class="relative z-10 max-w-md mx-auto space-y-6">
            <div class="w-20 h-20 mx-auto rounded-3xl bg-accent flex items-center justify-center text-accent-ink shadow-elevated animate-bounce">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </div>

            <div>
                <h1 class="text-3xl font-display font-bold text-white mb-2">You're All Set!</h1>
                <p class="text-white/60 text-sm">
                    <strong>@cafeName</strong> has been configured with your branding, menu, and payment preferences.
                </p>
            </div>

            <div class="p-5 bg-white/5 border border-white/10 rounded-card text-left space-y-2 backdrop-blur-sm text-xs text-white/70">
                <div class="flex justify-between">
                    <span class="text-white/40">Outlet</span>
                    <span class="font-medium text-white">@outletName (@outletType)</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-white/40">Theme & Style</span>
                    <span class="font-medium text-white capitalize">@selectedTheme / @selectedAccentName</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-white/40">Menu Catalog</span>
                    <span class="font-medium text-white">@selectedCategories.Count categories, @menuItems.Count items</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-white/40">Payments</span>
                    <span class="font-medium text-white">@GetPaymentsSummary()</span>
                </div>
            </div>

            <div class="pt-4 flex flex-col gap-3">
                <a href="/queue" class="w-full py-4 px-6 bg-accent text-accent-ink font-bold rounded-pill shadow-elevated hover:opacity-90 transition-all flex items-center justify-center gap-2 text-base">
                    <span>Open Live Order Queue</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </a>
                <a href="/menu" class="w-full py-3 px-6 bg-white/10 hover:bg-white/15 text-white font-medium rounded-pill transition-all text-sm">
                    Manage Menu & Design Studio
                </a>
            </div>
        </div>
    </div>
}
else
{
    <WizardStep TotalSteps="7"
                CurrentStep="@currentStep"
                Title="@GetStepTitle()"
                Subtitle="@GetStepSubtitle()"
                CanContinue="@CanProceedCurrentStep()"
                IsLoading="@isSaving"
                ContinueLabel="@(currentStep == 7 ? "Launch Café 🚀" : "Continue")"
                OnBack="@HandleBack"
                OnContinue="@HandleContinue"
                OnSkip="@HandleSkip">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-5 p-4 rounded-xl bg-bad/20 border border-bad/40 text-red-200 text-sm flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-bad shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span>@errorMessage</span>
            </div>
        }

        @* STEP 1: BASICS *@
        @if (currentStep == 1)
        {
            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-white/90 mb-2">Café / Business Name</label>
                    <input type="text" @bind="cafeName" placeholder="e.g. Velvet Roast & Bakery"
                           class="w-full px-4 py-3 bg-white/5 border border-white/15 rounded-xl text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-accent" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-white/90 mb-2">Outlet Business Format</label>
                    <div class="grid grid-cols-2 gap-3">
                        @foreach (var type in Enum.GetValues<OutletType>())
                        {
                            var isSelected = outletType == type;
                            <button type="button" @onclick="() => outletType = type"
                                    class="p-4 rounded-card border text-left transition-all @(isSelected ? "bg-accent/15 border-accent text-white ring-2 ring-accent/40" : "bg-white/5 border-white/10 text-white/70 hover:border-white/30 hover:bg-white/10")">
                                <div class="font-display font-bold text-base mb-1 text-white">@type.ToString()</div>
                                <div class="text-xs text-white/50">@GetOutletDescription(type)</div>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        @* STEP 2: BRANDING & LOOK *@
        else if (currentStep == 2)
        {
            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-white/90 mb-2">Theme Template</label>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var theme in themeOptions)
                        {
                            var isSelected = selectedTheme == theme.Key;
                            <button type="button" @onclick="() => selectedTheme = theme.Key"
                                    class="px-4 py-2 rounded-pill text-sm font-medium border transition-all @(isSelected ? "bg-accent text-accent-ink border-accent font-semibold shadow-sm" : "bg-white/5 border-white/15 text-white/70 hover:border-white/30 hover:text-white")">
                                @theme.Value
                            </button>
                        }
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-white/90 mb-2">Accent Color</label>
                    <div class="flex flex-wrap gap-3 items-center">
                        @foreach (var color in accentColors)
                        {
                            var isSelected = selectedAccentColor.Equals(color.Hex, StringComparison.OrdinalIgnoreCase);
                            <button type="button" @onclick="() => SelectAccentColor(color.Hex, color.Name)"
                                    class="w-10 h-10 rounded-full transition-transform flex items-center justify-center shadow-sm @(isSelected ? "scale-110 ring-4 ring-offset-2 ring-offset-ink ring-accent" : "hover:scale-105")"
                                    style="background-color: @color.Hex;"
                                    title="@color.Name">
                                @if (isSelected)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white drop-shadow" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                    </svg>
                                }
                            </button>
                        }
                    </div>
                </div>

                <!-- Live Preview Card -->
                <div class="mt-4 p-5 rounded-card border border-white/10 bg-white/5 shadow-subtle">
                    <div class="text-xs uppercase font-semibold tracking-wider text-white/50 mb-3">Live Customer Menu Preview</div>
                    <div class="rounded-xl p-4 text-white bg-black/40 border border-white/10">
                        <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-3">
                            <span class="font-display font-bold text-lg">@(string.IsNullOrWhiteSpace(cafeName) ? "Your Café" : cafeName)</span>
                            <span class="text-xs px-2.5 py-1 rounded-pill font-semibold" style="background-color: @selectedAccentColor; color: #1a1a1a;">Open Now</span>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-white/80">Flat White</span>
                                <span class="font-semibold font-mono" style="color: @selectedAccentColor;">$4.50</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-white/80">Almond Croissant</span>
                                <span class="font-semibold font-mono" style="color: @selectedAccentColor;">$3.75</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* STEP 3: OUTLET LOCATION *@
        else if (currentStep == 3)
        {
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-white/90 mb-1.5">Outlet / Branch Name</label>
                    <input type="text" @bind="outletName" placeholder="e.g. Main Street HQ"
                           class="w-full px-4 py-3 bg-white/5 border border-white/15 rounded-xl text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-accent" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-white/90 mb-1.5">Street Address</label>
                    <input type="text" @bind="outletAddress" placeholder="123 Coffee Lane, Suite A"
                           class="w-full px-4 py-3 bg-white/5 border border-white/15 rounded-xl text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-accent" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-white/90 mb-1.5">City</label>
                        <input type="text" @bind="outletCity" placeholder="San Francisco"
                               class="w-full px-4 py-3 bg-white/5 border border-white/15 rounded-xl text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-accent" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-white/90 mb-1.5">Phone Number</label>
                        <input type="text" @bind="outletPhone" placeholder="+1 (555) 012-3456"
                               class="w-full px-4 py-3 bg-white/5 border border-white/15 rounded-xl text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-accent" />
                    </div>
                </div>
            </div>
        }

        @* STEP 4: CATEGORIES *@
        else if (currentStep == 4)
        {
            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-white/90 mb-3">Tap to enable categories for your menu:</label>
                    <div class="flex flex-wrap gap-2.5">
                        @foreach (var cat in suggestedCategories)
                        {
                            var isSelected = selectedCategories.Contains(cat);
                            <button type="button" @onclick="() => ToggleCategory(cat)"
                                    class="px-4 py-2 rounded-pill text-sm font-medium border transition-all @(isSelected ? "bg-accent text-accent-ink border-accent font-semibold shadow-sm" : "bg-white/5 border-white/15 text-white/70 hover:border-white/30 hover:text-white")">
                                @(isSelected ? "✓ " : "+ ")@cat
                            </button>
                        }
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-white/90 mb-2">Add a custom category:</label>
                    <div class="flex gap-2">
                        <input type="text" @bind="newCategoryName" placeholder="e.g. Smoothie Bowls"
                               class="flex-1 px-4 py-2.5 bg-white/5 border border-white/15 rounded-xl text-white placeholder-white/30 text-sm focus:outline-none focus:ring-2 focus:ring-accent" />
                        <button type="button" @onclick="AddCustomCategory"
                                class="px-5 py-2.5 bg-white/10 hover:bg-white/15 border border-white/15 text-white font-semibold rounded-xl text-sm transition-colors">
                            Add
                        </button>
                    </div>
                </div>

                @if (selectedCategories.Any())
                {
                    <div class="p-4 bg-white/5 border border-white/10 rounded-xl">
                        <div class="text-xs font-semibold uppercase tracking-wider text-accent mb-3">
                            Selected Categories (@selectedCategories.Count)
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var cat in selectedCategories)
                            {
                                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-pill bg-accent text-accent-ink text-xs font-semibold shadow-sm">
                                    <span>@cat</span>
                                    <button type="button" @onclick="() => ToggleCategory(cat)" class="hover:opacity-75 text-accent-ink text-sm leading-none ml-0.5" title="Remove">&times;</button>
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @* STEP 5: INITIAL MENU ITEMS *@
        else if (currentStep == 5)
        {
            <div class="space-y-4">
                <div class="space-y-2 max-h-56 overflow-y-auto pr-1">
                    @foreach (var item in menuItems)
                    {
                        var curItem = item;
                        <div class="flex items-center justify-between p-3.5 bg-white/5 border border-white/10 rounded-xl gap-3">
                            <div class="flex-1 min-w-0">
                                <div class="font-medium text-white text-sm truncate">@curItem.Name</div>
                                <div class="text-xs text-white/50">@curItem.Category</div>
                            </div>
                            <div class="font-mono text-sm font-bold text-accent">
                                $@curItem.Price.ToString("F2")
                            </div>
                            <button type="button" @onclick="() => menuItems.Remove(curItem)" class="text-white/40 hover:text-bad p-1 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>

                <!-- Add Item Form -->
                <div class="p-4 bg-white/5 border border-white/10 rounded-xl space-y-3">
                    <div class="text-xs font-semibold text-white/60 uppercase">Add Menu Item</div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <input type="text" @bind="newItemName" placeholder="Item name"
                               class="sm:col-span-1 px-3 py-2 bg-white/5 border border-white/15 rounded-lg text-white placeholder-white/30 text-sm focus:outline-none focus:ring-1 focus:ring-accent" />
                        <input type="number" step="0.25" @bind="newItemPrice" placeholder="Price (0.00)"
                               class="px-3 py-2 bg-white/5 border border-white/15 rounded-lg text-white placeholder-white/30 text-sm focus:outline-none focus:ring-1 focus:ring-accent" />
                        <select @bind="newItemCategory" class="px-3 py-2 bg-[#1c1917] border border-white/15 rounded-lg text-white text-sm focus:outline-none focus:ring-1 focus:ring-accent">
                            @foreach (var cat in selectedCategories.DefaultIfEmpty("General"))
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>
                    <button type="button" @onclick="AddNewMenuItem"
                            class="w-full py-2 bg-white/10 hover:bg-white/15 border border-white/15 text-white text-xs font-semibold rounded-lg transition-colors">
                        + Add To Menu
                    </button>
                </div>
            </div>
        }

        @* STEP 6: PAYMENTS *@
        else if (currentStep == 6)
        {
            <div class="space-y-3">
                <div class="p-4 bg-white/5 border border-white/10 rounded-xl flex items-center justify-between">
                    <div>
                        <div class="font-medium text-white text-sm">Cash Payment</div>
                        <div class="text-xs text-white/50">Accept cash payments directly at the counter / pickup point</div>
                    </div>
                    <RollUpToggleSwitch Checked="@acceptCash" CheckedChanged="@(val => acceptCash = val)" />
                </div>

                <div class="p-4 bg-white/5 border border-white/10 rounded-xl flex items-center justify-between">
                    <div>
                        <div class="font-medium text-white text-sm">Credit & Debit Cards</div>
                        <div class="text-xs text-white/50">Accept chip, swipe, and contactless cards on POS</div>
                    </div>
                    <RollUpToggleSwitch Checked="@acceptCard" CheckedChanged="@(val => acceptCard = val)" />
                </div>

                <div class="p-4 bg-white/5 border border-white/10 rounded-xl flex items-center justify-between">
                    <div>
                        <div class="font-medium text-white text-sm">Mobile Wallet / QR Pay</div>
                        <div class="text-xs text-white/50">Apple Pay, Google Pay, and customer QR scan payments</div>
                    </div>
                    <RollUpToggleSwitch Checked="@acceptMobileWallet" CheckedChanged="@(val => acceptMobileWallet = val)" />
                </div>
            </div>
        }

        @* STEP 7: REVIEW & LAUNCH *@
        else if (currentStep == 7)
        {
            <div class="space-y-4">
                <div class="p-5 bg-white/5 border border-white/10 rounded-card space-y-3">
                    <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
                        <div>
                            <span class="text-xs text-white/40">1. Basics</span>
                            <div class="font-display font-bold text-white">@cafeName</div>
                            <div class="text-xs text-white/50">Format: @outletType</div>
                        </div>
                        <button type="button" @onclick="() => currentStep = 1" class="text-xs text-accent hover:underline font-semibold">Edit</button>
                    </div>

                    <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
                        <div>
                            <span class="text-xs text-white/40">2. Branding</span>
                            <div class="font-medium text-white capitalize">@selectedTheme Theme</div>
                            <div class="flex items-center gap-1.5 text-xs text-white/50">
                                <span class="w-3 h-3 rounded-full inline-block" style="background-color: @selectedAccentColor;"></span>
                                @selectedAccentName
                            </div>
                        </div>
                        <button type="button" @onclick="() => currentStep = 2" class="text-xs text-accent hover:underline font-semibold">Edit</button>
                    </div>

                    <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
                        <div>
                            <span class="text-xs text-white/40">3. Outlet</span>
                            <div class="font-medium text-white">@outletName</div>
                            <div class="text-xs text-white/50">@outletAddress, @outletCity</div>
                        </div>
                        <button type="button" @onclick="() => currentStep = 3" class="text-xs text-accent hover:underline font-semibold">Edit</button>
                    </div>

                    <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
                        <div>
                            <span class="text-xs text-white/40">4 & 5. Menu Items</span>
                            <div class="font-medium text-white">@selectedCategories.Count categories, @menuItems.Count items</div>
                        </div>
                        <button type="button" @onclick="() => currentStep = 4" class="text-xs text-accent hover:underline font-semibold">Edit</button>
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <span class="text-xs text-white/40">6. Payments</span>
                            <div class="font-medium text-white">@GetPaymentsSummary()</div>
                        </div>
                        <button type="button" @onclick="() => currentStep = 6" class="text-xs text-accent hover:underline font-semibold">Edit</button>
                    </div>
                </div>

                <div class="p-3.5 bg-accent/15 border border-accent/30 rounded-xl text-xs text-white/80">
                    Ready to begin! Clicking <strong>Launch Café</strong> will apply your branding, sync your menu catalog, and open your live operations board.
                </div>
            </div>
        }
    </WizardStep>
}

@code {
    private int currentStep = 1;
    private bool isSaving = false;
    private bool isComplete = false;
    private string? errorMessage;

    // Step 1: Basics
    private string cafeName = "Artisan Roast";
    private OutletType outletType = OutletType.Cafe;

    // Step 2: Branding
    private string selectedTheme = "bistro";
    private string selectedAccentColor = "#10b981";
    private string selectedAccentName = "Emerald Mint";

    private readonly Dictionary<string, string> themeOptions = new()
    {
        { "bistro", "Bistro Classic" },
        { "modern", "Modern Minimal" },
        { "rustic", "Rustic Warmth" },
        { "minimalist", "Clean Slate" },
        { "elegant", "Artisan Luxury" }
    };

    private record AccentSwatch(string Hex, string Name);
    private readonly List<AccentSwatch> accentColors = new()
    {
        new("#ff5a1f", "Electric Orange"),
        new("#10b981", "Emerald Mint"),
        new("#f43f5e", "Rose Berry"),
        new("#6366f1", "Indigo Blue"),
        new("#8b5cf6", "Artisan Violet"),
        new("#0ea5e9", "Sky Azure")
    };

    // Step 3: Outlet
    private string outletName = "Main Branch";
    private string outletAddress = "101 Market St";
    private string outletCity = "San Francisco";
    private string outletPhone = "+1 (555) 019-2834";

    // Step 4: Categories
    private readonly List<string> suggestedCategories = new() { "Espresso", "Cold Brew", "Pastries", "Breakfast", "Tea & Matcha" };
    private List<string> selectedCategories = new() { "Espresso", "Pastries" };
    private string newCategoryName = string.Empty;

    // Step 5: Menu Items
    private record QuickItem(string Name, decimal Price, string Category);
    private List<QuickItem> menuItems = new()
    {
        new("Espresso Doppio", 3.50m, "Espresso"),
        new("Oat Milk Latte", 4.75m, "Espresso"),
        new("Butter Croissant", 3.75m, "Pastries"),
        new("Avocado Sourdough Toast", 8.50m, "Breakfast")
    };
    private string newItemName = string.Empty;
    private decimal newItemPrice = 4.00m;
    private string newItemCategory = "Espresso";

    // Step 6: Payments
    private bool acceptCash = true;
    private bool acceptCard = true;
    private bool acceptMobileWallet = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var branding = await BrandingService.GetBrandingAsync();
            if (!string.IsNullOrWhiteSpace(branding.BusinessName) && branding.BusinessName != "RollUp Cafe")
            {
                cafeName = branding.BusinessName;
            }
            if (!string.IsNullOrWhiteSpace(branding.ThemeTemplate))
            {
                selectedTheme = branding.ThemeTemplate;
            }
            if (!string.IsNullOrWhiteSpace(branding.CustomAccentColor))
            {
                selectedAccentColor = branding.CustomAccentColor;
            }
        }
        catch
        {
            // Fall back to defaults
        }
    }

    private string GetStepTitle() => currentStep switch
    {
        1 => "Let's set up your café",
        2 => "Choose your visual identity",
        3 => "Primary outlet location",
        4 => "Menu categories",
        5 => "Initial menu items",
        6 => "Accepted payment methods",
        7 => "Review & launch",
        _ => "Setup"
    };

    private string GetStepSubtitle() => currentStep switch
    {
        1 => "Give your business a name and choose the format that best fits your operations.",
        2 => "Select a design theme and accent color for customer ordering & receipts.",
        3 => "Where can customers find your storefront or food truck?",
        4 => "Select the sections you want on your customer-facing menu.",
        5 => "Add a few popular items to kick off your menu catalog.",
        6 => "Choose which payment methods customers can use at checkout.",
        7 => "Everything looks great! Review your details before launching.",
        _ => ""
    };

    private string GetOutletDescription(OutletType type) => type switch
    {
        OutletType.Cafe => "Sit-down or walk-in coffee shop",
        OutletType.FoodTruck => "Mobile trailer or pop-up stand",
        OutletType.Kiosk => "Express pick-up booth or counter",
        OutletType.Restaurant => "Full-service dining and kitchen",
        _ => ""
    };

    private void SelectAccentColor(string hex, string name)
    {
        selectedAccentColor = hex;
        selectedAccentName = name;
    }

    private void ToggleCategory(string cat)
    {
        if (selectedCategories.Contains(cat))
            selectedCategories.Remove(cat);
        else
            selectedCategories.Add(cat);
    }

    private void AddCustomCategory()
    {
        var trimmed = newCategoryName.Trim();
        if (!string.IsNullOrWhiteSpace(trimmed) && !selectedCategories.Contains(trimmed))
        {
            selectedCategories.Add(trimmed);
            newCategoryName = string.Empty;
        }
    }

    private void AddNewMenuItem()
    {
        if (!string.IsNullOrWhiteSpace(newItemName) && newItemPrice > 0)
        {
            menuItems.Add(new QuickItem(newItemName.Trim(), newItemPrice, newItemCategory));
            newItemName = string.Empty;
            newItemPrice = 4.00m;
        }
    }

    private string GetPaymentsSummary()
    {
        var list = new List<string>();
        if (acceptCash) list.Add("Cash");
        if (acceptCard) list.Add("Card");
        if (acceptMobileWallet) list.Add("Mobile Wallet");
        return list.Any() ? string.Join(", ", list) : "None selected";
    }

    private bool CanProceedCurrentStep() => currentStep switch
    {
        1 => !string.IsNullOrWhiteSpace(cafeName),
        3 => !string.IsNullOrWhiteSpace(outletName),
        _ => true
    };

    private void HandleBack()
    {
        if (currentStep > 1) currentStep--;
    }

    private async Task HandleContinue()
    {
        if (currentStep < 7)
        {
            currentStep++;
            return;
        }

        // Final step: Save all settings and complete
        await SaveAndFinishAsync();
    }

    private async Task HandleSkip()
    {
        // Skip escape hatch: save whatever we have and go to /queue
        await SaveAndFinishAsync();
    }

    private async Task SaveAndFinishAsync()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            // 1. Update branding & payment methods on Tenant
            var payments = new List<string>();
            if (acceptCash) payments.Add("Cash");
            if (acceptCard) payments.Add("Card");
            if (acceptMobileWallet) payments.Add("MobileWallet");

            var brandingDto = new TenantBrandingDto
            {
                BusinessName = cafeName.Trim(),
                ThemeTemplate = selectedTheme,
                CustomAccentColor = selectedAccentColor,
                HeadingFont = "bricolage",
                MenuLayout = "card",
                CoverStyle = "full",
                AcceptedPaymentMethods = string.Join(",", payments),
                Address = outletAddress.Trim(),
                ContactPhone = outletPhone.Trim()
            };
            await BrandingService.UpdateBrandingAsync(brandingDto);

            // 2. Ensure Categories & Menu Items exist
            foreach (var cat in selectedCategories)
            {
                try { await MenuService.AddCategoryAsync(cat); } catch { }
            }

            foreach (var item in menuItems)
            {
                try
                {
                    await MenuService.AddItemAsync(new RollUp.Core.Models.MenuItem
                    {
                        Name = item.Name,
                        Price = item.Price,
                        Category = item.Category,
                        IsAvailable = true
                    });
                }
                catch { }
            }

            isComplete = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving setup: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
