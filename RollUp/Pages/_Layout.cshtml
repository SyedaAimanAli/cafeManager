@using Microsoft.AspNetCore.Components.Web
@namespace RollUp.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en" class="dark bg-bg text-ink" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,700;1,9..144,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/app.css" asp-append-version="true" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { background: white !important; }
            .print-only { display: block !important; }
            .page-break { page-break-after: always; break-after: page; }
        }

        #blazor-error-ui {
            background: #18181b;
            color: #fafaf9;
            border-top: 1px solid #ef4444;
            bottom: 0;
            box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.4);
            display: none;
            left: 0;
            padding: 0.8rem 1.2rem;
            position: fixed;
            width: 100%;
            z-index: 1000;
            text-align: center;
            font-size: 0.875rem;
        }
        
        #blazor-error-ui .dismiss {
            cursor: pointer;
            position: absolute;
            right: 1rem;
            top: 0.75rem;
            color: #a1a1aa;
        }
        
        #blazor-error-ui .reload {
            margin-left: 0.5rem;
            color: #C4956A;
            text-decoration: underline;
            font-weight: 600;
        }
    </style>
</head>
<body class="font-body antialiased bg-bg text-ink min-h-screen">
    @RenderBody()

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">Dismiss</a>
    </div>

    <script src="js/audio.js"></script>
    <script src="js/rollup-tools.js"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
