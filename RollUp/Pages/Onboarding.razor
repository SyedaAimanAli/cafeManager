@page "/signup"
@page "/onboard"
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Get Started with RollUp - Onboarding</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-stone-900 via-cafe-espresso to-stone-950 text-stone-100 flex flex-col justify-between py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-4xl mx-auto w-full flex items-center justify-between pb-6 border-b border-stone-800/80">
        <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-xl bg-cafe-caramel flex items-center justify-center text-stone-900 shadow-md group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" d="M2.625 6.75a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0A.75.75 0 018.25 6h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75zM2.625 12a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zM7.5 12a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12A.75.75 0 017.5 12zm-4.875 5.25a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75z" clip-rule="evenodd" />
                </svg>
            </div>
            <div>
                <span class="text-xl font-bold font-display tracking-tight text-white">RollUp</span>
                <span class="text-xs block text-stone-400">Multi-Tenant Platform</span>
            </div>
        </a>

        <div class="text-sm text-stone-400">
            Already have an account? 
            <a href="/login" class="text-cafe-caramel hover:text-amber-400 font-medium ml-1 transition-colors">Log In</a>
        </div>
    </div>

    <!-- Main Container -->
    <div class="max-w-2xl mx-auto w-full my-auto py-8">
        <!-- Progress Steps -->
        <div class="mb-8">
            <div class="flex items-center justify-between relative">
                <div class="absolute left-0 top-1/2 -translate-y-1/2 h-0.5 bg-stone-800 w-full z-0"></div>
                <div class="absolute left-0 top-1/2 -translate-y-1/2 h-0.5 bg-cafe-caramel transition-all duration-500 z-0" style="width: @(GetProgressWidth())"></div>

                <!-- Step 1 Indicator -->
                <button type="button" @onclick="() => SetStep(1)" class="relative z-10 flex flex-col items-center group">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all @(currentStep >= 1 ? "bg-cafe-caramel text-stone-950 ring-4 ring-amber-500/20" : "bg-stone-800 text-stone-400")">
                        1
                    </div>
                    <span class="text-xs font-medium mt-2 @(currentStep >= 1 ? "text-amber-400" : "text-stone-500")">Business</span>
                </button>

                <!-- Step 2 Indicator -->
                <button type="button" @onclick="() => SetStep(2)" class="relative z-10 flex flex-col items-center group" disabled="@(currentStep < 2 && !IsStep1Valid)">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all @(currentStep >= 2 ? "bg-cafe-caramel text-stone-950 ring-4 ring-amber-500/20" : "bg-stone-800 text-stone-400")">
                        2
                    </div>
                    <span class="text-xs font-medium mt-2 @(currentStep >= 2 ? "text-amber-400" : "text-stone-500")">Branding & Location</span>
                </button>

                <!-- Step 3 Indicator -->
                <button type="button" @onclick="() => SetStep(3)" class="relative z-10 flex flex-col items-center group" disabled="@(currentStep < 3 && (!IsStep1Valid || !IsStep2Valid))">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all @(currentStep >= 3 ? "bg-cafe-caramel text-stone-950 ring-4 ring-amber-500/20" : "bg-stone-800 text-stone-400")">
                        3
                    </div>
                    <span class="text-xs font-medium mt-2 @(currentStep >= 3 ? "text-amber-400" : "text-stone-500")">Account</span>
                </button>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-stone-900/90 backdrop-blur-xl border border-stone-800 rounded-3xl p-6 sm:p-10 shadow-2xl shadow-black/50">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-6 p-4 rounded-xl bg-red-950/80 border border-red-800/80 text-red-200 text-sm flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <!-- STEP 1: BUSINESS PROFILE -->
                @if (currentStep == 1)
                {
                    <div class="space-y-6">
                        <div>
                            <h2 class="text-2xl font-bold text-white font-display">Let's start with your Cafe</h2>
                            <p class="text-stone-400 text-sm mt-1">Set up your brand name and customer-facing workspace.</p>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Business / Cafe Name *</label>
                            <input type="text" @bind="model.BusinessName" @bind:event="oninput" @bind:after="OnBusinessNameChanged"
                                   placeholder="e.g. Velvet Roast & Bakery"
                                   class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3.5 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel focus:border-transparent transition-all text-base" />
                            <ValidationMessage For="@(() => model.BusinessName)" class="text-xs text-red-400 mt-1" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Workspace URL Slug</label>
                            <div class="flex rounded-xl bg-stone-800/90 border border-stone-700 overflow-hidden focus-within:ring-2 focus-within:ring-cafe-caramel">
                                <span class="inline-flex items-center px-4 text-stone-500 text-xs sm:text-sm border-r border-stone-700 select-none">
                                    rollup.app/
                                </span>
                                <input type="text" @bind="model.Slug"
                                       placeholder="velvet-roast"
                                       class="w-full bg-transparent px-4 py-3.5 text-amber-300 placeholder-stone-500 focus:outline-none text-sm font-mono" />
                            </div>
                            <span class="text-xs text-stone-500 mt-1 block">This creates your unique customer QR code menu link.</span>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Tagline / Slogan (Optional)</label>
                            <input type="text" @bind="model.Tagline"
                                   placeholder="e.g. Specialty single-origin coffees & artisan treats"
                                   class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-sm" />
                        </div>

                        <div class="pt-4">
                            <button type="button" @onclick="NextStep"
                                    disabled="@(!IsStep1Valid)"
                                    class="w-full py-4 px-6 bg-gradient-to-r from-cafe-caramel to-amber-500 hover:from-amber-500 hover:to-amber-600 disabled:opacity-50 disabled:cursor-not-allowed text-stone-950 font-bold rounded-xl shadow-lg shadow-amber-900/20 transition-all flex items-center justify-center gap-2">
                                <span>Continue to Location & Branding</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                    </div>
                }

                <!-- STEP 2: BRANDING & LOCATION -->
                @if (currentStep == 2)
                {
                    <div class="space-y-6">
                        <div>
                            <h2 class="text-2xl font-bold text-white font-display">Location & Branding</h2>
                            <p class="text-stone-400 text-sm mt-1">Customize your brand identity and regional settings.</p>
                        </div>

                        <!-- Logo Upload -->
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Cafe Logo (Optional)</label>
                            <div class="flex items-center gap-6 p-4 rounded-2xl bg-stone-800/60 border border-stone-700/80">
                                <div class="w-20 h-20 rounded-2xl bg-stone-900 border-2 border-dashed border-stone-700 flex items-center justify-center overflow-hidden shrink-0 shadow-inner">
                                    @if (!string.IsNullOrEmpty(model.LogoUrl))
                                    {
                                        <img src="@model.LogoUrl" alt="Logo preview" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                    }
                                </div>
                                <div class="space-y-2 flex-1">
                                    <InputFile OnChange="HandleLogoUpload" accept="image/*" class="block w-full text-xs text-stone-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-stone-700 file:text-amber-300 hover:file:bg-stone-600 file:cursor-pointer" />
                                    <p class="text-xs text-stone-500">PNG, JPG, or SVG up to 2MB. Logo appears on menus and receipts.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Country & City -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Country *</label>
                                <select @bind="model.Country" class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-sm">
                                    <option value="United States">United States</option>
                                    <option value="United Kingdom">United Kingdom</option>
                                    <option value="Canada">Canada</option>
                                    <option value="Australia">Australia</option>
                                    <option value="United Arab Emirates">United Arab Emirates</option>
                                    <option value="Saudi Arabia">Saudi Arabia</option>
                                    <option value="Germany">Germany</option>
                                    <option value="France">France</option>
                                    <option value="Singapore">Singapore</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">City *</label>
                                <input type="text" @bind="model.City"
                                       placeholder="e.g. San Francisco"
                                       class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-sm" />
                                <ValidationMessage For="@(() => model.City)" class="text-xs text-red-400 mt-1" />
                            </div>
                        </div>

                        <!-- Currency & Phone -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Currency</label>
                                <select @bind="model.Currency" class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-sm">
                                    <option value="USD">USD ($)</option>
                                    <option value="EUR">EUR (€)</option>
                                    <option value="GBP">GBP (£)</option>
                                    <option value="AED">AED (د.إ)</option>
                                    <option value="SAR">SAR (﷼)</option>
                                    <option value="CAD">CAD ($)</option>
                                    <option value="AUD">AUD ($)</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Contact Phone</label>
                                <input type="text" @bind="model.ContactPhone"
                                       placeholder="+1 (555) 000-0000"
                                       class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-sm" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Street Address (Optional)</label>
                            <input type="text" @bind="model.Address"
                                   placeholder="e.g. 101 Market Street, Suite 400"
                                   class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-sm" />
                        </div>

                        <div class="flex gap-4 pt-4">
                            <button type="button" @onclick="PrevStep"
                                    class="py-3.5 px-6 bg-stone-800 hover:bg-stone-700 text-stone-300 font-semibold rounded-xl transition-all">
                                Back
                            </button>
                            <button type="button" @onclick="NextStep"
                                    disabled="@(!IsStep2Valid)"
                                    class="flex-1 py-3.5 px-6 bg-gradient-to-r from-cafe-caramel to-amber-500 hover:from-amber-500 hover:to-amber-600 disabled:opacity-50 disabled:cursor-not-allowed text-stone-950 font-bold rounded-xl shadow-lg shadow-amber-900/20 transition-all flex items-center justify-center gap-2">
                                <span>Continue to Account</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                    </div>
                }

                <!-- STEP 3: ADMIN ACCOUNT -->
                @if (currentStep == 3)
                {
                    <div class="space-y-6">
                        <div>
                            <h2 class="text-2xl font-bold text-white font-display">Create Owner Account</h2>
                            <p class="text-stone-400 text-sm mt-1">You will use this account to manage menus, staff, and view analytics.</p>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Your Full Name *</label>
                            <input type="text" @bind="model.AdminFullName"
                                   placeholder="e.g. Alex Morgan"
                                   class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3.5 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-base" />
                            <ValidationMessage For="@(() => model.AdminFullName)" class="text-xs text-red-400 mt-1" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Work Email Address *</label>
                            <input type="email" @bind="model.AdminEmail"
                                   placeholder="alex@yourcafe.com"
                                   class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3.5 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-base" />
                            <ValidationMessage For="@(() => model.AdminEmail)" class="text-xs text-red-400 mt-1" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Password *</label>
                            <input type="password" @bind="model.AdminPassword"
                                   placeholder="••••••••"
                                   class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3.5 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-base" />
                            <ValidationMessage For="@(() => model.AdminPassword)" class="text-xs text-red-400 mt-1" />
                            <span class="text-xs text-stone-500 mt-1 block">Minimum 6 characters with letters and numbers.</span>
                        </div>

                        <!-- Summary Review Box -->
                        <div class="p-4 rounded-2xl bg-stone-800/40 border border-stone-800 text-xs space-y-1.5 text-stone-400">
                            <div class="flex justify-between">
                                <span class="font-medium text-stone-300">Cafe Name:</span>
                                <span class="text-amber-300 font-semibold">@model.BusinessName</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="font-medium text-stone-300">Location:</span>
                                <span>@model.City, @model.Country</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="font-medium text-stone-300">Workspace Link:</span>
                                <span class="font-mono text-stone-300">rollup.app/@model.Slug</span>
                            </div>
                        </div>

                        <div class="flex gap-4 pt-4">
                            <button type="button" @onclick="PrevStep"
                                    class="py-3.5 px-6 bg-stone-800 hover:bg-stone-700 text-stone-300 font-semibold rounded-xl transition-all">
                                Back
                            </button>
                            <button type="submit"
                                    disabled="@isSubmitting"
                                    class="flex-1 py-4 px-6 bg-gradient-to-r from-cafe-caramel via-amber-500 to-amber-600 hover:from-amber-500 hover:to-amber-700 disabled:opacity-50 text-stone-950 font-bold rounded-xl shadow-lg shadow-amber-900/30 transition-all flex items-center justify-center gap-2">
                                @if (isSubmitting)
                                {
                                    <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-stone-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    <span>Provisioning Workspace...</span>
                                }
                                else
                                {
                                    <span>Complete Setup & Launch Cafe</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                                    </svg>
                                }
                            </button>
                        </div>
                    </div>
                }
            </EditForm>
        </div>
    </div>

    <!-- Footer -->
    <div class="max-w-4xl mx-auto w-full text-center pt-6 text-stone-500 text-xs">
        <p>&copy; @DateTime.UtcNow.Year RollUp Multi-Tenant Cafe Platform. All rights reserved.</p>
    </div>
</div>

@code {
    private TenantOnboardingRequestDto model = new()
    {
        Country = "United States",
        Currency = "USD"
    };

    private int currentStep = 1;
    private bool isSubmitting = false;
    private string? errorMessage;

    private bool IsStep1Valid => !string.IsNullOrWhiteSpace(model.BusinessName) && model.BusinessName.Trim().Length >= 2;
    private bool IsStep2Valid => !string.IsNullOrWhiteSpace(model.City) && !string.IsNullOrWhiteSpace(model.Country);

    private string GetProgressWidth() => currentStep switch
    {
        1 => "0%",
        2 => "50%",
        3 => "100%",
        _ => "0%"
    };

    private void SetStep(int step)
    {
        if (step == 2 && !IsStep1Valid) return;
        if (step == 3 && (!IsStep1Valid || !IsStep2Valid)) return;
        currentStep = step;
    }

    private void NextStep()
    {
        if (currentStep == 1 && IsStep1Valid) currentStep = 2;
        else if (currentStep == 2 && IsStep2Valid) currentStep = 3;
    }

    private void PrevStep()
    {
        if (currentStep > 1) currentStep--;
    }

    private void OnBusinessNameChanged()
    {
        if (string.IsNullOrWhiteSpace(model.Slug) || model.Slug == Slugify(model.BusinessName.Substring(0, Math.Max(0, model.BusinessName.Length - 1))))
        {
            model.Slug = Slugify(model.BusinessName);
        }
    }

    private static string Slugify(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        var clean = System.Text.RegularExpressions.Regex.Replace(name.ToLowerInvariant(), @"[^a-z0-9\s-]", "");
        clean = System.Text.RegularExpressions.Regex.Replace(clean, @"\s+", "-").Trim('-');
        return clean;
    }

    private async Task HandleLogoUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            // Limit to 2MB
            if (file.Size > 2 * 1024 * 1024)
            {
                errorMessage = "Logo image must be smaller than 2MB.";
                return;
            }

            var buffer = new byte[file.Size];
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            await stream.ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            model.LogoUrl = $"data:{file.ContentType};base64,{base64}";
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error reading image: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.OnboardTenantAsync(model);
            if (result != null && !string.IsNullOrEmpty(result.Token))
            {
                await AuthStateProvider.MarkUserAsAuthenticated(result.Token);
                Navigation.NavigateTo("/manage", forceLoad: true);
            }
            else
            {
                errorMessage = "Failed to complete onboarding. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
