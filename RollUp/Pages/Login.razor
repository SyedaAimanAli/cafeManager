@page "/login"
@layout EmptyLayout
@using RollUp.Application.DTOs
@using RollUp.Core.Entities
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Sign In — RollUp</PageTitle>

<div class="min-h-screen bg-black text-ink flex flex-col justify-between p-6 relative overflow-hidden">
    <!-- Decorative Ambient Glow (Warm Orange) -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -top-40 -left-40 w-[500px] h-[500px] rounded-full bg-accent opacity-20 blur-3xl"></div>
        <div class="absolute -bottom-40 -right-40 w-[500px] h-[500px] rounded-full bg-accent opacity-15 blur-3xl"></div>
    </div>

    <!-- Top Navigation / Logo -->
    <div class="relative z-10 max-w-md mx-auto w-full flex items-center justify-between pt-2">
        <a href="/welcome" class="flex items-center gap-2.5 group">
            <span class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-accent-ink">
                    <path fill-rule="evenodd" d="M3.5 2A1.5 1.5 0 002 3.5v13A1.5 1.5 0 003.5 18h13a1.5 1.5 0 001.5-1.5V3.5A1.5 1.5 0 0016.5 2h-13zm3.75 8.25a.75.75 0 000 1.5h5.5a.75.75 0 000-1.5h-5.5zm0-3a.75.75 0 000 1.5h5.5a.75.75 0 000-1.5h-5.5z" clip-rule="evenodd" />
                </svg>
            </span>
            <span class="font-display font-bold text-white text-lg">RollUp</span>
        </a>

        <a href="/register" class="text-xs font-medium text-accent hover:opacity-80 transition-opacity">
            Register Café &rarr;
        </a>
    </div>

    <!-- Login Card -->
    <div class="relative z-10 max-w-md mx-auto w-full my-auto py-8">
        <div class="bg-surface border border-line rounded-card p-8 sm:p-10 shadow-elevated">
            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold font-display text-ink mb-1.5">Welcome back</h1>
                <p class="text-xs text-ink-muted">Sign in to your café operations workspace</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-6 p-4 rounded-xl bg-bad/20 border border-bad/40 text-bad-text text-xs flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-bad shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5">Email</label>
                        <input id="login-email" type="email" @bind="model.Email"
                               placeholder="admin@rollup.com"
                               class="w-full bg-bg border border-line rounded-xl px-4 py-3 text-ink placeholder-ink-faint focus:outline-none focus:ring-2 focus:ring-accent text-sm transition-all" />
                        <ValidationMessage For="@(() => model.Email)" class="text-xs text-bad-text mt-1" />
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-ink-muted">Password</label>
                        </div>
                        <input id="login-password" type="password" @bind="model.Password"
                               placeholder="••••••••"
                               class="w-full bg-bg border border-line rounded-xl px-4 py-3 text-ink placeholder-ink-faint focus:outline-none focus:ring-2 focus:ring-accent text-sm transition-all" />
                        <ValidationMessage For="@(() => model.Password)" class="text-xs text-bad-text mt-1" />
                    </div>

                    <button id="btn-login-submit" type="submit"
                            disabled="@isLoading"
                            class="w-full py-3.5 px-6 bg-accent text-accent-ink font-bold rounded-pill shadow-elevated hover:opacity-90 disabled:opacity-50 active:scale-[0.98] transition-all flex items-center justify-center gap-2 mt-2 cursor-pointer">
                        @if (isLoading)
                        {
                            <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Signing in…</span>
                        }
                        else
                        {
                            <span>Sign in</span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                            </svg>
                        }
                    </button>
                </div>
            </EditForm>

            <!-- Quick Demo Credentials -->
            <div class="mt-8 pt-6 border-t border-line">
                <p class="text-xs text-ink-muted mb-3 font-medium text-center">Quick Demo Credentials</p>
                <div class="flex gap-2">
                    <button type="button" @onclick="FillDefaultAdmin" class="w-full py-2 px-3 bg-bg hover:bg-line/40 border border-line rounded-xl text-xs text-ink-muted hover:text-ink font-mono transition-colors text-center cursor-pointer">
                        Admin: admin@rollup.com
                    </button>
                </div>
            </div>

            <!-- Sign Up CTA -->
            <div class="mt-6 text-center text-xs text-ink-muted">
                New to RollUp?
                <a href="/register" class="text-accent hover:underline font-semibold ml-1">Create workspace</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="relative z-10 max-w-md mx-auto w-full text-center pb-2 text-white/30 text-xs">
        <p>&copy; @DateTime.UtcNow.Year RollUp Multi-Tenant Platform</p>
    </div>
</div>

@code {
    private LoginRequestDto model = new();
    private bool isLoading = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/queue", replace: true);
            }
        }
        catch { }
    }

    private void FillDefaultAdmin()
    {
        model.Email = "admin@rollup.com";
        model.Password = "Admin123!";
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await AuthService.LoginAsync(model);
            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                await AuthStateProvider.MarkUserAsAuthenticated(response.Token);
                Navigation.NavigateTo("/queue", replace: true);
            }
            else
            {
                errorMessage = "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
