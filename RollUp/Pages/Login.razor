@page "/login"
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login - RollUp Cafe Management</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-stone-900 via-cafe-espresso to-stone-950 text-stone-100 flex flex-col justify-between py-10 px-4 sm:px-6 lg:px-8">
    <!-- Brand Header -->
    <div class="max-w-md mx-auto w-full text-center">
        <a href="/" class="inline-flex items-center gap-3 group mb-2">
            <div class="w-12 h-12 rounded-2xl bg-cafe-caramel flex items-center justify-center text-stone-900 shadow-lg group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" d="M2.625 6.75a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0A.75.75 0 018.25 6h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75zM2.625 12a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zM7.5 12a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12A.75.75 0 017.5 12zm-4.875 5.25a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75z" clip-rule="evenodd" />
                </svg>
            </div>
            <span class="text-2xl font-bold font-display tracking-tight text-white">RollUp</span>
        </a>
        <h1 class="text-xl font-semibold text-stone-300">Sign in to your Cafe Workspace</h1>
    </div>

    <!-- Login Card -->
    <div class="max-w-md mx-auto w-full my-auto">
        <div class="bg-stone-900/90 backdrop-blur-xl border border-stone-800 rounded-3xl p-8 sm:p-10 shadow-2xl shadow-black/50">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-6 p-4 rounded-xl bg-red-950/80 border border-red-800 text-red-200 text-sm flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="space-y-5">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">Email Address</label>
                        <input type="email" @bind="model.Email"
                               placeholder="admin@rollup.com"
                               class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-sm" />
                        <ValidationMessage For="@(() => model.Email)" class="text-xs text-red-400 mt-1" />
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-stone-300">Password</label>
                        </div>
                        <input type="password" @bind="model.Password"
                               placeholder="••••••••"
                               class="w-full bg-stone-800/90 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-cafe-caramel text-sm" />
                        <ValidationMessage For="@(() => model.Password)" class="text-xs text-red-400 mt-1" />
                    </div>

                    <button type="submit"
                            disabled="@isLoading"
                            class="w-full py-3.5 px-6 bg-gradient-to-r from-cafe-caramel to-amber-500 hover:from-amber-500 hover:to-amber-600 disabled:opacity-50 text-stone-950 font-bold rounded-xl shadow-lg shadow-amber-900/20 transition-all flex items-center justify-center gap-2">
                        @if (isLoading)
                        {
                            <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-stone-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Signing In...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                        }
                    </button>
                </div>
            </EditForm>

            <!-- Quick Demo Login Helpers -->
            <div class="mt-8 pt-6 border-t border-stone-800">
                <p class="text-xs text-stone-400 mb-3 font-medium text-center">Quick Demo Credentials</p>
                <div class="flex gap-2">
                    <button type="button" @onclick="FillDefaultAdmin" class="flex-1 py-2 px-3 bg-stone-800/80 hover:bg-stone-700 rounded-lg text-xs text-stone-300 font-mono transition-colors">
                        Admin: admin@rollup.com
                    </button>
                </div>
            </div>

            <!-- Sign Up CTA -->
            <div class="mt-6 text-center text-xs text-stone-400">
                New Cafe Business?
                <a href="/signup" class="text-amber-400 hover:text-amber-300 font-semibold ml-1 underline transition-colors">Register Your Cafe</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="max-w-md mx-auto w-full text-center pt-6 text-stone-500 text-xs">
        <p>&copy; @DateTime.UtcNow.Year RollUp Multi-Tenant Cafe Platform</p>
    </div>
</div>

@code {
    private LoginRequestDto model = new();
    private bool isLoading = false;
    private string? errorMessage;

    private void FillDefaultAdmin()
    {
        model.Email = "admin@rollup.com";
        model.Password = "Admin123!";
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await AuthService.LoginAsync(model);
            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                await AuthStateProvider.MarkUserAsAuthenticated(response.Token);

                // Redirect based on role
                if (response.User.Role == Role.Admin.ToString() || response.User.Role == Role.Manager.ToString())
                {
                    Navigation.NavigateTo("/", forceLoad: true);
                }
                else if (response.User.Role == Role.Kitchen.ToString())
                {
                    Navigation.NavigateTo("/kitchen", forceLoad: true);
                }
                else
                {
                    Navigation.NavigateTo("/menu", forceLoad: true);
                }
            }
            else
            {
                errorMessage = "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
